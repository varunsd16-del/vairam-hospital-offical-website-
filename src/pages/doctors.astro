    .form-group label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #020617;
    }

    .form-group input,
    .form-group select {
      padding: 12px 16px;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      font-family: inherit;
