      line-height: 1.4;
      color: #64748b;
    }

    .profile-modal-footer {
      padding: 20px 35px;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: flex-end;
      gap: 15px;
      flex-shrink: 0;
    }

    .btn-outline-secondary {
      background: transparent;
