    }

    .schedule-booking-notes {
      margin-top: 20px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 12px;
      border-left: 3px solid #cbd5e1;
    }

    .schedule-booking-notes p {
      margin: 0;
