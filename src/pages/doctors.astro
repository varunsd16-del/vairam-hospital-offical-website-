    }
    .docs-grid :global(.doc__photo) {
      grid-row: span 2;
      aspect-ratio: auto;
      min-height: 100%;
    }
    .docs-grid :global(.doc__dept),
    .docs-grid :global(.doc__exp) {
      display: none;
