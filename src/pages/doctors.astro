    /* Responsive Adjustments */
    @media (max-width: 1024px) {
      .hero-grid-wrapper {
        grid-template-columns: 1fr;
        gap: 50px;
      }
      .hero-right-visual {
        order: -1;
      }
      .filter-flex-container {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
      }
      .search-input-box {
        max-width: 100%;
      }
