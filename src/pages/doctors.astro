    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--blue-600);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .step h3 {
    font-size: 1.125rem;
    margin-top: var(--s-2);
  }
  .step p {
