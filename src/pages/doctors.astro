    @media (max-width: 768px) {
      .stats-cards-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .dept-tabs {
        justify-content: center;
        gap: 8px;
      }
      .dept-tab-btn {
        padding: 8px 16px;
        font-size: 0.8rem;
      }
      .doctors-hero {
        padding: 100px 5% 70px;
      }
      .doctors-grid-section,
      .why-doctors-section {
        padding: 70px 5%;
      }
      .profile-modal-header-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 20px;
      }
      .profile-img-container {
        width: 180px;
        height: 180px;
        margin: 0 auto;
      }
      .modal-stars-rating {
        justify-content: center;
      }
      .profile-modal-details-grid {
        grid-template-columns: 1fr;
