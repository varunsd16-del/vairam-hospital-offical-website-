</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".docs-grid > li"));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".dir__chips .chip"));
  const search = document.getElementById("docSearch") as HTMLInputElement;
  const select = document.getElementById("docDept") as HTMLSelectElement;
  const status = document.getElementById("docStatus")!;
  const empty = document.getElementById("docEmpty")!;
  const directory = document.getElementById("directory")!;
  let dept = "all";

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const li of cards) {
      const card = li.querySelector<HTMLElement>(".doc")!;
      const ok = (dept === "all" || card.dataset.dept === dept) && (!q || card.dataset.search!.includes(q));
      li.hidden = !ok;
      if (ok) {
        li.classList.add("is-visible"); // don't wait for the scroll reveal on filtered results
        shown++;
      }
    }
    empty.hidden = shown > 0;
    status.textContent =
      shown === cards.length ? `Showing all ${shown} doctors` : `Showing ${shown} ${shown === 1 ? "doctor" : "doctors"}${dept !== "all" ? ` in ${dept}` : ""}`;
  }

  function setDept(value: string) {
    dept = value;
    select.value = value;
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.filter === value)));
    apply();
  }

  chips.forEach((chip) => chip.addEventListener("click", () => setDept(chip.dataset.filter!)));
  select.addEventListener("change", () => setDept(select.value));
  search.addEventListener("input", apply);
  document.getElementById("finder")?.addEventListener("submit", (e) => {
    e.preventDefault();
    apply();
    directory.scrollIntoView({ behavior: "smooth" });
  });
  document.querySelectorAll<HTMLElement>("[data-jump]").forEach((b) =>
    b.addEventListener("click", () => {
      search.value = "";
      setDept(b.dataset.jump!);
      directory.scrollIntoView({ behavior: "smooth" });
    }),
  );
  document.getElementById("docReset")?.addEventListener("click", () => {
    search.value = "";
    setDept("all");
  });

  // Profiles
  const openProfile = (id: string) => (document.getElementById(`profile-${id}`) as HTMLDialogElement | null)?.showModal();
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-profile]");
    if (btn) openProfile(btn.dataset.profile!);
  });
  // Deep link from the home page: /doctors#dr-sarah
  if (location.hash.length > 1) openProfile(decodeURIComponent(location.hash.slice(1)));
</script>
