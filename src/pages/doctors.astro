const departments = [
  { filter: "all", label: "All Doctors" },
  { filter: "Cardiology", label: "Cardiology" },
  { filter: "Neurology", label: "Neurology" },
  { filter: "Orthopedics", label: "Orthopedics" },
  { filter: "Pediatrics", label: "Pediatrics" },
  { filter: "Ophthalmology", label: "Ophthalmology" }
