  </style>

  <!-- INTERACTIVE VANILLA JAVASCRIPT -->
  <script is:inline define:vars={{ doctorsData }}>
    document.addEventListener("DOMContentLoaded", () => {

      // Cache DOM Elements
      const searchInput = document.getElementById("doctorsSearchInput");
      const clearSearchBtn = document.getElementById("clearSearchBtn");
      const deptTabButtons = document.querySelectorAll(".dept-tab-btn");
      const doctorCards = document.querySelectorAll(".doctor-card");
      const emptyState = document.getElementById("emptyDoctorsState");
      const filterStatus = document.getElementById("doctorsFilterStatus");
      const searchTextSpan = document.getElementById("searchTextSpan");
      const resetSearchLink = document.getElementById("resetSearchLink");
      const resetDoctorsFilterBtn = document.getElementById("resetDoctorsFilterBtn");
      const cardGrid = document.getElementById("doctorsCardGrid");

      // Profile Modal Cache
      const profileModal = document.getElementById("doctorProfileModal");
      const closeProfileModalBtn = document.getElementById("closeProfileModalBtn");
      const modalGoBackBtn = document.getElementById("modalGoBackBtn");
      const modalTriggerBookBtn = document.getElementById("modalTriggerBookBtn");

      const modalDocName = document.getElementById("modalDocName");
      const modalDocPhoto = document.getElementById("modalDocPhoto");
      const modalDocExp = document.getElementById("modalDocExp");
      const modalDocDept = document.getElementById("modalDocDept");
      const modalDocRole = document.getElementById("modalDocRole");
      const modalDocEdu = document.getElementById("modalDocEdu");
      const modalDocRatingNum = document.getElementById("modalDocRatingNum");
      const modalDocReviews = document.getElementById("modalDocReviews");
      const modalDocLanguages = document.getElementById("modalDocLanguages");
      const modalDocBio = document.getElementById("modalDocBio");
      const modalDocCerts = document.getElementById("modalDocCerts");
      const modalDocSchedDays = document.getElementById("modalDocSchedDays");
      const modalDocSchedHours = document.getElementById("modalDocSchedHours");

      // Booking Modal Cache
      const bookingModal = document.getElementById("doctorBookingModal");
      const closeDoctorBookingBtn = document.getElementById("closeDoctorBookingBtn");
      const bookingForm = document.getElementById("doctorsPageBookingForm");
      const bookDoctorSelect = document.getElementById("bookDoctorSelect");
      const bookDeptInput = document.getElementById("bookDeptInput");

      // Load More Button
      const loadMoreBtn = document.getElementById("loadMoreBtn");

      // State Variables
      let activeSpecialtyFilter = "all";
      let activeQuery = "";
      let activeSelectedDoctorName = "";

      // ────────────────────────────────────────────────────────
      // 1. FILTERING & SEARCH LOGIC
      // ────────────────────────────────────────────────────────

      function runFilters() {
        let visibleCount = 0;
        const query = activeQuery.trim().toLowerCase();

        doctorCards.forEach(card => {
          const cardSpecialty = card.getAttribute("data-specialty");
          const cardName = card.getAttribute("data-name");
          const cardKeywords = card.getAttribute("data-keywords").toLowerCase();

          // Specialty filter match
          const specialtyMatch = (activeSpecialtyFilter === "all" || cardSpecialty === activeSpecialtyFilter);
          
          // Search query match (name or keywords)
          const searchMatch = (
            query === "" ||
            cardName.includes(query) ||
            cardKeywords.includes(query)
          );

          if (specialtyMatch && searchMatch) {
            card.classList.remove("hidden");
            visibleCount++;
          } else {
            card.classList.add("hidden");
          }
        });

        // Toggle Empty State
        if (visibleCount === 0) {
          cardGrid.style.display = "none";
          emptyState.style.display = "block";
        } else {
          cardGrid.style.display = "grid";
          emptyState.style.display = "none";
        }

        // Toggle search info banner
        if (query !== "") {
          filterStatus.style.display = "block";
          searchTextSpan.textContent = activeQuery;
          clearSearchBtn.style.display = "block";
        } else {
          filterStatus.style.display = "none";
          clearSearchBtn.style.display = "none";
        }
      }

      function resetAllFilters() {
        activeSpecialtyFilter = "all";
        activeQuery = "";
        searchInput.value = "";
        
        deptTabButtons.forEach(btn => {
          if (btn.getAttribute("data-filter") === "all") {
            btn.classList.add("active");
            btn.setAttribute("aria-selected", "true");
          } else {
            btn.classList.remove("active");
            btn.setAttribute("aria-selected", "false");
          }
        });

        runFilters();
      }

      // Input trigger
      searchInput.addEventListener("input", (e) => {
        activeQuery = e.target.value;
        runFilters();
      });

      // Clear search
      clearSearchBtn.addEventListener("click", () => {
        searchInput.value = "";
        activeQuery = "";
        runFilters();
      });

      // Tab Buttons trigger
      deptTabButtons.forEach(button => {
        button.addEventListener("click", () => {
          deptTabButtons.forEach(b => {
            b.classList.remove("active");
            b.setAttribute("aria-selected", "false");
          });
          button.classList.add("active");
          button.setAttribute("aria-selected", "true");
          
          activeSpecialtyFilter = button.getAttribute("data-filter");
          runFilters();
        });
      });

      resetSearchLink.addEventListener("click", resetAllFilters);
      resetDoctorsFilterBtn.addEventListener("click", resetAllFilters);

      // ────────────────────────────────────────────────────────
      // 2. DOCTOR DETAIL MODAL BINDINGS
      // ────────────────────────────────────────────────────────

      function openProfileModal(doctorId) {
        const data = doctorsData.find(d => d.id === doctorId);
        if (!data) return;

        activeSelectedDoctorName = data.name;

        // Inject content fields
        modalDocPhoto.src = data.image;
        modalDocPhoto.alt = data.name;
        modalDocExp.textContent = data.experience;
        
        modalDocDept.textContent = data.specialty;
        modalDocName.textContent = data.name;
        modalDocRole.textContent = data.role;
        modalDocEdu.textContent = data.education;
        modalDocRatingNum.textContent = data.rating;
        modalDocReviews.textContent = `(${data.reviews})`;
        modalDocLanguages.textContent = data.languages;
        modalDocBio.textContent = data.bio;

        modalDocSchedDays.textContent = data.schedule.days;
        modalDocSchedHours.textContent = data.schedule.hours;

        // Accreditations list
        modalDocCerts.innerHTML = "";
        data.certifications.forEach(cert => {
          const li = document.createElement("li");
          li.textContent = cert;
          modalDocCerts.appendChild(li);
        });

        profileModal.classList.add("active");
        profileModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeProfileModal() {
        profileModal.classList.remove("active");
        profileModal.setAttribute("aria-hidden", "true");
        if (!bookingModal.classList.contains("active")) {
          document.body.style.overflow = "";
        }
      }

      cardGrid.addEventListener("click", (e) => {
        const btn = e.target.closest(".view-profile-btn");
        if (btn) {
          const id = btn.getAttribute("data-id");
          openProfileModal(id);
        }
      });

      closeProfileModalBtn.addEventListener("click", closeProfileModal);
      modalGoBackBtn.addEventListener("click", closeProfileModal);

      // ────────────────────────────────────────────────────────
      // 3. APPOINTMENT BOOKING MODAL ACTIONS
      // ────────────────────────────────────────────────────────

      function openBookingModal(preselectedDoctor = "") {
        if (preselectedDoctor) {
          bookDoctorSelect.value = preselectedDoctor;
          // Trigger change handler to set department
          bookDoctorSelect.dispatchEvent(new Event("change"));
        } else {
          bookDoctorSelect.value = "";
          bookDeptInput.value = "";
        }

        bookingModal.classList.add("active");
        bookingModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeBookingModal() {
        bookingModal.classList.remove("active");
        bookingModal.setAttribute("aria-hidden", "true");
        if (!profileModal.classList.contains("active")) {
          document.body.style.overflow = "";
        }
      }

      // Handle selector dropdown change
      bookDoctorSelect.addEventListener("change", (e) => {
        const selectedOption = e.target.options[e.target.selectedIndex];
        if (selectedOption && selectedOption.value) {
          const dept = selectedOption.getAttribute("data-dept");
          bookDeptInput.value = dept;
        } else {
          bookDeptInput.value = "";
        }
      });

      // Trigger from Profile Modal
      modalTriggerBookBtn.addEventListener("click", () => {
        closeProfileModal();
        setTimeout(() => {
          openBookingModal(activeSelectedDoctorName);
        }, 150);
      });

      closeDoctorBookingBtn.addEventListener("click", closeBookingModal);

      // Close modal on background clicks
      window.addEventListener("click", (e) => {
        if (e.target === profileModal) closeProfileModal();
        if (e.target === bookingModal) closeBookingModal();
      });

      // ────────────────────────────────────────────────────────
      // 4. BOOKING FORM REDIRECT TO WHATSAPP
      // ────────────────────────────────────────────────────────
      bookingForm.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const name = document.getElementById("bookPatientName").value.trim();
        const phone = document.getElementById("bookPatientPhone").value.trim();
        const doctor = bookDoctorSelect.value;
        const dept = bookDeptInput.value;
        const date = document.getElementById("bookBookingDate").value;
        const timeslot = document.getElementById("bookTimeSlot").value;

        // Generate token
        const token = "VMD-" + Math.floor(1000 + Math.random() * 9000);

        // Construct message
        const message = `Hello Vairam Multi Speciality Hospital, I would like to schedule a specialist doctor consultation:
- Booking Reference: ${token}
- Patient Name: ${name}
- Contact Phone: ${phone}
- Consulting Doctor: ${doctor} (${dept})
- Consultation Date: ${date}
- Preferred Time Slot: ${timeslot}

Please confirm availability. Thank you.`;

        // Redirect
        const encodedMsg = encodeURIComponent(message);
        const whatsappNumber = "919344644555"; 
        const url = `https://wa.me/${whatsappNumber}?text=${encodedMsg}`;
        
        window.open(url, "_blank");
        closeBookingModal();
        bookingForm.reset();
      });

      // ────────────────────────────────────────────────────────
      // 5. LOAD MORE PLACEHOLDER
      // ────────────────────────────────────────────────────────
      loadMoreBtn.addEventListener("click", () => {
        const textSpan = loadMoreBtn.querySelector(".btn-text");
        const spinnerSpan = loadMoreBtn.querySelector(".btn-spinner");

        textSpan.style.display = "none";
        spinnerSpan.style.display = "inline-block";

        setTimeout(() => {
          textSpan.style.display = "inline-block";
          textSpan.textContent = "All Clinical Specialists Loaded";
          spinnerSpan.style.display = "none";
          loadMoreBtn.disabled = true;
          loadMoreBtn.style.opacity = "0.7";
          loadMoreBtn.style.cursor = "default";
        }, 1200);
      });

    });
  </script>

</Layout>
