---

<Layout title="Specialist Doctors | Vairam Multi Speciality Hospital Mayiladuthurai">
  
  <!-- Structured Data JSON-LD for Local Physicians Directory -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Specialist Doctors Directory at Vairam Hospital",
      "description": "Directory of specialist doctors including cardiologists, neurologists, and surgeons in Mayiladuthurai.",
      "numberOfItems": 8,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "Physician",
            "name": "Dr. Sarah Johnson",
            "medicalSpecialty": "Cardiology",
            "telephone": "+919344644555",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Pattamangala St",
              "addressLocality": "Mayiladuthurai",
              "addressRegion": "TN",
              "postalCode": "609001",
              "addressCountry": "IN"
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "Physician",
            "name": "Dr. Michael Chen",
            "medicalSpecialty": "Neurology",
            "telephone": "+919344644555"
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "Physician",
            "name": "Dr. James Wilson",
            "medicalSpecialty": "Orthopedics",
            "telephone": "+919344644555"
          }
        }
      ]
    }
  </script>

  <!-- 1. HERO SECTION -->
  <section class="doctors-hero">
    <div class="hero-blur-glow" aria-hidden="true"></div>
    <div class="container hero-grid-wrapper">
      
      <!-- Left Column: Content & Statistics -->
      <div class="hero-left-content reveal reveal-left">
        <span class="hero-badge">Expert Medical Team</span>
        <h1 class="hero-title">Meet Our Doctor <br /><span class="highlight-text">Specialists & Surgeons</span></h1>
        <p class="hero-subtitle">
          Consult with highly certified clinical practitioners in Mayiladuthurai. Offering board-certified expertise in cardiology, neurology, pediatrics, and modular orthopedics.
        </p>

        <!-- Statistics Cards -->
        <div class="stats-cards-grid">
          <div class="stats-card">
            <div class="stats-num">50+</div>
            <div class="stats-label">Specialist Doctors</div>
          </div>
          <div class="stats-card">
            <div class="stats-num">15+</div>
            <div class="stats-label">Years Avg Experience</div>
          </div>
          <div class="stats-card">
            <div class="stats-num">98%</div>
            <div class="stats-label">Patient Satisfaction</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual and Floating Tag -->
      <div class="hero-right-visual reveal reveal-right">
        <div class="img-wrapper">
          <img src="/images/hero-building.png" alt="Vairam Hospital Specialist Doctors Team Mayiladuthurai" class="hero-team-img" />
          <div class="floating-rating-card">
            <div class="card-icon"><i class="fas fa-award"></i></div>
            <div class="card-info">
              <h4>Top Rated Care</h4>
              <p><i class="fas fa-star text-gold"></i> 4.9 out of 5 stars</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. STICKY FILTER AND SEARCH BAR -->
  <section class="filter-sticky-section" id="stickyFilterBar">
    <div class="container filter-flex-container">
      
      <!-- Department Tabs -->
      <div class="dept-tabs">
        {departments.map((d, i) => (
          <button 
            class={`dept-tab-btn ${i === 0 ? 'active' : ''}`} 
            data-filter={d.filter}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {d.label}
          </button>
        ))}
      </div>

      <!-- Search Box -->
      <div class="search-input-box">
        <i class="fas fa-search"></i>
        <input 
          type="text" 
          id="doctorsSearchInput" 
          placeholder="Search doctor name or credentials..." 
          aria-label="Search doctors by name"
        />
        <button id="clearSearchBtn" class="clear-btn" aria-label="Clear search input">
          <i class="fas fa-times"></i>
        </button>
      </div>

    </div>
  </section>

  <!-- 3. DOCTORS GRID SECTION -->
  <section class="doctors-grid-section">
    <div class="container">
      
      <!-- Live Filter Status Message -->
      <div class="filter-status-banner" id="doctorsFilterStatus" style="display: none;">
        <p><i class="fas fa-info-circle"></i> Showing matches for "<span id="searchTextSpan"></span>". <button id="resetSearchLink">Reset filter</button></p>
      </div>

      <!-- Doctors Card Grid -->
      <div class="doctors-grid" id="doctorsCardGrid">
        {doctorsData.map((d, idx) => (
          <article 
            class="doctor-card reveal reveal-up" 
            data-specialty={d.specialty}
            data-name={d.name.toLowerCase()}
            data-keywords={d.keywords}
            id={`doc-${d.id}`}
            style={`transition-delay: ${(idx % 3) * 0.1}s`}
          >
            <div class="card-image-wrapper">
              <img src={d.image} alt={d.name} class="doc-card-img" />
              
              <!-- Availability Pulse Badge -->
              <div class={`availability-pulse ${d.availability.includes('Today') ? 'pulse-green' : 'pulse-blue'}`}>
                <span class="pulse-dot"></span>
                <span class="pulse-txt">{d.availability}</span>
              </div>

              <!-- Social Media Overlay Link Box -->
              <div class="social-hover-overlay">
                <a href="#" aria-label="Facebook Profile"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Twitter Profile"><i class="fab fa-twitter"></i></a>
                <a href="#" aria-label="LinkedIn Profile"><i class="fab fa-linkedin-in"></i></a>
              </div>
            </div>

            <div class="card-body">
              <span class="specialty-badge">{d.specialty}</span>
              <div class="star-rating">
                <i class="fas fa-star"></i>
                <span class="rating-num">{d.rating}</span>
                <span class="rating-reviews">({d.reviews})</span>
              </div>
              <h3 class="doc-name">{d.name}</h3>
              <p class="doc-role">{d.role}</p>
              <p class="doc-edu">{d.education}</p>
              <p class="doc-bio-excerpt">{d.bio.substring(0, 100)}...</p>

              <div class="doc-meta-divider"></div>
              
              <div class="next-avail-box">
                <i class="far fa-clock"></i>
                <div class="avail-info">
                  <span class="avail-label">Next Available:</span>
                  <span class="avail-time">{d.nextDate}</span>
                </div>
              </div>

              <button 
                class="view-profile-btn" 
                data-id={d.id}
                aria-label={`View full profile of ${d.name}`}
              >
                View Profile
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- Grid Empty State -->
      <div class="empty-doctors-state" id="emptyDoctorsState" style="display: none;">
        <div class="empty-state-icon"><i class="fas fa-user-slash"></i></div>
        <h3>No Doctors Found</h3>
        <p>No specialist matches your current filters. Try searching for other credentials or symptoms.</p>
        <button class="btn-primary" id="resetDoctorsFilterBtn">View All Doctors</button>
      </div>

      <!-- Load More Placeholder -->
      <div class="load-more-container text-center reveal reveal-up">
        <button class="btn-outline-primary" id="loadMoreBtn">
          <span class="btn-text">Load Additional Specialists</span>
          <span class="btn-spinner" style="display: none;"><i class="fas fa-spinner fa-spin"></i> Loading...</span>
        </button>
      </div>

    </div>
  </section>

  <!-- 4. WHY CHOOSE OUR DOCTORS -->
  <section class="why-doctors-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Standard of Excellence</span>
        <h2 class="section-title">Why Consult Our Doctors</h2>
        <p class="section-desc">We maintain the highest clinical staffing standards to guarantee diagnostic precision and recovery outcomes.</p>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card reveal reveal-up" style="transition-delay: 0s;">
          <div class="feature-icon"><i class="fas fa-certificate"></i></div>
          <h3>Board Certified</h3>
          <p>Every physician holds extensive post-graduate credentials (MD, DM, MS, M.Ch, FRCS) and national medical board certifications.</p>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card reveal reveal-up" style="transition-delay: 0.1s;">
          <div class="feature-icon"><i class="fas fa-heart"></i></div>
          <h3>Patient First</h3>
          <p>Empathetic diagnostics, customized recovery paths, and transparent billing compliance managed with extreme integrity.</p>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card reveal reveal-up" style="transition-delay: 0.2s;">
          <div class="feature-icon"><i class="fas fa-microchip"></i></div>
          <h3>Latest Technology</h3>
          <p>Equipped with flat-panel catheterization labs, micro-incision phaco ocular tools, and digital radiology scanner networks.</p>
        </div>

        <!-- Feature 4 -->
        <div class="feature-card reveal reveal-up" style="transition-delay: 0.3s;">
          <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
          <h3>Proven Results</h3>
          <p>Highly verified patient satisfaction score averages of 98% with reliable cardiac, orthopaedic, and stroke success histories.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. DOCTOR PROFILE POPUP MODAL (Dynamic Content Injected) -->
  <div class="profile-modal-overlay" id="doctorProfileModal" aria-hidden="true" role="dialog">
    <div class="profile-modal-card">
      <div class="modal-card-header">
        <h3 id="modalDocTitle"><i class="fas fa-user-md"></i> Doctor Profile Detail</h3>
        <button class="close-profile-modal-btn" id="closeProfileModalBtn" aria-label="Close profile modal"><i class="fas fa-times"></i></button>
      </div>

      <div class="modal-scroll-body">
        <div class="profile-modal-header-grid">
          <div class="profile-img-container">
            <img id="modalDocPhoto" src="/images/consultation.png" alt="Doctor photo" />
            <div class="experience-tag-badge" id="modalDocExp">15 Years Exp</div>
          </div>
          
          <div class="profile-meta-info">
            <span class="modal-dept-badge" id="modalDocDept">Cardiology</span>
            <h2 id="modalDocName">Dr. Sarah Johnson</h2>
            <p class="modal-role-subtitle" id="modalDocRole">Senior Cardiologist</p>
            <p class="modal-edu-text" id="modalDocEdu">MBBS, MD, DM (Cardiology), FACC</p>
            
            <div class="modal-stars-rating">
              <i class="fas fa-star"></i>
              <span id="modalDocRatingNum">4.9</span>
              <span class="reviews-count" id="modalDocReviews">(128 Reviews)</span>
            </div>
            
            <div class="modal-languages-spoken">
              <strong>Languages:</strong> <span id="modalDocLanguages">English, Tamil, Hindi</span>
            </div>
          </div>
        </div>

        <div class="profile-modal-details-grid">
          <div class="profile-biography-col">
            <h4>Biography</h4>
            <p id="modalDocBio">Biography contents...</p>

            <h4>Accreditations & Board Certifications</h4>
            <ul class="modal-certs-list" id="modalDocCerts">
              <!-- Dynamic JS insertion -->
            </ul>
          </div>

          <div class="profile-schedule-col">
            <div class="consultation-schedule-box">
              <h4><i class="far fa-calendar-alt"></i> Consultation Schedule</h4>
              <div class="schedule-table-card">
                <div class="schedule-row">
                  <span class="day-label">Consulting Days:</span>
                  <span class="day-value" id="modalDocSchedDays">Mon, Wed, Fri</span>
                </div>
                <div class="schedule-row">
                  <span class="day-label">Consulting Hours:</span>
                  <span class="day-value" id="modalDocSchedHours">09:00 AM - 01:00 PM</span>
                </div>
              </div>
            </div>

            <div class="schedule-booking-notes">
              <p><i class="fas fa-shield-alt"></i> Redirection facilitates instant booking via SMS token to Vairam hospital records desk.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="profile-modal-footer">
        <button class="btn-outline-secondary" id="modalGoBackBtn">Close Profile</button>
        <button class="btn-primary" id="modalTriggerBookBtn">Schedule Appointment Now</button>
      </div>
    </div>
  </div>

  <!-- 6. APPOINTMENT BOOKING MODAL -->
  <div class="booking-modal-overlay" id="doctorBookingModal" aria-hidden="true" role="dialog">
    <div class="booking-modal-card">
      <div class="modal-card-header">
        <h3><i class="far fa-calendar-check"></i> Book Doctor Appointment</h3>
        <button class="close-modal-btn" id="closeDoctorBookingBtn" aria-label="Close booking modal"><i class="fas fa-times"></i></button>
      </div>
      
      <form class="modal-booking-form" id="doctorsPageBookingForm">
        <div class="form-group">
          <label for="bookPatientName">Patient Full Name *</label>
          <input type="text" id="bookPatientName" required placeholder="e.g. Rajesh Kumar" />
        </div>
        
        <div class="form-group">
          <label for="bookPatientPhone">Mobile Number *</label>
          <input type="tel" id="bookPatientPhone" required placeholder="e.g. 93446 44555" pattern="[0-9\s+-]{10,15}" />
        </div>
        
        <div class="form-grid">
          <div class="form-group">
            <label for="bookDoctorSelect">Select Specialist Doctor *</label>
            <select id="bookDoctorSelect" required>
              <option value="">-- Select Specialist --</option>
              {doctorsData.map(d => (
                <option value={d.name} data-dept={d.specialty}>{d.name} ({d.role})</option>
              ))}
            </select>
          </div>
          
          <div class="form-group">
            <label for="bookDeptInput">Department</label>
            <input type="text" id="bookDeptInput" readonly placeholder="Selected doctor department" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="bookBookingDate">Appointment Date *</label>
            <input type="date" id="bookBookingDate" required />
          </div>
          
          <div class="form-group">
            <label for="bookTimeSlot">Preferred Time Slot *</label>
            <select id="bookTimeSlot" required>
              <option value="">-- Choose Slot --</option>
              <option value="09:00 AM">09:00 AM - 11:00 AM</option>
              <option value="11:00 AM">11:00 AM - 01:00 PM</option>
              <option value="02:00 PM">02:00 PM - 04:00 PM</option>
              <option value="04:00 PM">04:00 PM - 06:00 PM</option>
            </select>
          </div>
        </div>

        <button type="submit" class="submit-modal-btn">Confirm Appointment via WhatsApp</button>
      </form>
    </div>
  </div>

  <!-- STYLES -->
  <style>
    /* CSS Parser Safety */
    .doctors-init-safety-check {
      color: inherit;
    }

    /* UTILITIES */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px;
      width: 100%;
    }
    .text-center {
      text-align: center;
    }
    .section-header {
      margin-bottom: 50px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }
    .section-badge {
      display: inline-block;
      background: rgba(13, 148, 136, 0.08);
      color: #0d9488;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 6px 16px;
      border-radius: 50px;
      margin-bottom: 15px;
    }
    .section-title {
      font-size: 2.25rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 15px;
    }
    .section-desc {
      font-size: 1.05rem;
      color: #475569;
      line-height: 1.6;
    }
    .doctor-card.hidden {
      display: none !important;
    }

    /* 1. HERO SECTION */
    .doctors-hero {
      padding: 120px 5% 90px;
      background: #020617;
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      position: relative;
      overflow: hidden;
      color: #ffffff;
    }

    .hero-blur-glow {
      position: absolute;
      top: -20%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(20, 184, 166, 0.18) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero-grid-wrapper {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 60px;
      align-items: center;
      max-width: 1400px;
      margin: 0 auto;
    }

    .hero-left-content {
      max-width: 800px;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #14b8a6;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      padding: 8px 20px;
      border-radius: 50px;
      margin-bottom: 25px;
    }

    .hero-title {
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 25px;
      color: #ffffff;
    }

    .highlight-text {
      background: linear-gradient(120deg, #14b8a6 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 400;
      margin-bottom: 45px;
    }

    /* Stats cards grid */
    .stats-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 20px;
    }

    .stats-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 20px;
      border-radius: 16px;
      text-align: center;
      backdrop-filter: blur(4px);
    }

    .stats-card .stats-num {
      font-size: 2.2rem;
      font-weight: 800;
      color: #14b8a6;
      line-height: 1.1;
      margin-bottom: 6px;
    }

    .stats-card .stats-label {
      font-size: 0.82rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.8);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Hero right visuals */
    .hero-right-visual .img-wrapper {
      position: relative;
      max-width: 440px;
      margin: 0 auto;
    }

    .hero-team-img {
      width: 100%;
      border-radius: 30px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 6px solid rgba(255, 255, 255, 0.05);
      display: block;
    }

    .floating-rating-card {
      position: absolute;
      bottom: -20px;
      left: -20px;
      background: #ffffff;
      padding: 16px 24px;
      border-radius: 20px;
      box-shadow: 0 20px 40px -15px rgba(2, 6, 23, 0.4);
      display: flex;
      align-items: center;
      gap: 15px;
      border: 1px solid rgba(13, 148, 136, 0.15);
      animation: floatEffect 4s ease-in-out infinite;
    }

    @keyframes floatEffect {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .floating-rating-card .card-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #f0fdfa;
      color: #0d9488;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    .floating-rating-card .card-info h4 {
      font-size: 0.9rem;
      font-weight: 800;
      color: #020617;
      margin: 0 0 2px;
    }

    .floating-rating-card .card-info p {
      font-size: 0.8rem;
      font-weight: 700;
      color: #64748b;
      margin: 0;
    }

    .text-gold {
      color: #f59e0b;
    }

    /* 2. STICKY FILTER BAR */
    .filter-sticky-section {
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      padding: 18px 5%;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px -6px rgba(0, 0, 0, 0.05);
    }

    .filter-flex-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .dept-tabs {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .dept-tab-btn {
      padding: 10px 20px;
      background: #f1f5f9;
      color: #475569;
      border: 1.5px solid transparent;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.3s;
      font-family: inherit;
    }

    .dept-tab-btn:hover {
      background: #e2e8f0;
      color: #020617;
    }

    .dept-tab-btn.active {
      background: #0d9488;
      color: #ffffff;
    }

    /* Search Input Box */
    .search-input-box {
      width: 100%;
      max-width: 380px;
      position: relative;
    }

    .search-input-box i {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      pointer-events: none;
    }

    .search-input-box input {
      width: 100%;
      padding: 12px 45px 12px 48px;
      border-radius: 12px;
      border: 1.5px solid #cbd5e1;
      outline: none;
      font-family: inherit;
      font-size: 0.95rem;
      transition: border 0.3s, background 0.3s;
      background: #f8fafc;
      color: #0f172a;
    }

    .search-input-box input:focus {
      border-color: #0d9488;
      background: #ffffff;
    }

    .clear-btn {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 0.95rem;
      cursor: pointer;
      padding: 3px;
      display: none;
    }

    .clear-btn:hover {
      color: #0f172a;
    }

    /* 3. DOCTORS CARD GRID */
    .doctors-grid-section {
      padding: 60px 5% 100px;
      background: #ffffff;
    }

    .filter-status-banner {
      max-width: 1400px;
      margin: -20px auto 45px;
      padding: 14px 24px;
      background: #f0fdfa;
      border: 1px solid rgba(13, 148, 136, 0.15);
      border-radius: 12px;
    }

    .filter-status-banner p {
      margin: 0;
      font-size: 0.95rem;
      color: #0f766e;
    }

    .filter-status-banner button {
      background: none;
      border: none;
      text-decoration: underline;
      color: #0d9488;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      margin-left: 5px;
    }

    .doctors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(285px, 1fr));
      gap: 35px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .doctor-card {
      background: #ffffff;
      border-radius: 24px;
      border: 1px solid rgba(13, 148, 136, 0.08);
      box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
    }

    .doctor-card:hover {
      transform: translateY(-8px);
      border-color: rgba(13, 148, 136, 0.25);
      box-shadow: var(--shadow-premium);
    }

    .card-image-wrapper {
      height: 260px;
      position: relative;
      overflow: hidden;
      background: #f0f7f7;
    }

    .doc-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .doctor-card:hover .doc-card-img {
      transform: scale(1.05);
    }

    /* Availability pulse badges */
    .availability-pulse {
      position: absolute;
      top: 15px;
      left: 15px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 0.72rem;
      font-weight: 800;
      backdrop-filter: blur(4px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .pulse-green {
      background: rgba(255, 255, 255, 0.95);
      color: #15803d;
      border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .pulse-blue {
      background: rgba(255, 255, 255, 0.95);
      color: #0f766e;
      border: 1px solid rgba(13, 148, 136, 0.2);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      position: relative;
      display: inline-block;
    }

    .pulse-green .pulse-dot {
      background: #22c55e;
    }
    .pulse-blue .pulse-dot {
      background: #0d9488;
    }

    .pulse-dot::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      animation: pulseEffect 1.5s infinite;
    }

    .pulse-green .pulse-dot::after {
      background: #22c55e;
    }
    .pulse-blue .pulse-dot::after {
      background: #0d9488;
    }

    @keyframes pulseEffect {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(2.4); opacity: 0; }
    }

    /* Social hover overlay list */
    .social-hover-overlay {
      position: absolute;
      bottom: -50px;
      left: 0;
      right: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(2, 6, 23, 0.75) 100%);
      padding: 20px;
      display: flex;
      justify-content: center;
      gap: 15px;
      transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .doctor-card:hover .social-hover-overlay {
      bottom: 0;
    }

    .social-hover-overlay a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      color: #0f766e;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.92rem;
      text-decoration: none;
      transition: all 0.3s;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .social-hover-overlay a:hover {
      background: #0d9488;
      color: #ffffff;
      transform: translateY(-2px);
    }

    .card-body {
      padding: 25px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .specialty-badge {
      display: inline-block;
      align-self: flex-start;
      background: rgba(13, 148, 136, 0.08);
      color: #0f766e;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }

    .star-rating {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-bottom: 8px;
    }

    .star-rating i {
      color: #f59e0b;
      font-size: 0.85rem;
    }

    .rating-num {
      font-size: 0.85rem;
      font-weight: 700;
      color: #0f172a;
    }

    .rating-reviews {
      font-size: 0.8rem;
      color: #64748b;
    }

    .doc-name {
      font-size: 1.25rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 4px;
    }

    .doc-role {
      font-size: 0.88rem;
      font-weight: 700;
      color: #0d9488;
      margin-bottom: 6px;
    }

    .doc-edu {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      margin-bottom: 12px;
    }

    .doc-bio-excerpt {
      font-size: 0.88rem;
      line-height: 1.5;
      color: #475569;
      margin-bottom: 20px;
    }

    .doc-meta-divider {
      height: 1px;
      background: #f1f5f9;
      margin-bottom: 15px;
      margin-top: auto;
    }

    .next-avail-box {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .next-avail-box i {
      color: #0d9488;
      font-size: 1rem;
    }

    .avail-info {
      display: flex;
      flex-direction: column;
    }

    .avail-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: #64748b;
      line-height: 1.2;
    }

    .avail-time {
      font-size: 0.85rem;
      font-weight: 700;
      color: #020617;
    }

    .view-profile-btn {
      width: 100%;
      background: #f8fafc;
      color: #0f766e;
      border: 1.5px solid rgba(13, 148, 136, 0.1);
      padding: 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      transition: all 0.3s;
      font-family: inherit;
    }

    .doctor-card:hover .view-profile-btn {
      background: #0d9488;
      color: #ffffff;
      border-color: #0d9488;
      box-shadow: 0 8px 16px -4px rgba(13, 148, 136, 0.3);
    }

    /* Grid Empty State */
    .empty-doctors-state {
      text-align: center;
      padding: 80px 20px;
      max-width: 500px;
      margin: 0 auto;
    }

    .empty-doctors-state .empty-state-icon {
      font-size: 4rem;
      color: #cbd5e1;
      margin-bottom: 20px;
    }

    .empty-doctors-state h3 {
      font-size: 1.5rem;
      color: #0f172a;
      margin-bottom: 10px;
    }

    .empty-doctors-state p {
      color: #64748b;
      margin-bottom: 25px;
      line-height: 1.6;
    }

    /* Load More Placeholder */
    .load-more-container {
      margin-top: 50px;
    }

    .btn-outline-primary {
      background: transparent;
      color: #0d9488;
      border: 2px solid #0d9488;
      padding: 14px 32px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.3s;
      font-family: inherit;
    }

    .btn-outline-primary:hover {
      background: #0d9488;
      color: #ffffff;
      box-shadow: 0 8px 20px -6px rgba(13, 148, 136, 0.3);
    }

    /* 4. WHY CHOOSE OUR DOCTORS */
    .why-doctors-section {
      padding: 100px 5%;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .feature-card {
      background: #ffffff;
      border: 1px solid rgba(13, 148, 136, 0.05);
      padding: 40px 30px;
      border-radius: 24px;
      box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.03);
      transition: all 0.3s;
    }

    .feature-card:hover {
      transform: translateY(-6px);
      border-color: rgba(13, 148, 136, 0.2);
      box-shadow: var(--shadow-premium);
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: rgba(13, 148, 136, 0.08);
      color: #0d9488;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 25px;
      transition: all 0.3s;
    }

    .feature-card:hover .feature-icon {
      background: #0d9488;
      color: #ffffff;
    }

    .feature-card h3 {
      font-size: 1.2rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 12px;
    }

    .feature-card p {
      font-size: 0.9rem;
      line-height: 1.6;
      color: #475569;
    }

    /* 5. DOCTOR PROFILE POPUP MODAL */
    .profile-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(2, 6, 23, 0.6);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 20px;
    }

    .profile-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .profile-modal-card {
      background: #ffffff;
      width: 100%;
      max-width: 850px;
      height: 90%;
      max-height: 750px;
      border-radius: 28px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(13, 148, 136, 0.1);
      overflow: hidden;
      transform: translateY(40px) scale(0.95);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
    }

    .profile-modal-overlay.active .profile-modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-card-header {
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      padding: 25px 35px;
      color: #ffffff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
    }

    .modal-card-header h3 {
      font-size: 1.25rem;
      font-weight: 800;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .close-profile-modal-btn {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.85);
      font-size: 1.25rem;
      cursor: pointer;
      padding: 5px;
      transition: all 0.3s;
    }

    .close-profile-modal-btn:hover {
      color: #ffffff;
      transform: rotate(90deg);
    }

    .modal-scroll-body {
      padding: 35px;
      overflow-y: auto;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    /* Modal header grid */
    .profile-modal-header-grid {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 35px;
      align-items: center;
      border-bottom: 1px dashed #cbd5e1;
      padding-bottom: 30px;
    }

    .profile-img-container {
      position: relative;
      height: 200px;
      border-radius: 20px;
      overflow: hidden;
      background: #f1faf9;
      border: 1px solid #cbd5e1;
    }

    .profile-img-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .experience-tag-badge {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      background: #0d9488;
      color: #ffffff;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.72rem;
      font-weight: 800;
      white-space: nowrap;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .modal-dept-badge {
      display: inline-block;
      background: rgba(13, 148, 136, 0.08);
      color: #0f766e;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    #modalDocName {
      font-size: 1.8rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 4px;
    }

    .modal-role-subtitle {
      font-size: 1.05rem;
      font-weight: 700;
      color: #0d9488;
      margin-bottom: 6px;
    }

    .modal-edu-text {
      font-size: 0.9rem;
      font-weight: 600;
      color: #64748b;
      margin-bottom: 12px;
    }

    .modal-stars-rating {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 0.9rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 12px;
    }

    .modal-stars-rating i {
      color: #f59e0b;
    }

    .modal-stars-rating .reviews-count {
      color: #64748b;
      font-weight: 600;
    }

    .modal-languages-spoken {
      font-size: 0.9rem;
      color: #334155;
    }

    /* Modal details grid */
    .profile-modal-details-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 35px;
    }

    .profile-biography-col h4,
    .profile-schedule-col h4 {
      font-size: 1.1rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 12px;
    }

    .profile-biography-col p {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #475569;
      margin-bottom: 25px;
    }

    .modal-certs-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .modal-certs-list li {
      position: relative;
      padding-left: 20px;
      font-size: 0.9rem;
      color: #334155;
    }

    .modal-certs-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 0;
      color: #0d9488;
      font-weight: 800;
    }

    .consultation-schedule-box {
      background: #f0fdfa;
      border: 1px solid rgba(13, 148, 136, 0.15);
      border-radius: 20px;
      padding: 24px;
    }

    .consultation-schedule-box h4 {
      color: #0f766e;
      margin-bottom: 18px;
    }

    .schedule-table-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .schedule-row {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 0.88rem;
    }

    .day-label {
      font-weight: 700;
      color: #0f766e;
    }

    .day-value {
      font-weight: 600;
