---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import sidhuHero from "../assets/images/sidhuhero.webp";
import drPrabhu from "../assets/images/dr-prabhu.webp";
import FeatureBand from "../components/ui/FeatureBand.astro";
import DoctorCard from "../components/ui/DoctorCard.astro";
import DoctorAvatar from "../components/ui/DoctorAvatar.astro";
import Icon from "../components/ui/Icon.astro";
import { doctors, doctorDepartments } from "../data/doctors";
import { specialities } from "../data/specialities";
import { site, telHref } from "../data/site";

// Featured consultant: Dr. R. Chitarth (fellowship-trained, has a photo)
const featured = doctors.find((d) => d.id === "dr-r-chitarth") ?? doctors[0];

// Department meta (icon + speciality page) for each department that has doctors
const deptMeta = doctorDepartments.map((name) => {
  const s = specialities.find((x) => x.short === name);
  return {
    name,
    id: s?.id,
    icon: s?.icon ?? ("stethoscope" as const),
    sub: s?.sub ?? "",
    count: doctors.filter((d) => d.speciality === name).length,
  };
});

const heroStats = [
  { value: `${doctors.length}`, label: "Specialist consultants" },
  { value: `${doctorDepartments.length}`, label: "Departments" },
  { value: "Hand", label: "Sports & joint surgery" },
  { value: "24/7", label: "Emergency doctors" },
];

const steps = [
  { icon: "user-search", title: "Choose your doctor", text: "Search by name or speciality, and check OPD days and timings." },
  { icon: "calendar", title: "Request a slot", text: "Book online, on WhatsApp or by phone. It takes under a minute." },
  { icon: "check", title: "Get confirmation", text: "Our desk confirms your appointment time on WhatsApp." },
  { icon: "stethoscope", title: "Meet your specialist", text: "Arrive 15 minutes early with your ID and previous reports." },
] as const;

const why = [
  { icon: "graduation", title: "Highly qualified", text: "Consultants with MD, MS, DM, M.Ch and DNB qualifications and years of hospital experience." },
  { icon: "users", title: "Team-based care", text: "Specialists, nurses, lab and imaging teams work together on one plan for you." },
  { icon: "languages", title: "We speak your language", text: "Doctors explain your condition clearly in Tamil and English." },
  { icon: "clock", title: "Time for every patient", text: "Scheduled OPD slots so your consultation is unhurried and thorough." },
] as const;

const faqs = [
  { q: "How do I book an appointment with a specific doctor?", a: "Click “Book” on the doctor's card, or call our helpdesk. We'll confirm your slot on WhatsApp." },
  { q: "Can I consult a doctor outside OPD hours?", a: "For emergencies, our emergency doctors are available 24/7. For routine consultations, please book within the listed OPD timings." },
  { q: "What should I bring to my consultation?", a: "A photo ID, previous prescriptions, test and scan reports, and your insurance card if you have one." },
  { q: "Do doctors offer follow-up or online consultations?", a: "Yes. Follow-ups can be booked in person, and video consultations are available for report reviews and selected cases." },
];

const ld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Specialist doctors at ${site.name}`,
  itemListElement: doctors.map((d, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Physician",
      name: d.name,
      medicalSpecialty: d.speciality,
      telephone: site.phone,
      address: { "@type": "PostalAddress", addressLocality: site.address.city, addressRegion: site.address.regionCode },
    },
  })),
};
---

<Layout
  ogImage="/og/doctors.jpg"
  title="Find a Doctor | Specialist Doctors at Vairam Hospital, Mayiladuthurai"
  description="Find cardiologists, orthopaedic surgeons, neurologists, paediatricians and eye specialists at Vairam Multi Speciality Hospital, Mayiladuthurai. View timings and book an appointment."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <PageHeader
    crumb="Doctors"
    eyebrow="Find a doctor"
    title="Best Specialist Doctors in Mayiladuthurai"
    lede="Consult experienced orthopaedic surgeons, a cardiologist, gynaecologists, a paediatrician, a plastic surgeon, a chest physician, general surgeons and physicians at Vairam Hospital, Mayiladuthurai. Check OPD timings and book an appointment online or on WhatsApp."
    team={[
      { src: drPrabhu, alt: "Vairam Hospital consultant", x: 16, h: 92, z: 2 },
      { src: sidhuHero, alt: "Dr. R. Chitarth, orthopaedic surgeon at Vairam Hospital", x: 45, h: 100, z: 4 },
    ]}
    stats={heroStats}
  />

  <!-- Search panel -->
  <section class="finder-wrap" aria-label="Find a doctor">
    <div class="container">
      <form class="finder" id="finder" role="search">
        <div class="finder__field finder__field--grow">
          <label for="docSearch">Doctor name or qualification</label>
          <div class="finder__input">
            <Icon name="search" size={18} />
            <input id="docSearch" type="search" placeholder="e.g. Dr. Wilson, DM Cardiology" autocomplete="off" />
          </div>
        </div>
        <div class="finder__field">
          <label for="docDept">Department</label>
          <div class="finder__input">
            <Icon name="grid" size={18} />
            <select id="docDept">
              <option value="all">All departments</option>
              {doctorDepartments.map((d) => <option value={d}>{d}</option>)}
            </select>
          </div>
        </div>
        <button type="submit" class="btn finder__btn"><Icon name="search" /> Find doctors</button>
      </form>
    </div>
  </section>

  <!-- Featured -->
  <section class="section featured-wrap" aria-labelledby="featTitle">
    <div class="container">
      <div class="feat reveal">
        <div class="feat__photo">
          {featured.photo ? (
            <Image src={featured.photo} alt={`${featured.name}, ${featured.role}`} widths={[400, 600]} sizes="(max-width: 860px) 100vw, 380px" loading="lazy" />
          ) : (
            <DoctorAvatar doctor={featured} />
          )}
          {!featured.detailsPending && <span class="feat__badge"><Icon name="award" size={16} /> {featured.experience}</span>}
        </div>
        <div class="feat__body">
          <p class="eyebrow">Featured specialist</p>
          <h2 id="featTitle">{featured.name}</h2>
          <p class="feat__role">{featured.role} · {featured.speciality}</p>
          <p class="feat__bio">{featured.bio}</p>
          <ul role="list" class="feat__facts">
            <li><Icon name="graduation" size={18} /><span><small>Qualifications</small>{featured.education}</span></li>
            <li><Icon name="clock" size={18} /><span><small>OPD timings</small>{featured.days} · {featured.hours}</span></li>
            <li><Icon name="languages" size={18} /><span><small>Languages</small>{featured.languages}</span></li>
          </ul>
          <div class="feat__actions">
            <button type="button" class="btn" data-book data-dept={featured.speciality} data-doctor={featured.name}>
              <Icon name="calendar" /> Book appointment
            </button>
            <button type="button" class="btn btn--outline" data-profile={featured.id}>View full profile</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Directory -->
  <section class="section section--paper2 dir" id="directory" aria-labelledby="dirTitle">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="section-head" style="margin:0">
          <p class="eyebrow">Doctor directory</p>
          <h2 id="dirTitle">Meet our consultants</h2>
        </div>
        <p class="dir__status" id="docStatus" role="status">Showing all {doctors.length} doctors</p>
      </div>

      <div class="dir__chips chips" role="group" aria-label="Filter by department">
        <button type="button" class="chip" data-filter="all" aria-pressed="true">All <span>{doctors.length}</span></button>
        {
          deptMeta.map((d) => (
            <button type="button" class="chip" data-filter={d.name} aria-pressed="false">
              {d.name} <span>{d.count}</span>
            </button>
          ))
        }
      </div>

      <ul role="list" class="docs-grid">
        {doctors.map((d) => <li class="reveal"><DoctorCard doctor={d} profile /></li>)}
      </ul>
      <div class="docs-empty" id="docEmpty" hidden>
        <span class="icon-tile"><Icon name="user-search" size={26} /></span>
        <h3>No doctors found</h3>
        <p>Try a different name, or call {site.phoneDisplay} and we'll help you find the right specialist.</p>
        <button type="button" class="btn btn--outline" id="docReset">Show all doctors</button>
      </div>
    </div>
  </section>

  <!-- Departments -->
  <section class="section section--white" aria-labelledby="deptTitle">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Browse by department</p>
        <h2 id="deptTitle">Find the right specialist</h2>
        <p class="lede">Not sure who to see? Start with the department, or call us and we'll guide you.</p>
      </div>
      <ul role="list" class="depts">
        {
          deptMeta.map((d) => (
            <li class="dept lift reveal">
              <span class="icon-tile"><Icon name={d.icon} size={26} /></span>
              <div>
                <h3>{d.name}</h3>
                <p>{d.sub}</p>
              </div>
              <p class="dept__count">
                <strong>{d.count}</strong> {d.count === 1 ? "doctor" : "doctors"}
              </p>
              <div class="dept__actions">
                <button type="button" class="link-arrow" data-jump={d.name}>View doctors <Icon name="arrow-right" /></button>
                {d.id && <a href={`/services/${d.id}`} class="dept__more">About {d.name.toLowerCase()}</a>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- OPD schedule -->
  <section class="section section--paper2" aria-labelledby="opdTitle">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="section-head" style="margin:0">
          <p class="eyebrow">OPD schedule</p>
          <h2 id="opdTitle">Weekly consultation timings</h2>
        </div>
        <p class="lede">Timings may change on public holidays. Call {site.phoneDisplay} to confirm.</p>
      </div>
      <div class="opd reveal">
        <table>
          <thead>
            <tr>
              <th scope="col">Doctor</th>
              <th scope="col">Department</th>
              <th scope="col">Days</th>
              <th scope="col">Timings</th>
              <th scope="col"><span class="visually-hidden">Book</span></th>
            </tr>
          </thead>
          <tbody>
            {
              doctors.map((d) => (
                <tr>
                  <th scope="row">
                    <span class="opd__doc">
                      {d.photo ? (
                        <Image src={d.photo} alt="" width={40} height={40} widths={[80]} loading="lazy" />
                      ) : (
                        <span class="opd__avatar"><DoctorAvatar doctor={d} /></span>
                      )}
                      <span>
                        {d.name}
                        <small>{d.role}</small>
                      </span>
                    </span>
                  </th>
                  <td data-label="Department"><span class="tag">{d.speciality}</span></td>
                  <td data-label="Days">{d.days}</td>
                  <td data-label="Timings">{d.hours}</td>
                  <td>
                    <button type="button" class="btn btn--sm" data-book data-dept={d.speciality} data-doctor={d.name}>Book</button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How to book -->
  <section class="section section--white" aria-labelledby="stepsTitle">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Appointments</p>
        <h2 id="stepsTitle">Booking a consultation is simple</h2>
      </div>
      <ol role="list" class="steps">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">{i + 1}</span>
              <span class="icon-tile"><Icon name={s.icon} size={24} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why our doctors -->
  <FeatureBand
    eyebrow="Why our doctors"
    title="Expertise you can trust, care you can feel"
    text="Every Vairam consultant is chosen for clinical skill and for the way they treat patients and families."
    items={[...why]}
    cta={{ label: "Book a consultation", action: "book" }}
  />

  <!-- FAQ -->
  <section class="section section--white" aria-labelledby="dfaqTitle">
    <div class="container fq">
      <div>
        <div class="section-head">
          <p class="eyebrow">FAQs</p>
          <h2 id="dfaqTitle">Questions about consultations</h2>
        </div>
        <div class="faq">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
      <aside class="careers">
        <span class="icon-tile"><Icon name="stethoscope" size={24} /></span>
        <h3>Are you a doctor?</h3>
        <p>We're always looking for skilled, compassionate consultants to join our growing team in Mayiladuthurai.</p>
        <a href={`mailto:${site.email}?subject=Consultant%20opportunity%20at%20Vairam`} class="btn btn--outline btn--block">
          <Icon name="mail" /> Send your CV
        </a>
        <a href={telHref} class="careers__call"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </aside>
    </div>
  </section>

  <!-- Profile dialogs (rendered statically so profiles are indexable) -->
  {
    doctors.map((d) => (
      <dialog class="profile" id={`profile-${d.id}`} aria-labelledby={`pname-${d.id}`}>
        <button type="button" class="profile__close" data-close-dialog>
          <Icon name="x" size={22} />
          <span class="visually-hidden">Close</span>
        </button>
        <div class="profile__grid">
          <div class="profile__photo">
            {d.photo ? (
              <Image src={d.photo} alt={d.name} widths={[360, 540]} sizes="(max-width: 700px) 100vw, 300px" loading="lazy" />
            ) : (
              <DoctorAvatar doctor={d} />
            )}
          </div>
          <div class="profile__body">
            <p class="eyebrow">{d.speciality}</p>
            <h2 id={`pname-${d.id}`}>{d.name}</h2>
            <p class="profile__role">{d.role} · {d.experience}</p>
            <p>{d.bio}</p>
            <dl class="profile__facts">
              <div>
                <dt><Icon name="graduation" size={16} /> Qualifications</dt>
                <dd>{d.education}</dd>
              </div>
              <div>
                <dt><Icon name="clock" size={16} /> OPD timings</dt>
                <dd>{d.days} · {d.hours}</dd>
              </div>
              <div>
                <dt><Icon name="languages" size={16} /> Languages</dt>
                <dd>{d.languages}</dd>
              </div>
            </dl>
            {d.certifications.length > 0 && (
              <>
                <h3>Training & credentials</h3>
                <ul class="check-list">{d.certifications.map((c) => <li>{c}</li>)}</ul>
              </>
            )}
            <button type="button" class="btn" data-book data-dept={d.speciality} data-doctor={d.name}>
              <Icon name="calendar" /> Book with {d.name}
            </button>
          </div>
        </div>
      </dialog>
    ))
  }
</Layout>

<style>
  .eyebrow--light {
    color: var(--teal-100);
  }

  /* Finder */
  .finder-wrap {
    position: relative;
    z-index: 5;
    margin-top: -48px;
  }
  .finder {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    align-items: end;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
  }
  .finder__field {
    display: grid;
    gap: 6px;
  }
  .finder__field label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .finder__input {
    position: relative;
  }
  .finder__input :global(svg) {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--blue-600);
    pointer-events: none;
  }
  .finder__input input,
  .finder__input select {
    width: 100%;
    min-height: 52px;
    padding: 0 14px 0 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--paper-2);
    font-size: 1rem;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .finder__input input:focus,
  .finder__input select:focus {
    outline: none;
    background: var(--white);
    border-color: var(--blue-600);
    box-shadow: 0 0 0 3px rgb(27 88 184 / 0.15);
  }
  .finder__btn {
    min-height: 52px;
  }

  /* Featured */
  .featured-wrap {
    padding-top: var(--s-9);
  }
  .feat {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: var(--s-5);
    background: linear-gradient(120deg, var(--blue-50), var(--white) 60%);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .feat__photo {
    position: relative;
    aspect-ratio: 4 / 4.6;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--paper-2);
  }
  .feat__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }
  .feat__badge {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--r-sm);
    background: var(--navy-900);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .feat__body {
    padding-right: var(--s-5);
  }
  .feat__body h2 {
    margin: var(--s-3) 0 var(--s-1);
  }
  .feat__role {
    font-weight: 700;
    color: var(--blue-600);
  }
  .feat__bio {
    margin: var(--s-4) 0 var(--s-5);
    color: var(--ink-2);
    max-width: 60ch;
  }
  .feat__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-block: 1px solid var(--line);
  }
  .feat__facts li {
    display: flex;
    gap: var(--s-3);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--navy-900);
  }
  .feat__facts :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--blue-600);
  }
  .feat__facts small {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .feat__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  /* Directory */
  .dir {
    scroll-margin-top: var(--header-h);
  }
  .dir__status {
    font-weight: 600;
    color: var(--ink-muted);
  }
  .dir__chips {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    margin: 0 calc(var(--gutter) * -1) var(--s-6);
    padding: var(--s-3) var(--gutter);
    background: var(--paper-2);
  }
  .dir__chips .chip span {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: var(--r-sm);
    background: var(--paper-2);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-muted);
  }
  .dir__chips .chip[aria-pressed="true"] span {
    background: rgb(255 255 255 / 0.2);
    color: var(--white);
  }
  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--s-5);
  }
  .docs-empty {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-9) var(--s-5);
    text-align: center;
    background: var(--white);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-lg);
  }
  .docs-empty p {
    color: var(--ink-muted);
    max-width: 46ch;
  }

  /* Departments */
  .depts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-5);
  }
  .dept {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .dept h3 {
    font-size: 1.25rem;
  }
  .dept p {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  .dept__count {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .dept__count strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--navy-900);
  }
  .dept__actions {
    display: grid;
    gap: var(--s-2);
    margin-top: auto;
  }
  .dept__actions .link-arrow {
    justify-self: start;
    padding: 0;
  }
  .dept__more {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-muted);
  }
  .dept__more:hover {
    color: var(--blue-600);
  }

  /* OPD table */
  .opd {
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
  }
  .opd table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .opd thead th {
    padding: var(--s-4) var(--s-5);
    background: var(--navy-900);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
  }
  .opd tbody th,
  .opd td {
    padding: var(--s-3) var(--s-5);
    border-top: 1px solid var(--line);
    text-align: left;
    color: var(--ink-2);
  }
  .opd tbody tr {
    transition: background var(--dur) var(--ease);
  }
  .opd tbody tr:hover {
    background: var(--blue-50);
  }
  .opd td:last-child {
    text-align: right;
  }
  .opd__doc {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-weight: 700;
    color: var(--navy-900);
  }
  .opd__avatar {
    flex: none;
    width: 40px;
