---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FeatureBand from "../components/ui/FeatureBand.astro";
import Icon from "../components/ui/Icon.astro";
import BookingForm from "../components/ui/BookingForm.astro";
import { site, telHref, tel2Href, waHref } from "../data/site";
import { contactFaqs } from "../data/faqs";
---

<Layout
  ogImage="/og/contact.jpg"
  title="Contact & Appointments | Vairam Multi Speciality Hospital, Mayiladuthurai"
  description={`Call ${site.phoneDisplay}, WhatsApp or visit Vairam Multi Speciality Hospital on Pattamangala Street, Mayiladuthurai. Book a specialist appointment online.`}
>
  <PageHeader
    crumb="Contact"
    eyebrow="Contact & appointments"
    title="Contact Vairam Hospital, Mayiladuthurai"
    lede={`Vairam Multi Speciality Hospital is at ${site.addressLine}. Call ${site.phoneDisplay} (24/7 emergency) or book an appointment online. OPD is open every day from 8 AM to 9 PM.`}
    stats={[
      { value: "24/7", label: "Emergency & ambulance line" },
      { value: "7 days", label: "OPD open every day" },
      { value: "1 min", label: "To request an appointment" },
      { value: "WhatsApp", label: "Booking confirmation" },
    ]}
  />

  <section class="section">
    <div class="container ct">
      <div class="ct__info">
        <a href={telHref} class="ct__er">
          <span class="ct__er-icon"><Icon name="siren" size={24} /></span>
          <span>
            <small>24/7 Emergency & ambulance</small>
            <strong>{site.phoneDisplay}</strong>
          </span>
        </a>

        <ul role="list" class="ct__list">
          <li>
            <Icon name="map-pin" size={22} />
            <div>
              <h2>Address</h2>
              <p>{site.addressLine}</p>
              <a href={site.directions} target="_blank" rel="noopener" class="link-arrow">Get directions <Icon name="arrow-right" /></a>
            </div>
          </li>
          <li>
            <Icon name="phone" size={22} />
            <div>
              <h2>Phone & WhatsApp</h2>
              <p><a href={telHref}>{site.phoneDisplay}</a> · <a href={tel2Href}>{site.phone2Display}</a></p>
              <a href={waHref()} target="_blank" rel="noopener" class="link-arrow">Chat on WhatsApp <Icon name="arrow-right" /></a>
            </div>
          </li>
          <li>
            <Icon name="mail" size={22} />
            <div>
              <h2>Email</h2>
              <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            </div>
          </li>
          <li>
            <Icon name="clock" size={22} />
            <div>
              <h2>Hours</h2>
              <dl class="ct__hours">
                {
                  site.hours.map((h) => (
                    <div>
                      <dt>{h.label}</dt>
                      <dd>{h.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </li>
        </ul>
      </div>

      <div class="ct__form card" id="book">
        <p class="eyebrow">Appointments</p>
        <h2 class="ct__form-title">Request an appointment</h2>
        <p class="ct__form-lede">Choose a speciality and a preferred time. We'll confirm availability shortly.</p>
        <BookingForm idPrefix="ct" />
      </div>
    </div>
  </section>

  <section class="ct-map" aria-label="Map">
    <iframe src={site.mapEmbed} title={`Map showing ${site.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </section>

  <FeatureBand
    eyebrow="Reaching us is easy"
    title="Help is always one call or message away"
    text="Whether it's an emergency, a question or a routine appointment, our team makes it simple to get the care you need."
    items={[
      { icon: "map-pin", title: "Central location", text: "On Pattamangala Street in the heart of Mayiladuthurai, easy to reach by road." },
      { icon: "car", title: "Parking on site", text: "Space for cars and two-wheelers, with drop-off right at the entrance." },
      { icon: "phone", title: "24/7 helpline", text: "Call any time for emergencies, ambulance support or appointment help." },
      { icon: "whatsapp", title: "WhatsApp booking", text: "Request an appointment and receive your confirmation on WhatsApp." },
    ]}
    cta={{ label: "Call the helpline", action: "call" }}
  />

  <section class="section section--white" aria-labelledby="cfaqTitle">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Help desk</p>
        <h2 id="cfaqTitle">Getting here & your visit</h2>
      </div>
      <div class="faq">
        {
          contactFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .ct {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ct__er {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
    border-radius: var(--r-md);
    background: var(--alert-50);
    border: 1px solid rgb(194 39 45 / 0.2);
    color: var(--alert-600);
  }
  .ct__er-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--alert-600);
    color: var(--white);
    flex: none;
  }
  .ct__er small {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ct__er strong {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
  }
  .ct__list {
    display: grid;
  }
  .ct__list > li {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--line);
  }
  .ct__list > li > :global(svg) {
    flex: none;
    color: var(--teal-600);
    margin-top: 2px;
  }
  .ct__list h2 {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--s-2);
  }
  .ct__list p {
    color: var(--ink-2);
    margin-bottom: var(--s-2);
  }
  .ct__list p a:hover {
    color: var(--teal-700);
  }
  .ct__hours {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }
  .ct__hours dt {
    font-weight: 600;
    color: var(--ink-2);
  }
  .ct__hours dd {
    color: var(--ink-muted);
  }
  .ct__form {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .ct__form-title {
    margin: var(--s-3) 0 var(--s-2);
    font-size: 2rem;
  }
  .ct__form-lede {
    color: var(--ink-muted);
    margin-bottom: var(--s-6);
  }
  .ct-map {
    height: 420px;
    background: var(--paper-2);
  }
  .ct-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--s-8);
  }
  @media (max-width: 960px) {
    .ct,
    .faq-wrap {
      grid-template-columns: 1fr;
    }
    .ct-map {
      height: 320px;
    }
  }
</style>
