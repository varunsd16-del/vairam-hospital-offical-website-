---
import Layout from '../layouts/Layout.astro';

const doctorsByDept = {
  Cardiology: [
    { name: "Dr. Sarah Johnson (Senior Cardiologist)" },
    { name: "Dr. Robert Martinez (Consultant Cardiologist)" }
  ],
  Neurology: [
    { name: "Dr. Michael Chen (Senior Neurologist)" },
    { name: "Dr. Amanda Foster (Consulting Neurologist)" }
  ],
  Orthopedics: [
    { name: "Dr. James Wilson (Senior Orthopedic Surgeon)" },
    { name: "Dr. David Kim (Sports Medicine Specialist)" }
  ],
  Pediatrics: [
    { name: "Dr. Emily Rodriguez (Consultant Pediatrician)" }
  ],
  Ophthalmology: [
    { name: "Dr. Lisa Park (Ophthalmic Surgeon)" }
  ]
};
const departments = Object.keys(doctorsByDept);
---

<Layout title="Contact Us & Book Appointments | Vairam Multi Speciality Hospital Mayiladuthurai">

  <!-- JSON-LD Hospital Schema for Local SEO & GEO -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Hospital",
      "name": "Vairam Multi Speciality Hospital",
      "image": "https://vairamhospital.com/images/Logo.png",
      "url": "https://vairamhospital.com/contact",
      "telephone": "+919344644555",
      "email": "info@vairamhospital.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pattamangala St",
        "addressLocality": "Mayiladuthurai",
        "addressRegion": "TN",
        "postalCode": "609001",
        "addressCountry": "IN"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 11.1017, "longitude": 79.6548 },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    }
  </script>

  <!-- STYLES — placed before HTML so Astro includes CSS in the bundle -->
  <style is:global>
    /* CSS Parser Init Safety */
    .cp-init { color: inherit; }

    /* ═══════════════════════════════════════════
       UTILITIES
    ═══════════════════════════════════════════ */
    .cp-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
      width: 100%;
    }

    /* ═══════════════════════════════════════════
       1. HERO SECTION
    ═══════════════════════════════════════════ */
    .cp-hero {
      padding: 130px 5% 100px;
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      position: relative;
      overflow: hidden;
      color: #fff;
    }
    .cp-hero-glow {
      position: absolute;
      top: -20%;
      right: -10%;
      width: 650px;
      height: 650px;
      background: radial-gradient(circle, rgba(20,184,166,0.18) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .cp-hero-inner {
      max-width: 820px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .cp-hero-badge {
      display: inline-block;
      background: rgba(255,255,255,0.09);
      border: 1px solid rgba(255,255,255,0.15);
      color: #14b8a6;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      padding: 8px 22px;
      border-radius: 50px;
      margin-bottom: 26px;
    }
    .cp-hero-title {
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 24px;
    }
    .cp-hero-title .cp-gradient-text {
      background: linear-gradient(120deg, #14b8a6 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .cp-hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.75;
      color: rgba(255,255,255,0.82);
      font-weight: 400;
    }

    /* ═══════════════════════════════════════════
       2. CONTACT + FORM SECTION
    ═══════════════════════════════════════════ */
    .cp-main-section {
      padding: 90px 5%;
      background: #ffffff;
    }
    .cp-two-col {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
      align-items: start;
    }

    /* Left: Contact Info */
    .cp-info-header {
      margin-bottom: 40px;
    }
    .cp-info-badge {
      display: inline-block;
      background: rgba(13,148,136,0.08);
      color: #0d9488;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 5px 14px;
      border-radius: 50px;
      margin-bottom: 12px;
    }
    .cp-info-heading {
      font-size: 2.2rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 14px;
      line-height: 1.2;
    }
    .cp-info-desc {
      font-size: 1rem;
      color: #475569;
      line-height: 1.65;
    }

    /* Contact Cards Grid */
    .cp-cards-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .cp-card {
      background: #fff;
      border: 1px solid rgba(13,148,136,0.1);
      box-shadow: 0 6px 20px -8px rgba(0,0,0,0.06);
      padding: 26px;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }
    .cp-card:hover {
      transform: translateY(-5px);
      border-color: rgba(13,148,136,0.22);
      box-shadow: 0 16px 35px -12px rgba(13,148,136,0.12);
    }
    .cp-card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(13,148,136,0.08);
      color: #0d9488;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
      transition: background 0.28s ease, color 0.28s ease;
    }
    .cp-card:hover .cp-card-icon {
      background: #0d9488;
      color: #fff;
    }
    .cp-card-title {
      font-size: 1rem;
      font-weight: 800;
      color: #020617;
      margin: 0;
    }
    .cp-card-desc {
      font-size: 0.87rem;
      color: #475569;
      line-height: 1.55;
      margin: 0;
    }
    .cp-card-link {
      font-size: 1.1rem;
      font-weight: 800;
      color: #0d9488;
      text-decoration: none;
      display: block;
    }
    .cp-card-link-sm {
      font-size: 0.9rem;
      font-weight: 700;
      color: #64748b;
      text-decoration: none;
      display: block;
    }
    .cp-card-meta {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      display: block;
    }
    .cp-card-meta-teal {
      font-size: 0.82rem;
      font-weight: 700;
      color: #0d9488;
      display: block;
    }
    .cp-card-email {
      font-size: 0.92rem;
      font-weight: 700;
      color: #0d9488;
      text-decoration: none;
    }

    /* Emergency card accent */
    .cp-card-emergency {
      border-color: rgba(220,38,38,0.14);
      background: #fffafa;
    }
    .cp-card-emergency:hover {
      border-color: rgba(220,38,38,0.28);
      box-shadow: 0 16px 35px -12px rgba(220,38,38,0.07);
    }
    .cp-card-emergency .cp-card-icon {
      background: rgba(220,38,38,0.08);
      color: #dc2626;
    }
    .cp-card-emergency:hover .cp-card-icon {
      background: #dc2626;
      color: #fff;
    }
    .cp-card-emergency .cp-card-link { color: #dc2626; }

    /* Right: Appointment Form */
    .cp-form-card {
      background: #fff;
      border: 1px solid rgba(13,148,136,0.09);
      box-shadow: 0 24px 48px -16px rgba(0,0,0,0.06);
      border-radius: 28px;
      padding: 42px;
    }
    .cp-form-head {
      margin-bottom: 28px;
    }
    .cp-form-head h3 {
      font-size: 1.45rem;
      font-weight: 800;
      color: #020617;
      margin-bottom: 8px;
    }
    .cp-form-head p {
      font-size: 0.88rem;
      color: #475569;
      line-height: 1.6;
    }
    .cp-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .cp-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .cp-field label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #0f172a;
    }
    .cp-field input,
    .cp-field select,
    .cp-field textarea {
      padding: 13px 16px;
      border: 1.5px solid #cbd5e1;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.25s ease, background 0.25s ease;
      background: #f8fafc;
      color: #0f172a;
      width: 100%;
      box-sizing: border-box;
    }
    .cp-field input:focus,
    .cp-field select:focus,
    .cp-field textarea:focus {
      border-color: #0d9488;
      background: #fff;
    }
    .cp-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .cp-submit-btn {
      width: 100%;
      background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
      color: #fff;
      border: none;
      padding: 16px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      box-shadow: 0 8px 20px -6px rgba(13,148,136,0.35);
      font-family: inherit;
      transition: transform 0.28s ease, box-shadow 0.28s ease;
      letter-spacing: 0.02em;
    }
    .cp-submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -8px rgba(13,148,136,0.45);
    }
    .cp-submit-btn i { font-size: 1.2rem; }

    /* ═══════════════════════════════════════════
       3. FAQ SECTION
    ═══════════════════════════════════════════ */
    .cp-faq-section {
      padding: 100px 5% 90px;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
    }
    .cp-section-header {
      text-align: center;
      margin-bottom: 52px;
    }
    .cp-section-badge {
      display: inline-block;
      background: rgba(13,148,136,0.08);
      color: #0d9488;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 6px 16px;
      border-radius: 50px;
      margin-bottom: 14px;
    }
    .cp-section-title {
      font-size: clamp(1.9rem, 3.5vw, 2.4rem);
      font-weight: 800;
      color: #020617;
      margin-bottom: 14px;
    }
    .cp-section-desc {
      font-size: 1.05rem;
      color: #475569;
      line-height: 1.65;
      max-width: 620px;
      margin: 0 auto;
    }

    .cp-faq-list {
      max-width: 860px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .cp-faq-item {
      background: #fff;
      border: 1px solid rgba(13,148,136,0.09);
      border-radius: 16px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.02);
      overflow: hidden;
      transition: border-color 0.28s ease, box-shadow 0.28s ease;
    }
    .cp-faq-item.active {
      border-color: rgba(13,148,136,0.22);
      box-shadow: 0 10px 28px -10px rgba(13,148,136,0.1);
    }
    .cp-faq-btn {
      width: 100%;
      padding: 22px 28px;
      background: transparent;
      border: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: background 0.2s ease;
    }
    .cp-faq-btn:hover { background: rgba(13,148,136,0.03); }
    .cp-faq-btn span {
      font-size: 1rem;
      font-weight: 800;
      color: #020617;
      line-height: 1.4;
    }
    .cp-faq-btn i {
      color: #0d9488;
      font-size: 0.9rem;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }
    .cp-faq-item.active .cp-faq-btn i { transform: rotate(180deg); }
    .cp-faq-answer {
      overflow: hidden;
      transition: max-height 0.35s ease;
    }
    .cp-faq-answer p {
      padding: 0 28px 22px;
      font-size: 0.93rem;
      line-height: 1.65;
      color: #475569;
      margin: 0;
    }

    /* ═══════════════════════════════════════════
       4. MAP SECTION
    ═══════════════════════════════════════════ */
    .cp-map-section {
      padding: 90px 5% 100px;
      background: #ffffff;
    }
    .cp-map-wrap {
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 24px 48px -16px rgba(2,6,23,0.1);
      border: 1px solid rgba(13,148,136,0.09);
    }
    .cp-map-wrap iframe { display: block; }

    /* ═══════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════ */
    @media (max-width: 1024px) {
      .cp-two-col { grid-template-columns: 1fr; gap: 52px; }
    }
    @media (max-width: 768px) {
      .cp-hero { padding: 105px 5% 80px; }
      .cp-main-section, .cp-faq-section, .cp-map-section { padding: 70px 5%; }
      .cp-cards-grid { grid-template-columns: 1fr; }
      .cp-form-card { padding: 30px 22px; }
      .cp-field-row { grid-template-columns: 1fr; gap: 20px; }
    }
  </style>

  <!-- ══════════════════════════════════════════
       1. HERO
  ══════════════════════════════════════════ -->
  <section class="cp-hero" aria-label="Contact page hero">
    <div class="cp-hero-glow" aria-hidden="true"></div>
    <div class="cp-container cp-hero-inner reveal reveal-up">
      <span class="cp-hero-badge">24/7 Medical Care Desk</span>
      <h1 class="cp-hero-title">
        Connect With Our<br />
        <span class="cp-gradient-text">Clinical Teams</span>
      </h1>
      <p class="cp-hero-sub">
        Schedule specialist visits, raise diagnostic queries, or reach our emergency trauma desk instantly.
        Serving patients across <strong>Mayiladuthurai, Sirkazhi, Karaikal, Kumbakonam</strong> and Chidambaram.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       2. CONTACT INFO + APPOINTMENT FORM
  ══════════════════════════════════════════ -->
  <section class="cp-main-section" aria-label="Contact details and appointment booking">
    <div class="cp-container cp-two-col">

      <!-- LEFT: Contact Cards -->
      <div class="reveal reveal-left">
        <div class="cp-info-header">
          <span class="cp-info-badge">Quick Contacts</span>
          <h2 class="cp-info-heading">We Are Here to Assist</h2>
          <p class="cp-info-desc">Reach our specialist desks directly or use the appointment form to book a scheduled visit.</p>
        </div>

        <div class="cp-cards-grid">
          <!-- Emergency Desk -->
          <div class="cp-card cp-card-emergency">
            <div class="cp-card-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></div>
            <h4 class="cp-card-title">Emergency Hotline (24/7)</h4>
            <p class="cp-card-desc">Immediate ambulance dispatch & critical trauma admissions.</p>
            <a href="tel:+919344644555" class="cp-card-link">+91 93446 44555</a>
            <a href="tel:+914364222555" class="cp-card-link-sm">+91 4364 222555</a>
          </div>

          <!-- OPD Timings -->
          <div class="cp-card">
            <div class="cp-card-icon"><i class="far fa-clock" aria-hidden="true"></i></div>
            <h4 class="cp-card-title">OPD Timings & Enquiries</h4>
            <p class="cp-card-desc">Specialist OPD consultations & general booking desk:</p>
            <span class="cp-card-meta">Emergency: 24 Hours / 7 Days</span>
            <span class="cp-card-meta">Specialist OPD: 09:00 AM – 08:00 PM</span>
          </div>

          <!-- Location -->
          <div class="cp-card">
            <div class="cp-card-icon"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></div>
            <h4 class="cp-card-title">Hospital Location</h4>
            <p class="cp-card-desc">Pattamangala St, Mayiladuthurai, Tamil Nadu – 609001.</p>
            <span class="cp-card-meta-teal">Near Pattamangala Temple Square</span>
          </div>

          <!-- Email -->
          <div class="cp-card">
            <div class="cp-card-icon"><i class="far fa-envelope" aria-hidden="true"></i></div>
            <h4 class="cp-card-title">Administration & Feedback</h4>
            <p class="cp-card-desc">Records requests, billing queries & corporate enquiries.</p>
            <a href="mailto:info@vairamhospital.com" class="cp-card-email">info@vairamhospital.com</a>
          </div>
        </div>
      </div>

      <!-- RIGHT: Appointment Form -->
      <div class="reveal reveal-right">
        <div class="cp-form-card">
          <div class="cp-form-head">
            <h3>Request Specialist Appointment</h3>
            <p>Select your department and preferred consulting doctor. Booking confirmation is sent via WhatsApp.</p>
          </div>

          <form class="cp-form" id="cpBookingForm" novalidate>
            <div class="cp-field">
              <label for="cpPatientName">Patient Full Name *</label>
              <input type="text" id="cpPatientName" required placeholder="e.g. Rajesh Kumar" />
            </div>

            <div class="cp-field">
              <label for="cpPatientPhone">WhatsApp Contact Number *</label>
              <input type="tel" id="cpPatientPhone" required placeholder="e.g. 93446 44555" />
            </div>

            <div class="cp-field-row">
              <div class="cp-field">
                <label for="cpDeptSelect">Specialty Department *</label>
                <select id="cpDeptSelect" required>
                  <option value="">-- Choose Department --</option>
                  {departments.map(dept => (
                    <option value={dept}>{dept}</option>
                  ))}
                </select>
              </div>
              <div class="cp-field">
                <label for="cpDoctorSelect">Consulting Doctor *</label>
                <select id="cpDoctorSelect" required disabled>
                  <option value="">-- Select Doctor --</option>
                </select>
              </div>
            </div>

            <div class="cp-field-row">
              <div class="cp-field">
                <label for="cpApptDate">Consultation Date *</label>
                <input type="date" id="cpApptDate" required />
              </div>
              <div class="cp-field">
                <label for="cpTimeSlot">Preferred Time Slot *</label>
                <select id="cpTimeSlot" required>
                  <option value="">-- Choose Slot --</option>
                  <option value="09:00 AM – 11:00 AM">09:00 AM – 11:00 AM</option>
                  <option value="11:00 AM – 01:00 PM">11:00 AM – 01:00 PM</option>
                  <option value="02:00 PM – 04:00 PM">02:00 PM – 04:00 PM</option>
                  <option value="04:00 PM – 06:00 PM">04:00 PM – 06:00 PM</option>
                </select>
              </div>
            </div>

            <div class="cp-field">
              <label for="cpNote">Brief Symptoms / Message (Optional)</label>
              <textarea id="cpNote" rows="3" placeholder="Describe your symptoms or any special requirements..."></textarea>
            </div>

            <button type="submit" class="cp-submit-btn">
              <span>Book Appointment via WhatsApp</span>
              <i class="fab fa-whatsapp" aria-hidden="true"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3. FAQ SECTION
  ══════════════════════════════════════════ -->
  <section class="cp-faq-section" aria-label="Frequently asked questions">
    <div class="cp-container">
      <div class="cp-section-header reveal reveal-up">
        <span class="cp-section-badge">Help Desk</span>
        <h2 class="cp-section-title">Appointment &amp; Travel Help</h2>
        <p class="cp-section-desc">Common answers on consultations, insurance processing, and how to reach us from nearby towns.</p>
      </div>

      <div class="cp-faq-list reveal reveal-up">
        <div class="cp-faq-item">
          <button class="cp-faq-btn" aria-expanded="false">
            <span>How do I reach the hospital from Kumbakonam or Sirkazhi?</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="cp-faq-answer" style="max-height:0">
            <p>Vairam Hospital is on Pattamangala Street in central Mayiladuthurai. Patients from Kumbakonam can take the Kumbakonam–Mayiladuthurai highway (~1 hour). From Sirkazhi, the direct highway takes approximately 35 minutes. Ample parking is available on the hospital premises.</p>
          </div>
        </div>

        <div class="cp-faq-item">
          <button class="cp-faq-btn" aria-expanded="false">
            <span>What documents should I carry for a specialist consultation?</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="cp-faq-answer" style="max-height:0">
            <p>For first-time registrations, bring a valid photo ID (Aadhaar). For second opinions, bring all previous medical files — X-rays, blood reports, ECG scans — and a list of your current medications.</p>
          </div>
        </div>

        <div class="cp-faq-item">
          <button class="cp-faq-btn" aria-expanded="false">
            <span>How do I process insurance pre-authorization for planned surgery?</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="cp-faq-answer" style="max-height:0">
            <p>We support cashless hospitalization with major health insurance networks. For planned admissions, visit our Insurance Helpdesk 48 hours in advance with your health card, physician prescription, and diagnostic reports. For emergency admissions, pre-authorization forms are completed within 24 hours of patient stabilization.</p>
          </div>
        </div>

        <div class="cp-faq-item">
          <button class="cp-faq-btn" aria-expanded="false">
            <span>Are emergency trauma facilities open on Sundays and public holidays?</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="cp-faq-answer" style="max-height:0">
            <p>Yes. Our critical care unit, trauma diagnostics (CT, radiology), laboratory testing, and pharmacy operate 24/7, including Sundays and all national public holidays.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       4. GOOGLE MAP
  ══════════════════════════════════════════ -->
  <section class="cp-map-section" aria-label="Hospital location map">
    <div class="cp-container reveal reveal-up">
      <div class="cp-map-wrap">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3916.332304388484!2d79.6548!3d11.1017!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a55212c759cd8f1%3A0xc095759a22f3fd4b!2sVairam%20Multi%20Speciality%20Hospital!5e0!3m2!1sen!2sin!4v171393498"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Vairam Multi Speciality Hospital — Mayiladuthurai Location Map"
          aria-label="Google Maps showing Vairam Hospital location in Mayiladuthurai"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- SCRIPTS -->
  <script is:inline define:vars={{ doctorsByDept }}>
    document.addEventListener("DOMContentLoaded", () => {
      const deptSel  = document.getElementById("cpDeptSelect");
      const docSel   = document.getElementById("cpDoctorSelect");
      const form     = document.getElementById("cpBookingForm");

      // Populate doctors on department change
      deptSel.addEventListener("change", () => {
        const dept = deptSel.value;
        if (!dept || !doctorsByDept[dept]) {
          docSel.innerHTML = '<option value="">-- Select Doctor --</option>';
          docSel.disabled = true;
          return;
        }
        docSel.innerHTML = '<option value="">-- Choose Doctor --</option>';
        doctorsByDept[dept].forEach(d => {
          const o = document.createElement("option");
          o.value = d.name;
          o.textContent = d.name;
          docSel.appendChild(o);
        });
        docSel.disabled = false;
      });

      // Submit → WhatsApp redirect
      form.addEventListener("submit", e => {
        e.preventDefault();
        const name   = document.getElementById("cpPatientName").value.trim();
        const phone  = document.getElementById("cpPatientPhone").value.trim();
        const dept   = deptSel.value;
        const doctor = docSel.value;
        const date   = document.getElementById("cpApptDate").value;
        const slot   = document.getElementById("cpTimeSlot").value;
        const note   = document.getElementById("cpNote").value.trim();
        const token  = "VMC-" + Math.floor(1000 + Math.random() * 9000);

        const msg = `Hello Vairam Multi Speciality Hospital,\n\nI would like to schedule a clinical appointment:\n\n- Booking Reference: ${token}\n- Patient Name: ${name}\n- Contact Phone: ${phone}\n- Department: ${dept}\n- Consulting Doctor: ${doctor}\n- Date: ${date}\n- Time Slot: ${slot}${note ? "\n- Symptoms / Notes: " + note : ""}\n\nPlease confirm slot availability. Thank you.`;

        window.open(`https://wa.me/919344644555?text=${encodeURIComponent(msg)}`, "_blank");
        form.reset();
        docSel.innerHTML = '<option value="">-- Select Doctor --</option>';
        docSel.disabled = true;
      });

      // FAQ accordion
      document.querySelector(".cp-faq-list").addEventListener("click", e => {
        const btn = e.target.closest(".cp-faq-btn");
        if (!btn) return;
        const item   = btn.parentElement;
        const answer = item.querySelector(".cp-faq-answer");
        const isOpen = item.classList.contains("active");

        document.querySelectorAll(".cp-faq-item").forEach(i => {
          i.classList.remove("active");
          i.querySelector(".cp-faq-btn").setAttribute("aria-expanded", "false");
          i.querySelector(".cp-faq-answer").style.maxHeight = "0";
        });

        if (!isOpen) {
          item.classList.add("active");
          btn.setAttribute("aria-expanded", "true");
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  </script>

</Layout>
