const amenities = [
  { icon: "fa-wifi", label: "Free Wi-Fi", desc: "High-speed internet across all wards" },
  { icon: "fa-tv", label: "Smart TV", desc: "55\" 4K entertainment in private rooms" },
  { icon: "fa-snowflake", label: "Mini Fridge", desc: "In-room refrigeration for meals & meds" },
  { icon: "fa-couch", label: "Attendant Sofa", desc: "Pull-out sofa bed for family members" },
  { icon: "fa-video", label: "CCTV Security", desc: "360° campus monitoring 24/7" },
  { icon: "fa-fire-extinguisher", label: "Fire Safety", desc: "Sprinkler & smoke detection system" },
  { icon: "fa-university", label: "ATM", desc: "On-premises cash ATM facility" },
  { icon: "fa-gift", label: "Gift Shop", desc: "Flowers, cards, and essentials store" },
  { icon: "fa-wheelchair", label: "Wheelchair Access", desc: "Ramps, lifts & mobility aids available" },
  { icon: "fa-tint", label: "Water Purifier", desc: "RO-purified water at every station" },
  { icon: "fa-leaf", label: "Garden Area", desc: "Landscaped recovery garden for patients" },
  { icon: "fa-pray", label: "Prayer Room", desc: "Multi-faith quiet meditation space" }
];

const galleryImages = [
  { src: "/images/hero-building.png", label: "Hospital Lobby", span: "tall" },
  { src: "/images/consultation.png", label: "Consultation Room", span: "" },
  { src: "/images/building-exterior.png", label: "Hospital Exterior", span: "" },
  { src: "/images/hero-building.png", label: "Reception Area", span: "wide" },
  { src: "/images/consultation.png", label: "Waiting Area", span: "" }
];

const faqs = [
  { q: "Can I visit the hospital before booking a room?", a: "Yes. We encourage prospective patients to take a guided facility tour. Contact our Patient Experience Desk at +91 93446 44555 or walk in on weekdays between 10 AM and 5 PM. Our team will show you available room categories, the ICU, and diagnostic departments." },
  { q: "What types of patient rooms are available?", a: "We offer General Ward (shared), Semi-Private (2-bed), Private Room, and Luxury Suite accommodations. Luxury Suites include a separate attendant lounge, Smart TV, mini-fridge, and dedicated nursing. Pricing varies — contact our Admissions Desk for current tariffs." },
  { q: "Is parking available for outpatient visitors?", a: "Yes. We have a 500+ vehicle multi-level parking facility with valet services. Two-wheelers have a dedicated zone. Priority bays near the main entrance are reserved for patients with mobility challenges. Parking is available 24/7." },
  { q: "Is the hospital fully wheelchair accessible?", a: "Absolutely. Vairam Hospital is designed for full universal accessibility — ramped entrances, wide-door elevators, accessible restrooms on every floor, dedicated porter service, and wheelchair loan from the main reception." },
  { q: "What infection control measures are in place?", a: "We operate under NABH infection control protocols — mandatory hand hygiene stations, restricted visitor zones during infections, HEPA-filtered OT air, sterilization audit logs, and daily biomedical waste separation. Our IPC committee reviews compliance every quarter." }
];
---

<Layout title="World-Class Hospital Facilities | Vairam Multi Speciality Hospital Mayiladuthurai">

  <!-- Facilities Structured Schema JSON-LD -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Hospital",
      "name": "Vairam Multi Speciality Hospital",
      "url": "https://vairamhospital.com/facilities",
      "telephone": "+919344644555",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pattamangala St",
        "addressLocality": "Mayiladuthurai",
        "addressRegion": "TN",
        "postalCode": "609001",
        "addressCountry": "IN"
      },
      "medicalSpecialty": [
        "Cardiology","Neurology","Orthopedics","Pediatrics","Ophthalmology","Emergency Medicine"
      ],
      "availableService": [
        {"@type": "MedicalProcedure", "name": "Operating Theater Services"},
        {"@type": "MedicalProcedure", "name": "Intensive Care Unit"},
        {"@type": "MedicalProcedure", "name": "Emergency Department"},
        {"@type": "MedicalProcedure", "name": "Radiology and Imaging"},
        {"@type": "MedicalProcedure", "name": "Diagnostic Laboratory"}
      ]
    }
  </script>

  <!-- FAQ Schema -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I visit the hospital before booking a room?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Contact our Patient Experience Desk at +91 93446 44555 or walk in on weekdays between 10 AM and 5 PM for a guided facility tour." }
        },
        {
          "@type": "Question",
          "name": "What types of patient rooms are available?",
          "acceptedAnswer": { "@type": "Answer", "text": "We offer General Ward, Semi-Private, Private Room, and Luxury Suite accommodations." }
        },
        {
          "@type": "Question",
          "name": "Is parking available for outpatient visitors?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We have a 500+ vehicle multi-level parking facility with valet services, available 24/7." }
        }
      ]
    }
  </script>

  <style is:global>
    /* ── CSS SAFETY ── */
    .fp-init { color: inherit; }

    /* ═══════════════════════════════
       UTILITIES
    ═══════════════════════════════ */
    .fp-wrap {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 28px;
      width: 100%;
    }
    .fp-section-hd {
      text-align: center;
      margin-bottom: 56px;
    }
    .fp-badge {
      display: inline-block;
      background: rgba(13,148,136,0.09);
      color: #0d9488;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 6px 18px;
      border-radius: 50px;
      margin-bottom: 14px;
    }
    .fp-title {
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 800;
      color: #020617;
      margin-bottom: 14px;
      line-height: 1.2;
    }
    .fp-desc {
      font-size: 1.05rem;
      color: #475569;
      line-height: 1.65;
      max-width: 640px;
      margin: 0 auto;
    }

    /* ═══════════════════════════════
       1. HERO
    ═══════════════════════════════ */
    .fp-hero {
      padding: 130px 5% 110px;
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      position: relative;
      overflow: hidden;
      color: #fff;
    }
    .fp-hero-glow {
      position: absolute;
      top: -20%; right: -8%;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(20,184,166,0.16) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .fp-hero-glow2 {
      position: absolute;
      bottom: -30%; left: -10%;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(56,189,248,0.1) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .fp-hero-inner {
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .fp-hero-badge {
      display: inline-block;
      background: rgba(255,255,255,0.09);
      border: 1px solid rgba(255,255,255,0.15);
      color: #14b8a6;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      padding: 8px 22px;
      border-radius: 50px;
      margin-bottom: 28px;
    }
    .fp-hero-title {
      font-size: clamp(2.5rem, 5.5vw, 4.2rem);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 24px;
    }
    .fp-hero-title .fp-grad {
      background: linear-gradient(120deg, #14b8a6 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .fp-hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.75;
      color: rgba(255,255,255,0.82);
      margin-bottom: 44px;
    }
    .fp-hero-btns {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .fp-btn-primary {
      background: linear-gradient(135deg, #0d9488, #0f766e);
      color: #fff;
      border: none;
      padding: 15px 32px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 20px -6px rgba(13,148,136,0.4);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      font-family: inherit;
    }
    .fp-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 28px -8px rgba(13,148,136,0.5); }
    .fp-btn-outline {
      background: rgba(255,255,255,0.08);
      color: #fff;
      border: 1.5px solid rgba(255,255,255,0.3);
      padding: 15px 32px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s ease;
      font-family: inherit;
    }
    .fp-btn-outline:hover { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.5); transform: translateY(-2px); }

    /* ═══════════════════════════════
       2. STATS BAR
    ═══════════════════════════════ */
    .fp-stats-bar {
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      position: sticky;
      top: 72px;
      z-index: 90;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }
    .fp-stats-inner {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      divide-x: 1px solid #e2e8f0;
    }
    .fp-stat-item {
      padding: 22px 28px;
      text-align: center;
      border-right: 1px solid #f1f5f9;
      transition: background 0.2s;
    }
    .fp-stat-item:last-child { border-right: none; }
    .fp-stat-item:hover { background: rgba(13,148,136,0.03); }
    .fp-stat-num {
      font-size: 2rem;
      font-weight: 900;
      color: #0d9488;
      line-height: 1;
      margin-bottom: 4px;
      display: block;
    }
    .fp-stat-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ═══════════════════════════════
       3. FILTER TABS
    ═══════════════════════════════ */
    .fp-filter-section {
      padding: 80px 5% 0;
      background: #f8fafc;
    }
    .fp-filter-tabs {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 50px;
    }
    .fp-tab-btn {
      padding: 10px 22px;
      border-radius: 50px;
      border: 1.5px solid #e2e8f0;
      background: #fff;
      color: #475569;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      font-family: inherit;
    }
    .fp-tab-btn:hover { border-color: #0d9488; color: #0d9488; background: rgba(13,148,136,0.04); }
    .fp-tab-btn.active { background: #0d9488; color: #fff; border-color: #0d9488; box-shadow: 0 4px 12px -3px rgba(13,148,136,0.4); }

    /* ═══════════════════════════════
       4. FACILITIES GRID
    ═══════════════════════════════ */
    .fp-grid-section {
      padding: 0 5% 90px;
      background: #f8fafc;
    }
    .fp-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
    .fp-facility-card {
      background: #fff;
      border-radius: 22px;
      border: 1px solid rgba(13,148,136,0.08);
      box-shadow: 0 6px 20px -8px rgba(0,0,0,0.06);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      cursor: pointer;
    }
    .fp-facility-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px -12px rgba(13,148,136,0.15);
    }
    .fp-facility-card.hidden { display: none; }
    .fp-card-img-wrap {
      position: relative;
      height: 200px;
      background: linear-gradient(135deg, #0f172a 0%, #134e4a 100%);
      overflow: hidden;
      flex-shrink: 0;
    }
    .fp-card-img-wrap img {
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.55;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }
    .fp-facility-card:hover .fp-card-img-wrap img {
      transform: scale(1.06);
      opacity: 0.7;
    }
    .fp-card-cat-badge {
      position: absolute;
      top: 16px; left: 16px;
      background: rgba(13,148,136,0.9);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 5px 12px;
      border-radius: 50px;
    }
    .fp-card-icon-wrap {
      position: absolute;
      bottom: 16px; right: 16px;
      width: 44px; height: 44px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(8px);
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.2);
      display: flex; align-items: center; justify-content: center;
      color: #fff;
      font-size: 1.2rem;
    }
    .fp-card-overlay {
      position: absolute;
      inset: 0;
      background: rgba(13,148,136,0.85);
      display: flex; align-items: center; justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .fp-facility-card:hover .fp-card-overlay { opacity: 1; }
    .fp-overlay-btn {
      background: #fff;
      color: #0d9488;
      border: none;
      padding: 12px 26px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 0.9rem;
      cursor: pointer;
      font-family: inherit;
      display: flex; align-items: center; gap: 8px;
      transform: translateY(10px);
      transition: transform 0.3s ease;
    }
    .fp-facility-card:hover .fp-overlay-btn { transform: translateY(0); }
    .fp-card-body {
      padding: 26px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }
    .fp-card-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: #020617;
      margin: 0;
      line-height: 1.3;
    }
    .fp-card-desc {
      font-size: 0.88rem;
      color: #475569;
      line-height: 1.6;
      margin: 0;
    }
    .fp-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .fp-card-tag {
      background: rgba(13,148,136,0.07);
      color: #0d9488;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 50px;
    }
    .fp-card-view-btn {
      background: transparent;
      border: 1.5px solid #e2e8f0;
      color: #475569;
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      font-family: inherit;
      display: flex; align-items: center; gap: 8px;
      transition: all 0.25s ease;
      width: fit-content;
      margin-top: auto;
    }
    .fp-card-view-btn:hover { border-color: #0d9488; color: #0d9488; background: rgba(13,148,136,0.04); }

    /* Empty state */
    .fp-empty-state {
      display: none;
      text-align: center;
      padding: 80px 20px;
      grid-column: 1 / -1;
    }
    .fp-empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 16px; }
    .fp-empty-state p { color: #94a3b8; font-size: 1rem; }

    /* ═══════════════════════════════
       5. PATIENT AMENITIES
    ═══════════════════════════════ */
    .fp-amenities-section {
      padding: 100px 5%;
      background: #ffffff;
      border-top: 1px solid #f1f5f9;
    }
    .fp-amenities-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
    }
    .fp-amenity-card {
      background: #f8fafc;
      border: 1px solid rgba(13,148,136,0.08);
      border-radius: 18px;
      padding: 24px 16px;
      text-align: center;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      transition: all 0.28s ease;
    }
    .fp-amenity-card:hover {
      background: #fff;
      border-color: rgba(13,148,136,0.2);
      transform: translateY(-4px);
      box-shadow: 0 12px 28px -8px rgba(13,148,136,0.1);
    }
    .fp-amenity-icon {
      width: 52px; height: 52px;
      background: rgba(13,148,136,0.08);
      color: #0d9488;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem;
      transition: all 0.28s ease;
    }
    .fp-amenity-card:hover .fp-amenity-icon { background: #0d9488; color: #fff; }
    .fp-amenity-name {
      font-size: 0.88rem;
      font-weight: 800;
      color: #020617;
      margin: 0;
    }
    .fp-amenity-desc {
      font-size: 0.78rem;
      color: #64748b;
      line-height: 1.4;
      margin: 0;
    }

    /* ═══════════════════════════════
       6. GALLERY
    ═══════════════════════════════ */
    .fp-gallery-section {
      padding: 100px 5%;
      background: #f8fafc;
    }
    .fp-gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 18px;
    }
    .fp-gal-item {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      cursor: pointer;
      background: #020617;
      min-height: 240px;
    }
    .fp-gal-item.fp-tall { grid-row: span 2; min-height: 500px; }
    .fp-gal-item.fp-wide { grid-column: span 2; }
    .fp-gal-item img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease, opacity 0.5s ease;
      opacity: 0.8;
    }
    .fp-gal-item:hover img { transform: scale(1.07); opacity: 0.6; }
    .fp-gal-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(2,6,23,0.8) 0%, transparent 60%);
      display: flex; flex-direction: column;
      justify-content: flex-end; align-items: flex-start;
      padding: 22px;
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }
    .fp-gal-item:hover .fp-gal-overlay { opacity: 1; }
    .fp-gal-label {
      color: #fff;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .fp-gal-zoom {
      position: absolute; top: 16px; right: 16px;
      width: 38px; height: 38px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(6px);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 0.9rem;
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform: scale(0.8);
    }
    .fp-gal-item:hover .fp-gal-zoom { opacity: 1; transform: scale(1); }

    /* ═══════════════════════════════
       7. VIRTUAL TOUR CTA
    ═══════════════════════════════ */
    .fp-tour-section {
      padding: 100px 5%;
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      position: relative;
      overflow: hidden;
    }
    .fp-tour-glow {
      position: absolute; top: -20%; right: -5%;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(20,184,166,0.15) 0%, transparent 70%);
      border-radius: 50%; pointer-events: none;
    }
    .fp-tour-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .fp-tour-text h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      color: #fff;
      margin-bottom: 18px;
      line-height: 1.2;
    }
    .fp-tour-text h2 span {
      background: linear-gradient(120deg, #14b8a6 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .fp-tour-text p {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.7;
      margin-bottom: 34px;
    }
    .fp-tour-btns {
      display: flex; gap: 14px; flex-wrap: wrap;
    }
    .fp-tour-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 34px;
    }
    .fp-tour-stat {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 18px 20px;
      display: flex; align-items: center; gap: 14px;
    }
    .fp-tour-stat i { font-size: 1.4rem; color: #14b8a6; }
    .fp-tour-stat-num { font-size: 1.3rem; font-weight: 800; color: #fff; }
    .fp-tour-stat-lbl { font-size: 0.8rem; color: rgba(255,255,255,0.6); font-weight: 600; }
    .fp-tour-video {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      aspect-ratio: 16/10;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(10px);
    }
    .fp-tour-video img {
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.4;
      position: absolute; inset: 0;
    }
    .fp-play-btn {
      position: relative; z-index: 1;
      width: 72px; height: 72px;
      background: rgba(13,148,136,0.9);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      border: none;
      transition: all 0.3s ease;
      box-shadow: 0 0 0 0 rgba(13,148,136,0.4);
      animation: fp-pulse 2.5s infinite;
    }
    .fp-play-btn:hover { background: #0d9488; transform: scale(1.08); }
    .fp-play-btn i { color: #fff; font-size: 1.4rem; margin-left: 4px; }
    @keyframes fp-pulse {
      0% { box-shadow: 0 0 0 0 rgba(13,148,136,0.4); }
      70% { box-shadow: 0 0 0 20px rgba(13,148,136,0); }
      100% { box-shadow: 0 0 0 0 rgba(13,148,136,0); }
    }

    /* ═══════════════════════════════
       8. SAFETY & QUALITY
    ═══════════════════════════════ */
    .fp-safety-section {
      padding: 100px 5%;
      background: #fff;
    }
    .fp-safety-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .fp-safety-img {
      border-radius: 28px;
      overflow: hidden;
      position: relative;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, #0f172a, #134e4a);
    }
    .fp-safety-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.7;
    }
    .fp-safety-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(2,6,23,0.6) 0%, transparent 60%);
    }
    .fp-safety-badge-float {
      position: absolute;
      bottom: 24px; left: 24px;
      background: rgba(13,148,136,0.9);
      backdrop-filter: blur(8px);
      border-radius: 14px;
      padding: 14px 20px;
      color: #fff;
    }
    .fp-safety-badge-float .num { font-size: 1.8rem; font-weight: 900; line-height: 1; }
    .fp-safety-badge-float .lbl { font-size: 0.78rem; color: rgba(255,255,255,0.8); font-weight: 600; }
    .fp-safety-content h2 {
      font-size: clamp(1.9rem, 3.5vw, 2.5rem);
      font-weight: 800;
      color: #020617;
      margin-bottom: 16px;
      line-height: 1.2;
    }
    .fp-safety-content p {
      font-size: 1rem;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 36px;
    }
    .fp-safety-feats {
      display: flex; flex-direction: column; gap: 20px;
    }
    .fp-safety-feat {
      display: flex;
      gap: 18px;
      align-items: flex-start;
      padding: 20px 24px;
      background: #f8fafc;
      border-radius: 16px;
      border: 1px solid rgba(13,148,136,0.08);
      transition: all 0.28s ease;
    }
    .fp-safety-feat:hover { background: #fff; border-color: rgba(13,148,136,0.2); transform: translateX(4px); box-shadow: 0 8px 20px -8px rgba(13,148,136,0.1); }
    .fp-feat-icon {
      width: 44px; height: 44px;
      background: rgba(13,148,136,0.08);
      color: #0d9488;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
      transition: all 0.28s ease;
    }
    .fp-safety-feat:hover .fp-feat-icon { background: #0d9488; color: #fff; }
    .fp-feat-text h4 { font-size: 1rem; font-weight: 800; color: #020617; margin-bottom: 4px; }
    .fp-feat-text p { font-size: 0.86rem; color: #475569; line-height: 1.5; margin: 0; }

    /* ═══════════════════════════════
       9. FAQ SECTION
    ═══════════════════════════════ */
    .fp-faq-section {
      padding: 100px 5%;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
    }
    .fp-faq-list {
      max-width: 860px;
      margin: 0 auto;
      display: flex; flex-direction: column; gap: 14px;
    }
    .fp-faq-item {
      background: #fff;
      border: 1px solid rgba(13,148,136,0.09);
      border-radius: 16px;
      overflow: hidden;
      transition: border-color 0.28s, box-shadow 0.28s;
    }
    .fp-faq-item.active {
      border-color: rgba(13,148,136,0.22);
      box-shadow: 0 10px 28px -10px rgba(13,148,136,0.1);
    }
    .fp-faq-btn {
      width: 100%;
      padding: 22px 28px;
      background: transparent;
      border: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
    }
    .fp-faq-btn:hover { background: rgba(13,148,136,0.02); }
    .fp-faq-btn span { font-size: 1rem; font-weight: 800; color: #020617; line-height: 1.4; }
    .fp-faq-btn i { color: #0d9488; font-size: 0.9rem; transition: transform 0.3s; flex-shrink: 0; }
    .fp-faq-item.active .fp-faq-btn i { transform: rotate(180deg); }
    .fp-faq-answer {
      overflow: hidden;
      transition: max-height 0.35s ease;
    }
    .fp-faq-answer p {
      padding: 0 28px 22px;
      font-size: 0.93rem;
      line-height: 1.65;
      color: #475569;
      margin: 0;
    }

    /* ═══════════════════════════════
       MODALS
    ═══════════════════════════════ */
    .fp-modal {
      display: none;
      position: fixed; inset: 0;
      z-index: 9000;
      background: rgba(2,6,23,0.75);
      backdrop-filter: blur(8px);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .fp-modal.active { display: flex; }
    .fp-modal-card {
      background: #fff;
      border-radius: 28px;
      width: 100%;
      max-width: 760px;
      max-height: 88vh;
      overflow-y: auto;
      position: relative;
      animation: fp-slide-up 0.3s ease;
    }
    @keyframes fp-slide-up {
      from { transform: translateY(30px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .fp-modal-img {
      width: 100%; height: 260px;
      object-fit: cover;
      border-radius: 28px 28px 0 0;
    }
    .fp-modal-body { padding: 36px; }
    .fp-modal-cat {
      display: inline-block;
      background: rgba(13,148,136,0.09);
      color: #0d9488;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 5px 14px;
      border-radius: 50px;
      margin-bottom: 14px;
    }
    .fp-modal-title { font-size: 1.7rem; font-weight: 800; color: #020617; margin-bottom: 12px; }
    .fp-modal-desc { font-size: 0.95rem; color: #475569; line-height: 1.65; margin-bottom: 26px; }
    .fp-modal-section-title { font-size: 1rem; font-weight: 800; color: #020617; margin-bottom: 14px; }
    .fp-modal-feats {
      display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px;
    }
    .fp-modal-feat {
      display: flex; align-items: center; gap: 10px;
      font-size: 0.9rem; color: #334155; font-weight: 500;
    }
    .fp-modal-feat i { color: #0d9488; font-size: 0.85rem; }
    .fp-modal-procs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
    .fp-modal-proc {
      background: #f1f5f9;
      color: #334155;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 50px;
    }
    .fp-modal-why {
      background: rgba(13,148,136,0.06);
      border-left: 3px solid #0d9488;
      border-radius: 0 12px 12px 0;
      padding: 16px 20px;
      margin-bottom: 28px;
      font-size: 0.9rem;
      color: #1e293b;
      line-height: 1.6;
    }
    .fp-modal-close {
      position: absolute; top: 18px; right: 18px;
      width: 38px; height: 38px;
      background: rgba(255,255,255,0.9);
      border: none;
      border-radius: 50%;
      cursor: pointer;
      font-size: 1.1rem;
      color: #475569;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .fp-modal-close:hover { background: #fff; color: #dc2626; }
    .fp-modal-book-btn {
      width: 100%;
      background: linear-gradient(135deg, #0d9488, #0f766e);
      color: #fff;
      border: none;
      padding: 15px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      font-family: inherit;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      box-shadow: 0 8px 20px -6px rgba(13,148,136,0.35);
      transition: all 0.25s ease;
    }
    .fp-modal-book-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 28px -8px rgba(13,148,136,0.45); }

    /* Gallery lightbox */
    .fp-lightbox {
      display: none;
      position: fixed; inset: 0;
      z-index: 9999;
      background: rgba(2,6,23,0.95);
      align-items: center; justify-content: center;
    }
    .fp-lightbox.active { display: flex; }
    .fp-lightbox img {
      max-width: 90vw; max-height: 85vh;
      border-radius: 16px;
      object-fit: contain;
    }
    .fp-lb-close {
      position: absolute; top: 20px; right: 28px;
      color: #fff; font-size: 2rem; cursor: pointer;
      background: none; border: none;
      transition: color 0.2s;
    }
    .fp-lb-close:hover { color: #14b8a6; }
    .fp-lb-caption {
      position: absolute; bottom: 30px;
      color: #94a3b8; font-size: 1rem; font-weight: 600; text-align: center;
      width: 100%;
    }

    /* ═══════════════════════════════
       RESPONSIVE
    ═══════════════════════════════ */
    @media (max-width: 1200px) {
      .fp-amenities-grid { grid-template-columns: repeat(4, 1fr); }
      .fp-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 1024px) {
      .fp-tour-inner { grid-template-columns: 1fr; gap: 50px; }
      .fp-safety-inner { grid-template-columns: 1fr; gap: 50px; }
      .fp-gallery-grid { grid-template-columns: repeat(2, 1fr); }
      .fp-gal-item.fp-tall { grid-row: span 1; }
      .fp-gal-item.fp-wide { grid-column: span 2; }
    }
    @media (max-width: 768px) {
      .fp-hero { padding: 110px 5% 80px; }
      .fp-stats-inner { grid-template-columns: repeat(2, 1fr); }
      .fp-grid { grid-template-columns: 1fr; }
      .fp-amenities-grid { grid-template-columns: repeat(3, 1fr); }
      .fp-gallery-grid { grid-template-columns: 1fr; }
      .fp-gal-item.fp-wide { grid-column: span 1; }
      .fp-filter-section, .fp-grid-section, .fp-amenities-section,
      .fp-gallery-section, .fp-tour-section, .fp-safety-section, .fp-faq-section {
        padding: 70px 5%;
      }
    }
    @media (max-width: 480px) {
      .fp-amenities-grid { grid-template-columns: repeat(2, 1fr); }
      .fp-stats-inner { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <!-- ════════════════════════════════════════
       1. HERO
  ════════════════════════════════════════ -->
  <section class="fp-hero" aria-label="Facilities hero">
    <div class="fp-hero-glow" aria-hidden="true"></div>
    <div class="fp-hero-glow2" aria-hidden="true"></div>
    <div class="fp-wrap fp-hero-inner reveal reveal-up">
      <span class="fp-hero-badge">World-Class Medical Infrastructure</span>
      <h1 class="fp-hero-title">
        Facilities Built for<br />
        <span class="fp-grad">Clinical Excellence</span>
      </h1>
      <p class="fp-hero-sub">
        Explore Vairam Multi Speciality Hospital's advanced clinical infrastructure — 12 operating theaters, 50-bed ICU, 3T MRI, Level II trauma center, and premium patient amenities — serving Mayiladuthurai, Sirkazhi, Karaikal, Kumbakonam, and Chidambaram.
      </p>
      <div class="fp-hero-btns">
        <button class="fp-btn-primary" id="fpStartTourBtn">
          <i class="fas fa-play-circle" aria-hidden="true"></i>
          Take a Virtual Tour
        </button>
        <a href="/contact" class="fp-btn-outline">
          <i class="fas fa-calendar-check" aria-hidden="true"></i>
          Book a Visit
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       2. STICKY STATS BAR
  ════════════════════════════════════════ -->
  <div class="fp-stats-bar" aria-label="Key statistics">
    <div class="fp-wrap fp-stats-inner">
      <div class="fp-stat-item">
        <span class="fp-stat-num">500+</span>
        <span class="fp-stat-label">Hospital Beds</span>
      </div>
      <div class="fp-stat-item">
        <span class="fp-stat-num">12</span>
        <span class="fp-stat-label">Operation Theaters</span>
      </div>
      <div class="fp-stat-item">
        <span class="fp-stat-num">24/7</span>
        <span class="fp-stat-label">Emergency Care</span>
      </div>
      <div class="fp-stat-item">
        <span class="fp-stat-num">50+</span>
        <span class="fp-stat-label">Specialized Units</span>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════
       3. FILTER TABS + FACILITIES GRID
  ════════════════════════════════════════ -->
  <section class="fp-filter-section" aria-label="Facilities filter">
    <div class="fp-wrap">
      <div class="fp-section-hd reveal reveal-up">
        <span class="fp-badge">Our Facilities</span>
        <h2 class="fp-title">Advanced Clinical Infrastructure</h2>
        <p class="fp-desc">Browse our full range of specialized medical facilities — designed to deliver diagnostic precision, surgical excellence, and compassionate patient care.</p>
      </div>
      <div class="fp-filter-tabs" role="tablist" aria-label="Filter by category">
        <button class="fp-tab-btn active" data-filter="all" role="tab" aria-selected="true">All Facilities</button>
        <button class="fp-tab-btn" data-filter="clinical" role="tab" aria-selected="false">Clinical</button>
        <button class="fp-tab-btn" data-filter="diagnostic" role="tab" aria-selected="false">Diagnostic</button>
        <button class="fp-tab-btn" data-filter="critical" role="tab" aria-selected="false">Critical Care</button>
        <button class="fp-tab-btn" data-filter="support" role="tab" aria-selected="false">Support Services</button>
        <button class="fp-tab-btn" data-filter="amenity" role="tab" aria-selected="false">Patient Amenities</button>
      </div>
    </div>
  </section>

  <section class="fp-grid-section" aria-label="Facilities grid">
    <div class="fp-wrap">
      <div class="fp-grid" id="fpFacilitiesGrid">
        {facilitiesData.map(f => (
          <article
            class="fp-facility-card reveal reveal-up"
            data-category={f.category}
            data-id={f.id}
            role="button"
            tabindex="0"
            aria-label={`View ${f.name} details`}
          >
            <div class="fp-card-img-wrap">
              <img src="/images/hero-building.png" alt={f.name} loading="lazy" />
              <span class="fp-card-cat-badge">{f.categoryLabel}</span>
              <div class="fp-card-icon-wrap"><i class={`fas ${f.icon}`} aria-hidden="true"></i></div>
              <div class="fp-card-overlay">
                <button class="fp-overlay-btn fp-open-detail-btn" data-id={f.id}>
                  <i class="fas fa-expand-alt" aria-hidden="true"></i>
                  View Details
                </button>
              </div>
            </div>
            <div class="fp-card-body">
              <h3 class="fp-card-name">{f.name}</h3>
              <p class="fp-card-desc">{f.shortDesc}</p>
              <div class="fp-card-tags">
                {f.tags.map(t => <span class="fp-card-tag">{t}</span>)}
              </div>
              <button class="fp-card-view-btn fp-open-detail-btn" data-id={f.id}>
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                View Details
              </button>
            </div>
          </article>
        ))}
        <div class="fp-empty-state" id="fpEmptyState">
          <i class="fas fa-search" aria-hidden="true"></i>
          <p>No facilities found in this category.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       4. PATIENT AMENITIES
  ════════════════════════════════════════ -->
  <section class="fp-amenities-section" aria-label="Patient amenities">
    <div class="fp-wrap">
      <div class="fp-section-hd reveal reveal-up">
        <span class="fp-badge">Patient Comfort</span>
        <h2 class="fp-title">Hotel-Grade Patient Amenities</h2>
        <p class="fp-desc">Every element of your stay is designed for comfort and peace of mind — from smart entertainment to security systems.</p>
      </div>
      <div class="fp-amenities-grid">
        {amenities.map((a, i) => (
          <div class="fp-amenity-card reveal reveal-up" style={`transition-delay: ${i * 0.05}s`}>
            <div class="fp-amenity-icon"><i class={`fas ${a.icon}`} aria-hidden="true"></i></div>
            <p class="fp-amenity-name">{a.label}</p>
            <p class="fp-amenity-desc">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       5. GALLERY
  ════════════════════════════════════════ -->
  <section class="fp-gallery-section" aria-label="Hospital gallery">
    <div class="fp-wrap">
      <div class="fp-section-hd reveal reveal-up">
        <span class="fp-badge">Visual Tour</span>
        <h2 class="fp-title">Inside Vairam Hospital</h2>
        <p class="fp-desc">A glimpse of our world-class clinical environment — designed for healing, dignity, and professional excellence.</p>
      </div>
      <div class="fp-gallery-grid reveal reveal-up">
        {galleryImages.map((img, i) => (
          <div
            class={`fp-gal-item ${img.span === 'tall' ? 'fp-tall' : ''} ${img.span === 'wide' ? 'fp-wide' : ''}`}
            data-src={img.src}
            data-label={img.label}
            role="button"
            tabindex="0"
            aria-label={`View ${img.label}`}
          >
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="fp-gal-overlay">
              <span class="fp-gal-label">{img.label}</span>
            </div>
            <div class="fp-gal-zoom"><i class="fas fa-expand" aria-hidden="true"></i></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       6. VIRTUAL TOUR CTA
  ════════════════════════════════════════ -->
  <section class="fp-tour-section" aria-label="Virtual tour call to action">
    <div class="fp-tour-glow" aria-hidden="true"></div>
    <div class="fp-wrap fp-tour-inner">
      <div class="fp-tour-text reveal reveal-left">
        <h2>Take a <span>Virtual Tour</span></h2>
        <p>Explore Vairam Hospital from the comfort of your home. Our 360° immersive virtual tour covers 20+ locations including our operation theaters, ICU, maternity ward, diagnostic center, and patient lounges.</p>
        <div class="fp-tour-btns">
          <button class="fp-btn-primary" id="fpVirtualTourBtn">
            <i class="fas fa-vr-cardboard" aria-hidden="true"></i>
            Start Virtual Tour
          </button>
          <a href="/contact" class="fp-btn-outline">
            <i class="fas fa-calendar-alt" aria-hidden="true"></i>
            Schedule In-Person Visit
          </a>
        </div>
        <div class="fp-tour-stats">
          <div class="fp-tour-stat">
            <i class="fas fa-street-view" aria-hidden="true"></i>
            <div>
              <div class="fp-tour-stat-num">360°</div>
              <div class="fp-tour-stat-lbl">Immersive Views</div>
            </div>
          </div>
          <div class="fp-tour-stat">
            <i class="fas fa-film" aria-hidden="true"></i>
            <div>
              <div class="fp-tour-stat-num">HD</div>
              <div class="fp-tour-stat-lbl">Video Quality</div>
            </div>
          </div>
          <div class="fp-tour-stat">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <div>
              <div class="fp-tour-stat-num">20+</div>
              <div class="fp-tour-stat-lbl">Locations</div>
            </div>
          </div>
          <div class="fp-tour-stat">
            <i class="fas fa-lock-open" aria-hidden="true"></i>
            <div>
              <div class="fp-tour-stat-num">Free</div>
              <div class="fp-tour-stat-lbl">No Registration</div>
            </div>
          </div>
        </div>
      </div>
      <div class="fp-tour-video reveal reveal-right">
        <img src="/images/hero-building.png" alt="Hospital virtual tour preview" />
        <button class="fp-play-btn" id="fpPlayTourBtn" aria-label="Play virtual tour video">
          <i class="fas fa-play" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       7. SAFETY & QUALITY
  ════════════════════════════════════════ -->
  <section class="fp-safety-section" aria-label="Safety and quality standards">
    <div class="fp-wrap fp-safety-inner">
      <div class="fp-safety-img reveal reveal-left">
        <img src="/images/hero-building.png" alt="Hospital safety standards" />
        <div class="fp-safety-overlay" aria-hidden="true"></div>
        <div class="fp-safety-badge-float" aria-label="NABH accredited">
          <div class="num">NABH</div>
          <div class="lbl">Accredited Hospital</div>
        </div>
      </div>
      <div class="fp-safety-content reveal reveal-right">
        <span class="fp-badge">Standards & Protocols</span>
        <h2>Safety & Quality at Every Level</h2>
        <p>Vairam Hospital operates under NABH and ISO 9001 certified quality management systems. Every clinical process — from sterilization to medication dispensing — follows verified international standards.</p>
        <div class="fp-safety-feats">
          <div class="fp-safety-feat">
            <div class="fp-feat-icon"><i class="fas fa-shield-virus" aria-hidden="true"></i></div>
            <div class="fp-feat-text">
              <h4>Infection Control Protocols</h4>
              <p>NABH-compliant IPC committee, HEPA-filtered OT airflows, and antimicrobial surface protocols.</p>
            </div>
          </div>
          <div class="fp-safety-feat">
            <div class="fp-feat-icon"><i class="fas fa-fire-alt" aria-hidden="true"></i></div>
            <div class="fp-feat-text">
              <h4>Fire Safety Systems</h4>
              <p>Smoke detectors, sprinkler networks, auto fire doors, and quarterly fire evacuation drills.</p>
            </div>
          </div>
          <div class="fp-safety-feat">
            <div class="fp-feat-icon"><i class="fas fa-recycle" aria-hidden="true"></i></div>
            <div class="fp-feat-text">
              <h4>Biomedical Waste Management</h4>
              <p>Colour-coded segregation, licensed biomedical waste contractor, and PCB-compliant disposal records.</p>
            </div>
          </div>
          <div class="fp-safety-feat">
            <div class="fp-feat-icon"><i class="fas fa-bolt" aria-hidden="true"></i></div>
            <div class="fp-feat-text">
              <h4>100% Power Backup</h4>
              <p>Diesel generators and UPS systems ensure uninterrupted power for OTs, ICU, and life support systems.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       8. FAQ SECTION
  ════════════════════════════════════════ -->
  <section class="fp-faq-section" aria-label="Frequently asked questions">
    <div class="fp-wrap">
      <div class="fp-section-hd reveal reveal-up">
        <span class="fp-badge">Common Questions</span>
        <h2 class="fp-title">Facilities FAQ</h2>
        <p class="fp-desc">Everything you need to know before your visit to Vairam Multi Speciality Hospital.</p>
      </div>
      <div class="fp-faq-list reveal reveal-up">
        {faqs.map((faq, i) => (
          <div class="fp-faq-item">
            <button class="fp-faq-btn" aria-expanded="false">
              <span>{faq.q}</span>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="fp-faq-answer" style="max-height:0">
              <p>{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       FACILITY DETAIL MODAL
  ════════════════════════════════════════ -->
  <div class="fp-modal" id="fpDetailModal" role="dialog" aria-modal="true" aria-labelledby="fpModalTitle">
    <div class="fp-modal-card">
      <img src="/images/hero-building.png" alt="" class="fp-modal-img" id="fpModalImg" />
      <button class="fp-modal-close" id="fpModalCloseBtn" aria-label="Close modal">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
      <div class="fp-modal-body">
        <span class="fp-modal-cat" id="fpModalCat">Clinical</span>
        <h2 class="fp-modal-title" id="fpModalTitle">Facility Name</h2>
        <p class="fp-modal-desc" id="fpModalDesc">Description</p>
        <h3 class="fp-modal-section-title">Key Features</h3>
        <div class="fp-modal-feats" id="fpModalFeats"></div>
        <div id="fpModalProcsWrap">
          <h3 class="fp-modal-section-title">Common Procedures</h3>
          <div class="fp-modal-procs" id="fpModalProcs"></div>
        </div>
        <div class="fp-modal-why" id="fpModalWhy"></div>
        <button class="fp-modal-book-btn" id="fpModalBookBtn">
          <i class="fab fa-whatsapp" aria-hidden="true"></i>
          Book Appointment for This Facility
        </button>
      </div>
    </div>
  </div>

  <!-- VIRTUAL TOUR MODAL -->
  <div class="fp-modal" id="fpTourModal" role="dialog" aria-modal="true" aria-label="Virtual tour">
    <div class="fp-modal-card" style="max-width:900px; overflow:hidden;">
      <button class="fp-modal-close" id="fpTourCloseBtn" aria-label="Close virtual tour">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
      <div style="background:#020617; padding: 60px 40px; text-align:center; color:#fff;">
        <i class="fas fa-vr-cardboard" style="font-size:4rem; color:#14b8a6; margin-bottom:20px; display:block;" aria-hidden="true"></i>
        <h2 style="font-size:2rem; font-weight:800; margin-bottom:14px;">360° Virtual Tour</h2>
        <p style="color:rgba(255,255,255,0.75); font-size:1rem; margin-bottom:28px;">Our interactive virtual tour is launching soon. In the meantime, schedule an in-person facility tour with our Patient Experience Team.</p>
        <a href="/contact" class="fp-btn-primary" style="display:inline-flex; margin: 0 auto;">
          <i class="fas fa-calendar-check" aria-hidden="true"></i>
          Schedule In-Person Visit
        </a>
      </div>
    </div>
  </div>

  <!-- GALLERY LIGHTBOX -->
  <div class="fp-lightbox" id="fpLightbox" role="dialog" aria-modal="true" aria-label="Image lightbox">
    <button class="fp-lb-close" id="fpLbClose" aria-label="Close lightbox">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
    <img src="" alt="" id="fpLbImg" />
    <div class="fp-lb-caption" id="fpLbCaption"></div>
  </div>

  <!-- SCRIPTS -->
  <script is:inline define:vars={{ facilitiesData }}>
    document.addEventListener("DOMContentLoaded", () => {

      // ─── Filter Tabs ───
      const tabBtns = document.querySelectorAll(".fp-tab-btn");
      const cards   = document.querySelectorAll(".fp-facility-card");
      const emptyEl = document.getElementById("fpEmptyState");

      function runFilter(filter) {
        let visible = 0;
        cards.forEach(card => {
          const match = filter === "all" || card.dataset.category === filter;
          if (match) { card.classList.remove("hidden"); visible++; }
          else        { card.classList.add("hidden"); }
        });
        emptyEl.style.display = visible === 0 ? "block" : "none";
      }

      tabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          tabBtns.forEach(b => { b.classList.remove("active"); b.setAttribute("aria-selected","false"); });
          btn.classList.add("active");
          btn.setAttribute("aria-selected","true");
          runFilter(btn.dataset.filter);
        });
      });

      // ─── Facility Detail Modal ───
      const detailModal   = document.getElementById("fpDetailModal");
      const modalCloseBtn = document.getElementById("fpModalCloseBtn");
      const modalBookBtn  = document.getElementById("fpModalBookBtn");
      let activeModalFacility = null;

      function openDetail(id) {
        const f = facilitiesData.find(x => x.id === id);
        if (!f) return;
        activeModalFacility = f;

        document.getElementById("fpModalCat").textContent   = f.categoryLabel;
        document.getElementById("fpModalTitle").textContent = f.name;
        document.getElementById("fpModalDesc").textContent  = f.shortDesc;
        document.getElementById("fpModalWhy").textContent   = f.whyUs;

        const featsEl = document.getElementById("fpModalFeats");
        featsEl.innerHTML = f.features.map(ft =>
          `<div class="fp-modal-feat"><i class="fas fa-check-circle"></i><span>${ft}</span></div>`
        ).join("");

        const procsWrap = document.getElementById("fpModalProcsWrap");
        const procsEl   = document.getElementById("fpModalProcs");
        if (f.procedures && f.procedures.length > 0) {
          procsEl.innerHTML = f.procedures.map(p => `<span class="fp-modal-proc">${p}</span>`).join("");
          procsWrap.style.display = "block";
        } else {
          procsWrap.style.display = "none";
        }

        detailModal.classList.add("active");
        document.body.style.overflow = "hidden";
      }

      function closeDetail() {
        detailModal.classList.remove("active");
        document.body.style.overflow = "";
        activeModalFacility = null;
      }

      document.querySelectorAll(".fp-open-detail-btn").forEach(btn => {
        btn.addEventListener("click", e => { e.stopPropagation(); openDetail(btn.dataset.id); });
      });
      cards.forEach(card => {
        card.addEventListener("click", () => openDetail(card.dataset.id));
        card.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") openDetail(card.dataset.id); });
      });

      modalCloseBtn.addEventListener("click", closeDetail);
      detailModal.addEventListener("click", e => { if (e.target === detailModal) closeDetail(); });

      modalBookBtn.addEventListener("click", () => {
        if (!activeModalFacility) return;
        const msg = `Hello Vairam Hospital, I would like to book an appointment related to your ${activeModalFacility.name} facility. Please confirm availability.`;
        window.open(`https://wa.me/919344644555?text=${encodeURIComponent(msg)}`, "_blank");
      });

      // ─── Virtual Tour Modal ───
      const tourModal    = document.getElementById("fpTourModal");
      const tourCloseBtn = document.getElementById("fpTourCloseBtn");

      function openTour() { tourModal.classList.add("active"); document.body.style.overflow = "hidden"; }
      function closeTour() { tourModal.classList.remove("active"); document.body.style.overflow = ""; }

      document.getElementById("fpStartTourBtn").addEventListener("click", openTour);
      document.getElementById("fpVirtualTourBtn").addEventListener("click", openTour);
      document.getElementById("fpPlayTourBtn").addEventListener("click", openTour);
      tourCloseBtn.addEventListener("click", closeTour);
      tourModal.addEventListener("click", e => { if (e.target === tourModal) closeTour(); });

      // ─── Gallery Lightbox ───
      const lightbox  = document.getElementById("fpLightbox");
      const lbImg     = document.getElementById("fpLbImg");
      const lbCaption = document.getElementById("fpLbCaption");
      const lbClose   = document.getElementById("fpLbClose");

      document.querySelectorAll(".fp-gal-item").forEach(item => {
        item.addEventListener("click", () => {
          lbImg.src = item.dataset.src;
          lbImg.alt = item.dataset.label;
          lbCaption.textContent = item.dataset.label;
          lightbox.classList.add("active");
          document.body.style.overflow = "hidden";
        });
        item.addEventListener("keydown", e => {
          if (e.key === "Enter") item.click();
        });
      });

      lbClose.addEventListener("click", () => { lightbox.classList.remove("active"); document.body.style.overflow = ""; });
      lightbox.addEventListener("click", e => { if (e.target === lightbox || e.target === lbImg) { lightbox.classList.remove("active"); document.body.style.overflow = ""; } });

      // ─── FAQ Accordion ───
      document.querySelector(".fp-faq-list").addEventListener("click", e => {
        const btn = e.target.closest(".fp-faq-btn");
        if (!btn) return;
        const item   = btn.parentElement;
        const answer = item.querySelector(".fp-faq-answer");
        const isOpen = item.classList.contains("active");

        document.querySelectorAll(".fp-faq-item").forEach(i => {
          i.classList.remove("active");
          i.querySelector(".fp-faq-btn").setAttribute("aria-expanded","false");
          i.querySelector(".fp-faq-answer").style.maxHeight = "0";
        });

        if (!isOpen) {
          item.classList.add("active");
          btn.setAttribute("aria-expanded","true");
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });

      // ─── Escape key closes all modals ───
      document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
          closeDetail(); closeTour();
          lightbox.classList.remove("active");
          document.body.style.overflow = "";
        }
      });
    });
  </script>

</Layout>
