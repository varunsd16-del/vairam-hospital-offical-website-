      }
      .timeline-line {
        left: 20px;
      }
      .timeline-dot {
        left: 20px;
      }
      .timeline-item {
        flex-direction: row !important;
        margin-bottom: 40px;
      }
      .timeline-content {
        width: calc(100% - 60px);
        margin-left: 50px;
      }
    }

    @media (max-width: 576px) {
      .form-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .cta-actions {
        flex-direction: column;
        width: 100%;
