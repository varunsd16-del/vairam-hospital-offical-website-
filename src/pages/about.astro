---
import Layout from '../layouts/Layout.astro';

// AEO/GEO/SEO high-intent regional keywords:
// "best multi speciality hospital in Mayiladuthurai", "top doctor specialists in Mayiladuthurai",
// "cardiologist in Mayiladuthurai", "orthopedic doctor Sirkazhi", "best gynecologist Karaikal", "Chidambaram health clinic"
---

<Layout title="About Us | Vairam Multi Speciality Hospital Mayiladuthurai">

  <!-- Structured schema metadata for local search indexing & answer engine optimization -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "@id": "https://vairamhospital.com/about#hospital",
      "name": "Vairam Multi Speciality Hospital",
      "description": "Vairam Multi Speciality Hospital in Mayiladuthurai offers advanced 24/7 emergency care, cardiology, orthopaedics, and multi-speciality medical services.",
      "url": "https://vairamhospital.com/about",
      "logo": "https://vairamhospital.com/images/Logo.png",
      "foundingDate": "2010",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pattamangala St",
        "addressLocality": "Mayiladuthurai",
        "addressRegion": "TN",
        "postalCode": "609001",
        "addressCountry": "IN"
      },
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "Mayiladuthurai"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Sirkazhi"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Karaikal"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Kumbakonam"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Chidambaram"
        }
      ],
      "knowsAbout": [
        "Cardiology",
        "Orthopedics",
        "Neurology",
        "Pediatrics",
        "General Medicine",
        "Emergency Care"
      ]
    }
  </script>

  <!-- 1. PAGE HEADER / HERO SECTION -->
  <section class="about-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-container text-center reveal reveal-up">
      <span class="hero-badge">Clinical Excellence Standards</span>
      <h1 class="hero-title">About Vairam Hospital <br /><span class="text-primary">MediCare Plus Care Standards</span></h1>
      <p class="hero-subtitle">
        Pioneering advanced diagnostic treatments, state-of-the-art modular surgeries, and compassionate healthcare in Mayiladuthurai and surrounding regions since 2010.
      </p>
    </div>
  </section>

  <!-- 2. MISSION & VISION / OUR STORY -->
  <section class="story-section">
    <div class="container story-grid">
      <!-- Left Column: Hospital visual -->
      <div class="story-visual reveal reveal-left">
        <div class="img-wrapper">
          <img src="/images/building-exterior.png" alt="Vairam Multi Speciality Hospital Building in Mayiladuthurai" class="story-img" />
          <div class="visual-tag-badge">
            <span class="badge-num">15+</span>
            <span class="badge-lbl">Years of Trusted Care</span>
          </div>
        </div>
      </div>
      
      <!-- Right Column: Content -->
      <div class="story-content reveal reveal-right">
        <span class="section-badge">Our Journey & Foundation</span>
        <h2 class="section-title">Your Trusted Healthcare Partner in Mayiladuthurai</h2>
        <p class="section-desc">
          Vairam Multi Speciality Hospital was established in 2010 to fill the gap for world-class, affordable clinical treatments in Mayiladuthurai, Sirkazhi, Karaikal, and Kumbakonam. Our facility houses advanced diagnostic labs and modern cleanroom operation theatres managed by the best doctor specialists.
        </p>
        <p class="section-desc">
          We combine cutting-edge medical technologies with personalized attention to ensure every patient experiences a warm, recovery-focused journey.
        </p>

        <!-- Mission & Vision cards nested inside story -->
        <div class="mv-cards-wrapper">
          <div class="mv-card">
            <div class="mv-icon"><i class="fas fa-eye"></i></div>
            <div class="mv-info">
              <h3>Our Vision</h3>
              <p>To be the leading, most trusted clinical provider in Tamil Nadu known for clinical excellence, ethics, and patient success rates.</p>
            </div>
          </div>
          <div class="mv-card">
            <div class="mv-icon"><i class="fas fa-bullseye"></i></div>
            <div class="mv-info">
              <h3>Our Mission</h3>
              <p>To deliver advanced diagnostic treatment and emergency medical services using state-of-the-art technologies with warmth, honesty, and integrity.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. STATS COUNTER -->
  <section class="stats-section">
    <div class="container stats-grid">
      <div class="stat-item reveal reveal-up" style="transition-delay: 0s;">
        <div class="stat-icon"><i class="fas fa-hospital-user"></i></div>
        <span class="stat-num reveal" data-target="15">15+</span>
        <span class="stat-label">Years of Excellence</span>
      </div>
      <div class="stat-item reveal reveal-up" style="transition-delay: 0.1s;">
        <div class="stat-icon"><i class="fas fa-user-md"></i></div>
        <span class="stat-num reveal" data-target="50">50+</span>
        <span class="stat-label">Expert Doctors & Specialists</span>
      </div>
      <div class="stat-item reveal reveal-up" style="transition-delay: 0.2s;">
        <div class="stat-icon"><i class="fas fa-heartbeat"></i></div>
        <span class="stat-num reveal" data-target="10000">10000+</span>
        <span class="stat-label">Happy Patient Recoveries</span>
      </div>
      <div class="stat-item reveal reveal-up" style="transition-delay: 0.3s;">
        <div class="stat-icon"><i class="fas fa-award"></i></div>
        <span class="stat-num reveal" data-target="25">25+</span>
        <span class="stat-label">Clinical & Quality Awards</span>
      </div>
    </div>
  </section>

  <!-- 4. CORE VALUES -->
  <section class="values-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Core Pillars</span>
        <h2 class="section-title">The Values That Drive Us</h2>
        <p class="section-desc">Our commitment to patient-centric treatment is built upon four fundamental principles.</p>
      </div>

      <div class="values-grid">
        <!-- Value 1: Compassion -->
        <div class="value-card reveal reveal-up" style="transition-delay: 0s;">
          <div class="value-icon"><i class="fas fa-hand-holding-heart"></i></div>
          <h3>Compassion</h3>
          <p>Treating every patient with dignity, warmth, and active empathy. We ensure a stress-free environment for families and patients.</p>
          <div class="card-line"></div>
        </div>
        <!-- Value 2: Excellence -->
        <div class="value-card reveal reveal-up" style="transition-delay: 0.1s;">
          <div class="value-icon"><i class="fas fa-medal"></i></div>
          <h3>Excellence</h3>
          <p>Adhering to strict international clinical protocols, high success rates, and continuous training programs for our staff.</p>
          <div class="card-line"></div>
        </div>
        <!-- Value 3: Innovation -->
        <div class="value-card reveal reveal-up" style="transition-delay: 0.2s;">
          <div class="value-icon"><i class="fas fa-lightbulb"></i></div>
          <h3>Innovation</h3>
          <p>Equipping our operation theaters, trauma labs, and cardiology departments with state-of-the-art modern tools and methods.</p>
          <div class="card-line"></div>
        </div>
        <!-- Value 4: Integrity -->
        <div class="value-card reveal reveal-up" style="transition-delay: 0.3s;">
          <div class="value-icon"><i class="fas fa-shield-alt"></i></div>
          <h3>Integrity</h3>
          <p>Maintaining absolute transparency in billing, diagnostics, medical ethics, and cashless corporate policy administration.</p>
          <div class="card-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. TIMELINE / MILESTONES -->
  <section class="timeline-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Our Milestones</span>
        <h2 class="section-title">Historical Journey & Growth</h2>
        <p class="section-desc">From our humble beginnings to a leading multi-speciality medical centre in Tamil Nadu.</p>
      </div>

      <div class="timeline-wrapper">
        <!-- Line background -->
        <div class="timeline-line"></div>

        <!-- Milestone 1 -->
        <div class="timeline-item reveal reveal-left">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-year">2010</span>
            <h3>Foundation & Launch</h3>
            <p>Vairam Hospital opens its doors in Mayiladuthurai with comprehensive general medicine and diagnostic laboratory capacities.</p>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="timeline-item reveal reveal-right">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-year">2015</span>
            <h3>Cardiology & Trauma Care Additions</h3>
            <p>Inaugurated the 24/7 Emergency & ICU Trauma unit, alongside custom senior cardiologist consulting lines for cardiac recovery.</p>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="timeline-item reveal reveal-left">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-year">2020</span>
            <h3>Advanced Modular Operation Theatres</h3>
            <p>Upgraded surgical infrastructure to modular cleanroom standards, adding arthroscopic orthopedic surgery suites and neurology critical care blocks.</p>
          </div>
        </div>

        <!-- Milestone 4 -->
        <div class="timeline-item reveal reveal-right">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-year">2026</span>
            <h3>Digital Health Integration</h3>
            <p>Launched digital health checkups, corporate wellness integrations, and our online patient booking engine to serve Kumbakonam, Sirkazhi, and Karaikal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. LEADERSHIP TEAM -->
  <section class="leadership-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Leadership</span>
        <h2 class="section-title">Board of Directors & Management</h2>
        <p class="section-desc">Our hospital operations are guided by experienced clinical administrators and healthcare pioneers.</p>
      </div>

      <div class="leadership-grid">
        <!-- CEO -->
        <article class="leader-card reveal reveal-up" style="transition-delay: 0s;">
          <div class="leader-image">
            <img src="/images/consultation.png" alt="Dr. R. Vairamohan, CEO of Vairam Multi Speciality Hospital" />
            <div class="leader-overlay-role">CEO</div>
          </div>
          <div class="leader-info text-center">
            <h3>Dr. R. Vairamohan</h3>
            <span class="leader-title">Founder & Chief Executive Officer</span>
            <p class="leader-desc">Visionary surgeon with over 25 years of experience, steering Vairam Hospital's clinical standards and community outreach projects.</p>
          </div>
        </article>

        <!-- CMO -->
        <article class="leader-card reveal reveal-up" style="transition-delay: 0.15s;">
          <div class="leader-image">
            <img src="/images/consultation.png" alt="Dr. A. Rajesh, Chief Medical Officer at Vairam Hospital" />
            <div class="leader-overlay-role">CMO</div>
          </div>
          <div class="leader-info text-center">
            <h3>Dr. A. Rajesh</h3>
            <span class="leader-title">Chief Medical Officer & Senior Cardiologist</span>
            <p class="leader-desc">Oversees medical operations, diagnostic ethics, physician quality compliance, and interventional cardiac treatments.</p>
          </div>
        </article>

        <!-- COO -->
        <article class="leader-card reveal reveal-up" style="transition-delay: 0.3s;">
          <div class="leader-image">
            <img src="/images/consultation.png" alt="Mrs. V. Meenakshi, Chief Operating Officer at Vairam Hospital" />
            <div class="leader-overlay-role">COO</div>
          </div>
          <div class="leader-info text-center">
            <h3>Mrs. V. Meenakshi</h3>
            <span class="leader-title">Chief Operating Officer</span>
            <p class="leader-desc">Directs cashless corporate partnerships, public health insurance networks, patient hospitality, and facility operations.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 7. ACCREDITATIONS & PARTNERSHIPS -->
  <section class="accreditations-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Certifications</span>
        <h2 class="section-title">Accreditations & Partnerships</h2>
        <p class="section-desc">We align with strict quality standards to ensure safe, ethical, and high-quality medical operations.</p>
      </div>

      <div class="accreditations-grid">
        <div class="accred-item reveal reveal-up" style="transition-delay: 0s;">
          <div class="accred-icon"><i class="fas fa-shield-alt"></i></div>
          <h4>JCI Standards</h4>
          <p>Joint Commission International aligned clinical safety protocols.</p>
        </div>
        <div class="accred-item reveal reveal-up" style="transition-delay: 0.1s;">
          <div class="accred-icon"><i class="fas fa-check-double"></i></div>
          <h4>ISO 9001:2015</h4>
          <p>Certified medical facility management quality standards.</p>
        </div>
        <div class="accred-item reveal reveal-up" style="transition-delay: 0.2s;">
          <div class="accred-icon"><i class="fas fa-hand-holding-heart"></i></div>
          <h4>AHA Partner</h4>
          <p>American Heart Association compliant training and guidelines.</p>
        </div>
        <div class="accred-item reveal reveal-up" style="transition-delay: 0.3s;">
          <div class="accred-icon"><i class="fas fa-heartbeat"></i></div>
          <h4>CMS Quality</h4>
          <p>Adhering to national clinical safety and hospital metrics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CTA SECTION -->
  <section class="cta-section">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="container cta-container text-center reveal reveal-up">
      <h2 class="cta-title">Prioritize Your Health with Mayiladuthurai's Best Doctors</h2>
      <p class="cta-desc">
        Connect with our specialist teams today. We provide 24/7 trauma response, cashless corporate treatments, and executive medical checks.
      </p>
      <div class="cta-actions">
        <button id="openBookingBtn" class="btn-primary-blue-large">
          <i class="far fa-calendar-check"></i> Book Appointment Now
        </button>
        <a href="/contact" class="btn-outline-white-large">
          Contact Support <i class="fas fa-phone-alt"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. APPOINTMENT BOOKING MODAL -->
  <div class="booking-modal-overlay" id="appointmentModal" aria-hidden="true" role="dialog">
    <div class="booking-modal-card">
      <header class="modal-card-header">
        <h3><i class="far fa-calendar-check"></i> Book Medical Appointment</h3>
        <button class="close-modal-btn" id="closeBookingBtn" aria-label="Close booking modal"><i class="fas fa-times"></i></button>
      </header>
      
      <form class="modal-booking-form" id="aboutPageBookingForm">
        <div class="form-group">
          <label for="modalPatientName">Patient Full Name *</label>
          <input type="text" id="modalPatientName" required placeholder="e.g. Rajesh Kumar" />
        </div>
        
        <div class="form-group">
          <label for="modalPatientPhone">Mobile Number *</label>
          <input type="tel" id="modalPatientPhone" required placeholder="e.g. 93446 44555" pattern="[0-9\s+-]{10,15}" />
        </div>
        
        <div class="form-grid">
          <div class="form-group">
            <label for="modalSpeciality">Select Specialty *</label>
            <select id="modalSpeciality" required>
              <option value="">-- Choose Department --</option>
              <option value="Cardiology">Cardiology</option>
              <option value="Orthopaedics">Orthopaedics</option>
              <option value="Neurology">Neurology</option>
              <option value="Paediatrics">Paediatrics</option>
              <option value="General Medicine">General Medicine</option>
            </select>
          </div>
          
          <div class="form-group">
            <label for="modalBookingDate">Appointment Date *</label>
            <input type="date" id="modalBookingDate" required />
          </div>
        </div>

        <div class="form-group">
          <label for="modalTimeSlot">Preferred Time Slot *</label>
          <select id="modalTimeSlot" required>
            <option value="">-- Select Time Slot --</option>
            <option value="09:00 AM">09:00 AM - 11:00 AM</option>
            <option value="11:00 AM">11:00 AM - 01:00 PM</option>
            <option value="02:00 PM">02:00 PM - 04:00 PM</option>
            <option value="04:00 PM">04:00 PM - 06:00 PM</option>
          </select>
        </div>

        <button type="submit" class="submit-modal-btn">Confirm Schedule Booking</button>
      </form>
    </div>
  </div>

  <style>
    /* CSS Parser Safety */
    .styles-init-safety-check {
      color: inherit;
    }

    /* Hero styling */
    .about-hero {
      padding: 120px 5% 100px;
      background: #020617; /* Solid color fallback */
      background: linear-gradient(135deg, #020617 0%, #0f766e 100%);
      position: relative;
      overflow: hidden;
      color: #ffffff;
    }

    .hero-glow {
      position: absolute;
      top: -20%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero-container {
      max-width: 900px;
      margin: 0 auto;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #14b8a6; /* explicit primary-light hex */
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      padding: 8px 20px;
      border-radius: 50px;
      margin-bottom: 25px;
    }

    .hero-title {
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 25px;
      color: #ffffff; /* explicit white heading */
    }

    .hero-title .text-primary {
      background: linear-gradient(120deg, #14b8a6 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.85); /* explicit white subtitle */
      font-weight: 400;
    }

    /* Story Section */
    .story-section {
      padding: 100px 5%;
      background: var(--white);
    }

    .story-grid {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 80px;
      align-items: center;
    }

    .story-visual {
      position: relative;
    }

    .story-visual .img-wrapper {
      position: relative;
      padding: 20px;
      max-width: 500px;
      margin: 0 auto;
    }

    .story-img {
      width: 100%;
      border-radius: 32px;
      box-shadow: var(--shadow-premium);
      border: 6px solid white;
      display: block;
    }

    .visual-tag-badge {
      position: absolute;
      bottom: -15px;
      right: 0px;
      background: var(--primary);
      color: white;
      padding: 25px 30px;
      border-radius: 24px;
      box-shadow: 0 20px 40px -10px rgba(13, 148, 136, 0.4);
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: float 4s ease-in-out infinite;
      z-index: 5;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .badge-num {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1;
    }

    .badge-lbl {
      font-size: 0.8rem;
      font-weight: 600;
      opacity: 0.95;
      text-align: center;
      margin-top: 4px;
    }

    .section-badge {
      color: var(--primary-dark);
      font-size: 0.9rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 18px;
      display: inline-block;
      position: relative;
      padding-left: 24px;
    }

    .section-badge::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 14px;
      height: 3px;
      background: var(--primary);
      border-radius: 2px;
    }

    .section-title {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      font-weight: 800;
      line-height: 1.2;
      color: var(--secondary);
      margin-bottom: 25px;
      letter-spacing: -0.02em;
    }

    .section-desc {
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--text-muted);
      margin-bottom: 25px;
    }

    /* Mission Vision cards nested styling */
    .mv-cards-wrapper {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 35px;
    }

    .mv-card {
      display: flex;
      gap: 20px;
      background: #f4fbfc;
      border: 1px solid rgba(13, 148, 136, 0.06);
      padding: 24px;
      border-radius: 20px;
      transition: var(--transition);
    }

    .mv-card:hover {
      background: white;
      border-color: rgba(13, 148, 136, 0.2);
      transform: translateY(-3px);
      box-shadow: var(--shadow-premium);
    }

    .mv-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      background: rgba(13, 148, 136, 0.08);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
      transition: var(--transition);
    }

    .mv-card:hover .mv-icon {
      background: var(--primary);
      color: white;
    }

    .mv-info h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--secondary);
      margin-bottom: 8px;
    }

    .mv-info p {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--text-muted);
      margin-bottom: 0;
    }

    /* 3. STATS SECTION */
    .stats-section {
      padding: 80px 5%;
      background: linear-gradient(180deg, #f0fbfc 0%, var(--white) 100%);
      position: relative;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 40px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: white;
      padding: 40px 30px;
      border-radius: 24px;
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(13, 148, 136, 0.05);
      transition: var(--transition);
    }

    .stat-item:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-premium);
      border-color: rgba(13, 148, 136, 0.2);
    }

    .stat-icon {
      width: 60px;
      height: 60px;
      border-radius: 18px;
      background: rgba(13, 148, 136, 0.08);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 20px;
      transition: var(--transition);
    }

    .stat-item:hover .stat-icon {
      background: var(--primary);
      color: white;
      transform: scale(1.05);
    }

    .stat-num {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--secondary);
      line-height: 1.1;
      margin-bottom: 8px;
    }

    .stat-num.reveal {
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .stat-num.reveal.active {
      opacity: 1;
    }

    .stat-label {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* 4. CORE VALUES SECTION */
    .values-section {
      padding: 100px 5% 80px;
      background: var(--white);
    }

    .section-header {
      max-width: 800px;
      margin: 0 auto 60px;
