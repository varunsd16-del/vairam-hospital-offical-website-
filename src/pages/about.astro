  </style>

  <!-- Interactive script for modal handles & booking submissions -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const openModalBtn = document.getElementById("openBookingBtn");
      const closeModalBtn = document.getElementById("closeBookingBtn");
      const modalOverlay = document.getElementById("appointmentModal");
      const form = document.getElementById("aboutPageBookingForm");

      // Open Modal
      openModalBtn?.addEventListener("click", () => {
        if (modalOverlay) {
          modalOverlay.classList.add("active");
          modalOverlay.setAttribute("aria-hidden", "false");
          
          // Disable background scroll
          document.body.style.overflow = "hidden";
          
          // Setup default date to tomorrow
          const dateInput = document.getElementById("modalBookingDate") as HTMLInputElement | null;
          if (dateInput) {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            dateInput.min = new Date().toISOString().split("T")[0];
            dateInput.value = tomorrow.toISOString().split("T")[0];
          }
        }
      });

      // Close Modal Function
      const closeModal = () => {
        if (modalOverlay) {
          modalOverlay.classList.remove("active");
          modalOverlay.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      };

      closeModalBtn?.addEventListener("click", closeModal);
      
      // Close on clicking overlay background
      modalOverlay?.addEventListener("click", (e) => {
        if (e.target === modalOverlay) {
          closeModal();
        }
      });

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modalOverlay?.classList.contains("active")) {
          closeModal();
        }
      });

      // Form Submit trigger to WhatsApp
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const name = (document.getElementById("modalPatientName") as HTMLInputElement | null)?.value || "";
        const phone = (document.getElementById("modalPatientPhone") as HTMLInputElement | null)?.value || "";
        const dept = (document.getElementById("modalSpeciality") as HTMLSelectElement | null)?.value || "";
        const date = (document.getElementById("modalBookingDate") as HTMLInputElement | null)?.value || "";
        const slot = (document.getElementById("modalTimeSlot") as HTMLSelectElement | null)?.value || "";

        if (!name || !phone || !dept || !date || !slot) {
          alert("Please fill in all required fields.");
          return;
        }

        const token = "VAH-AB-" + Math.floor(1000 + Math.random() * 9000);
        const whatsappMsg = `*Appointment Request - Vairam Hospital*\n\n*Token:* ${token}\n*Patient:* ${name}\n*Dept:* ${dept}\n*Schedule:* ${date} at ${slot}\n*Phone:* ${phone}\n*Origin:* About Page Modal`;
        const encodedMsg = encodeURIComponent(whatsappMsg);
        const whatsappLink = `https://wa.me/919344644555?text=${encodedMsg}`;

        // Close modal & open WhatsApp link
        closeModal();
        alert(`Booking request generated! Token: ${token}. Redirecting to WhatsApp for final confirmation.`);
        window.open(whatsappLink, "_blank");
      });
    });
  </script>
