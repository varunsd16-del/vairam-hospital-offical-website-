      border: none;
      padding: 14px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: var(--transition);
      margin-top: 10px;
      box-shadow: 0 8px 16px -4px rgba(13, 148, 136, 0.3);
    }

    .submit-modal-btn:hover {
      background: var(--primary-dark);
      box-shadow: 0 12px 24px -6px rgba(13, 148, 136, 0.4);
    }

    /* Responsive layouts */
    @media (max-width: 1024px) {
      .story-grid {
        gap: 40px;
      }
    }

    @media (max-width: 991px) {
      .about-hero {
        padding: 100px 5% 80px;
      }
      .story-section, .values-section, .timeline-section, .leadership-section, .accreditations-section, .cta-section {
        padding: 80px 5%;
      }
      .story-grid {
        grid-template-columns: 1fr;
        gap: 50px;
      }
      .story-visual .img-wrapper {
