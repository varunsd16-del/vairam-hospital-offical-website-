---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import QuickAccess from "../components/home/QuickAccess.astro";
import Specialities from "../components/home/Specialities.astro";
import EmergencyBand from "../components/home/EmergencyBand.astro";
import WhyVairam from "../components/home/WhyVairam.astro";
import DoctorsPreview from "../components/DoctorsPreview.astro";
import PatientJourney from "../components/home/PatientJourney.astro";
import Testimonials from "../components/Testimonials.astro";
import VisitUs from "../components/home/VisitUs.astro";
import FeatureBand from "../components/ui/FeatureBand.astro";
---

<Layout
  title="Vairam Multi Speciality Hospital, Mayiladuthurai | 24/7 Emergency & Specialist Care"
  description="Multi speciality hospital in Mayiladuthurai with 24/7 emergency and ICU, cardiology, orthopaedics, neurology, paediatrics, diagnostics and experienced specialist doctors. Book an appointment online."
>
  <Hero />
  <QuickAccess />
  <Specialities />
  <EmergencyBand />
  <WhyVairam />
  <DoctorsPreview />
  <PatientJourney />
  <FeatureBand
    eyebrow="Your health, our responsibility"
    title="Care that puts you and your family first"
    text="From the first phone call to your final follow-up, every step at Vairam is designed around comfort, clarity and safety."
    items={[
      { icon: "heart", title: "Patient-first care", text: "Doctors who listen, explain clearly and involve your family in every decision." },
      { icon: "wallet", title: "Transparent billing", text: "Written estimates before planned treatment, with no surprises at discharge." },
      { icon: "shield", title: "Cashless insurance", text: "Help with pre-authorisation from major insurers, TPAs and eligible government schemes." },
      { icon: "file-text", title: "Follow-up that continues", text: "Clear discharge summaries, reminders and reports shared on WhatsApp." },
    ]}
    cta={{ label: "Book an appointment", action: "book" }}
  />
  <Testimonials />
  <VisitUs />
</Layout>
