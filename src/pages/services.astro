const categories = [
  { filter: "all", label: "All Services" },
  { filter: "specialty-care", label: "Specialty Care" },
  { filter: "diagnostic", label: "Diagnostic" },
  { filter: "surgical", label: "Surgical" },
  { filter: "wellness", label: "Wellness" }
];

const faqs = [
  {
    q: "Which insurance plans and cashless policies do you accept?",
    a: "Vairam Hospital is partnered with all major private insurance providers, corporate third-party administrators (TPAs), and state/central government employee health insurance schemes. Please contact our corporate insurance desk for pre-authorization details."
  },
  {
    q: "How can I schedule an appointment with a specialist?",
    a: "You can book easily by clicking the 'Book Appointment' button on this page, which will open our scheduler. Alternatively, you can directly message us on WhatsApp at +91 93446 44555, or call our 24/7 helpdesk lines."
  },
  {
    q: "What documents should I bring to my first appointment?",
    a: "For your first consultation, please bring any previous medical files, prescription charts, diagnostic scans (X-rays, MRIs, lab reports), a valid national photo ID card (like Aadhaar), and your health insurance/corporate scheme cards if applicable."
  },
  {
    q: "Do you provide online or telemedicine consultations?",
    a: "Yes! We offer virtual telemedicine sessions via secure video calls for follow-ups, general medicine consulting, and review of lab reports. You can coordinate scheduling with our appointment desk online."
  },
  {
    q: "What are the operational hours for emergency and diagnostic scan services?",
    a: "Our Emergency & Trauma Ward, Ambulance Service, ICU, and emergency diagnostic scans operate 24 hours a day, 7 days a week. Regular outpatient consults and routine laboratory scans are open Monday to Sunday, from 8:00 AM to 9:00 PM."
  }
];
---

<Layout title="Medical Services | Vairam Multi Speciality Hospital Mayiladuthurai">
  
  <!-- Structured Data JSON-LD for AEO/GEO/SEO -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Vairam Multi Speciality Hospital",
      "description": "Vairam Multi Speciality Hospital offers high-intent diagnostics, cardiology, orthopaedics, and surgery services in Mayiladuthurai, Sirkazhi, Karaikal, and Kumbakonam.",
      "url": "https://vairamhospital.com/services",
      "logo": "https://vairamhospital.com/images/Logo.png",
      "telephone": "+919344644555",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pattamangala St",
        "addressLocality": "Mayiladuthurai",
        "addressRegion": "TN",
        "postalCode": "609001",
        "addressCountry": "IN"
      },
      "areaServed": ["Mayiladuthurai", "Sirkazhi", "Karaikal", "Kumbakonam", "Chidambaram"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Clinical Medical Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "MedicalService",
              "name": "Cardiology & Heart Care",
              "description": "Advanced cardiology, Echocardiogram, Angiogram, and Cath Lab services."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "MedicalService",
              "name": "Orthopedics & Joint Replacement",
              "description": "Knee replacement, trauma fracture clinic, and modular operation theaters."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "MedicalService",
              "name": "Emergency & Trauma Care",
              "description": "24/7 critical trauma care ward and advanced life support ambulance services."
            }
          }
        ]
      }
    }
  </script>

  <!-- 1. HERO SECTION -->
  <section class="services-hero">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="container hero-content text-center reveal reveal-up">
      <span class="hero-badge">Clinical Excellence Standards</span>
      <h1 class="hero-title">Our Medical Services & <br /><span class="text-gradient">Specialist Treatment Centers</span></h1>
      <p class="hero-subtitle">
        Providing modern diagnostic scans, modular cleanroom surgeries, and 24/7 emergency response. Serving families across Mayiladuthurai, Sirkazhi, Karaikal, and Kumbakonam with premium medical ethics since 2010.
      </p>
      
      <!-- Search Input Integration -->
      <div class="search-bar-wrapper">
        <i class="fas fa-search search-icon"></i>
        <input 
          type="text" 
          id="servicesSearchInput" 
          placeholder="Search for specialty treatments, scans, doctors, or symptoms..." 
          aria-label="Search clinical services"
        />
        <button id="searchClearBtn" class="search-clear-btn" aria-label="Clear search input">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- 2. FILTER TABS & SERVICE GRID -->
  <section class="services-grid-section">
    <div class="container">
      
      <!-- Category Tabs -->
      <div class="category-tabs reveal reveal-up">
        {categories.map((c, i) => (
          <button 
            class={`tab-btn ${i === 0 ? 'active' : ''}`} 
            data-filter={c.filter}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {c.label}
          </button>
        ))}
      </div>

      <!-- Live Search/Filter Status Message -->
      <div class="filter-status-box" id="filterStatusBox" style="display: none;">
        <p><i class="fas fa-info-circle"></i> Showing results matching "<span id="statusQueryText"></span>". <button id="resetFiltersLink">Reset filters</button></p>
      </div>

      <!-- Services Grid -->
      <div class="services-grid" id="servicesGrid">
        {servicesData.map((s, i) => (
          <article 
            class="service-card reveal reveal-up" 
            data-category={s.category}
            data-keywords={s.keywords}
            data-title={s.name.toLowerCase()}
            data-desc={s.desc.toLowerCase()}
            id={`card-${s.id}`}
            style={`transition-delay: ${(i % 3) * 0.1}s`}
          >
            <div class="card-image-box">
              <img src={s.image} alt={`${s.name} at Vairam Hospital Mayiladuthurai`} class="card-img" />
              <div class="card-badge">
                {s.category.replace('-', ' ')}
              </div>
            </div>
            
            <div class="card-body">
              <div class="card-icon-box">
                <i class={`fas ${s.icon}`}></i>
              </div>
              <h3 class="card-title">{s.name}</h3>
              <p class="card-subtitle">{s.sub}</p>
              <p class="card-desc">{s.desc}</p>
              
              <div class="card-divider"></div>
              
              <ul class="card-features">
                {s.features.slice(0, 3).map((f) => (
                  <li>
                    <i class="fas fa-check-circle"></i>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <button 
                class="learn-more-btn" 
                data-id={s.id}
                aria-label={`Learn more about ${s.name}`}
              >
                Learn More <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div class="empty-state-container" id="emptyState" style="display: none;">
        <div class="empty-state-icon">
          <i class="fas fa-folder-open"></i>
        </div>
        <h3>No Services Found</h3>
        <p>We couldn't find any medical service matching your query. Try searching for symptoms or other department names.</p>
        <button class="btn-primary" id="emptyStateResetBtn">View All Services</button>
      </div>

    </div>
  </section>

  <!-- 3. HOW OUR SERVICES WORK (4-Step Timeline) -->
  <section class="workflow-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">Patient Journey</span>
        <h2 class="section-title">How Our Services Work</h2>
        <p class="section-desc">We structure our medical services to guarantee seamless patient access, precision diagnostics, and recovery timelines.</p>
      </div>

      <div class="workflow-timeline">
        <div class="timeline-bar" aria-hidden="true"></div>
        
        <!-- Step 1 -->
        <div class="workflow-step reveal reveal-up" style="transition-delay: 0s;">
          <div class="step-num">01</div>
          <div class="step-icon-wrapper">
            <i class="far fa-calendar-check"></i>
          </div>
          <h3>Book Appointment</h3>
          <p>Request schedules online, via WhatsApp link redirection, or direct call checkups.</p>
        </div>

        <!-- Step 2 -->
        <div class="workflow-step reveal reveal-up" style="transition-delay: 0.15s;">
          <div class="step-num">02</div>
          <div class="step-icon-wrapper">
            <i class="fas fa-user-md"></i>
          </div>
          <h3>Consultation</h3>
          <p>Meet our leading doctor specialists for comprehensive assessments in Mayiladuthurai.</p>
        </div>

        <!-- Step 3 -->
        <div class="workflow-step reveal reveal-up" style="transition-delay: 0.3s;">
          <div class="step-num">03</div>
          <div class="step-icon-wrapper">
            <i class="fas fa-file-invoice-dollar"></i>
          </div>
          <h3>Diagnosis</h3>
          <p>Receive high-precision diagnostic scanning and clinical blood profile analytics.</p>
        </div>

        <!-- Step 4 -->
        <div class="workflow-step reveal reveal-up" style="transition-delay: 0.45s;">
          <div class="step-num">04</div>
          <div class="step-icon-wrapper">
            <i class="fas fa-heartbeat"></i>
          </div>
          <h3>Treatment</h3>
          <p>Receive modular cleanroom surgeries, post-surgical ICU supervision, and rehabilitation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FAQ ACCORDION SECTION -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header text-center reveal reveal-up">
        <span class="section-badge">FAQ</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">Got questions about scheduling, insurance pre-authorizations, or trauma emergency procedures? Find rapid guidance below.</p>
      </div>

      <div class="faq-accordion-wrapper reveal reveal-up">
        {faqs.map((faq, idx) => (
          <div class="faq-item" id={`faq-${idx}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${idx}`}>
              <span>{faq.q}</span>
              <span class="faq-toggle-icon"><i class="fas fa-chevron-down"></i></span>
            </button>
            <div class="faq-answer" id={`faq-answer-${idx}`} style="max-height: 0px;" role="region">
              <div class="faq-answer-inner">
                <p>{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CTA SECTION -->
  <section class="cta-banner-section">
    <div class="cta-glow-dot" aria-hidden="true"></div>
    <div class="container cta-banner-container text-center reveal reveal-up">
      <h2 class="cta-banner-title">Access Mayiladuthurai's Leading Specialty Doctors Today</h2>
      <p class="cta-banner-desc">
        We offer 24/7 ICU support, cashless emergency admissions, and executive medical profiling. Reach our desk immediately.
      </p>
      <div class="cta-banner-actions">
        <button id="servicesPageOpenBookingBtn" class="btn-primary-gradient">
          <i class="far fa-calendar-check"></i> Book Online Consultation
        </button>
        <a href="tel:+919344644555" class="btn-outline-white">
          Call 24/7 Emergency Line <i class="fas fa-phone-alt"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. SERVICE DETAIL POPUP MODAL (Dynamic Content Injected) -->
  <div class="detail-modal-overlay" id="serviceDetailModal" aria-hidden="true" role="dialog">
    <div class="detail-modal-card">
      <div class="modal-card-header">
        <h3 id="modalTitleText"><i class="fas fa-heartbeat"></i> Cardiology & Heart Care</h3>
        <button class="close-detail-modal-btn" id="closeDetailModalBtn" aria-label="Close details modal"><i class="fas fa-times"></i></button>
      </div>
      
      <div class="modal-scroll-body">
        <div class="modal-featured-img-box">
          <img id="modalFeaturedImage" src="/images/consultation.png" alt="Clinical Center" />
          <div class="modal-img-badge" id="modalCategoryBadge">Specialty Care</div>
        </div>

        <div class="modal-content-grid">
          <div class="modal-desc-column">
            <h4>Service Overview</h4>
            <p id="modalDescText">Detailed overview here...</p>

            <h4>Key Diagnostics & Operations</h4>
            <ul class="modal-items-list" id="modalProceduresList">
              <!-- JS Injected items -->
            </ul>
          </div>
          
          <div class="modal-highlights-column">
            <h4>Core Features</h4>
            <ul class="modal-bullet-list" id="modalFeaturesList">
              <!-- JS Injected items -->
            </ul>

            <div class="modal-why-box">
              <h4><i class="fas fa-shield-alt"></i> Why Choose Us</h4>
              <ul class="modal-why-list" id="modalWhyList">
                <!-- JS Injected items -->
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer-actions">
        <button class="btn-outline-secondary" id="modalCloseBackBtn">Go Back</button>
        <button class="btn-primary" id="modalConfirmBookBtn">Book Consultation Now</button>
      </div>
    </div>
  </div>

  <!-- 7. APPOINTMENT BOOKING MODAL -->
  <div class="booking-modal-overlay" id="servicesBookingModal" aria-hidden="true" role="dialog">
    <div class="booking-modal-card">
      <div class="modal-card-header">
        <h3><i class="far fa-calendar-check"></i> Book Medical Appointment</h3>
        <button class="close-modal-btn" id="closeServicesBookingBtn" aria-label="Close booking modal"><i class="fas fa-times"></i></button>
      </div>
      
      <form class="modal-booking-form" id="servicesPageBookingForm">
        <div class="form-group">
          <label for="bookPatientName">Patient Full Name *</label>
          <input type="text" id="bookPatientName" required placeholder="e.g. Rajesh Kumar" />
        </div>
        
        <div class="form-group">
          <label for="bookPatientPhone">Mobile Number *</label>
          <input type="tel" id="bookPatientPhone" required placeholder="e.g. 93446 44555" pattern="[0-9\s+-]{10,15}" />
        </div>
        
        <div class="form-grid">
          <div class="form-group">
            <label for="bookSpeciality">Select Specialty *</label>
            <select id="bookSpeciality" required>
              <option value="">-- Choose Department --</option>
              <option value="Cardiology">Cardiology</option>
              <option value="Neurology">Neurology</option>
              <option value="Orthopaedics">Orthopaedics</option>
              <option value="Paediatrics">Paediatrics</option>
              <option value="General Medicine">General Medicine</option>
              <option value="Diagnostics">Diagnostics & Lab</option>
              <option value="Ophthalmology">Ophthalmology</option>
              <option value="Physiotherapy">Physiotherapy & Rehab</option>
              <option value="Emergency">Emergency Trauma Unit</option>
            </select>
          </div>
          
          <div class="form-group">
            <label for="bookBookingDate">Appointment Date *</label>
            <input type="date" id="bookBookingDate" required />
          </div>
        </div>

        <div class="form-group">
          <label for="bookTimeSlot">Preferred Time Slot *</label>
          <select id="bookTimeSlot" required>
            <option value="">-- Select Time Slot --</option>
            <option value="09:00 AM">09:00 AM - 11:00 AM</option>
            <option value="11:00 AM">11:00 AM - 01:00 PM</option>
            <option value="02:00 PM">02:00 PM - 04:00 PM</option>
            <option value="04:00 PM">04:00 PM - 06:00 PM</option>
          </select>
        </div>

