---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FeatureBand from "../components/ui/FeatureBand.astro";
import Icon from "../components/ui/Icon.astro";
import { specialities, categories } from "../data/specialities";
import { serviceFaqs } from "../data/faqs";
import { site } from "../data/site";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: serviceFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const servicesLd = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: site.name,
  url: `${site.url}/services`,
  areaServed: site.areaServed,
  availableService: specialities.map((s) => ({ "@type": "MedicalTherapy", name: s.name, description: s.desc })),
};
---

<Layout
  ogImage="/og/services.jpg"
  title="Specialities & Treatments | Vairam Multi Speciality Hospital, Mayiladuthurai"
  description="Cardiology, neurology, orthopaedics, paediatrics, radiology, laboratory, eye care, physiotherapy and 24/7 emergency care at Vairam Hospital, Mayiladuthurai."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(servicesLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <PageHeader
    crumb="Specialities"
    eyebrow="Specialities & treatments"
    title="Medical Specialities & Treatments in Mayiladuthurai"
    lede="Vairam Hospital offers cardiology, neurology, orthopaedics, paediatrics, plastic surgery, eye care, physiotherapy, radiology, laboratory and 24/7 emergency care in Mayiladuthurai, from diagnosis to surgery and rehabilitation under one roof."
    stats={[
      { value: `${specialities.length}`, label: "Specialist departments" },
      { value: "24/7", label: "Emergency & trauma care" },
      { value: "Same day", label: "Most lab & scan reports" },
      { value: "Cashless", label: "Insurance support" },
    ]}
  />

  <section class="section">
    <div class="container sv">
      <aside class="sv__aside">
        <div class="sv__search">
          <Icon name="search" size={18} />
          <label for="svSearch" class="visually-hidden">Search specialities</label>
          <input id="svSearch" class="input" type="search" placeholder="Search specialities" autocomplete="off" />
        </div>
        <div class="chips sv__chips" role="group" aria-label="Filter by category">
          {categories.map((c, i) => <button type="button" class="chip" data-filter={c.filter} aria-pressed={i === 0 ? "true" : "false"}>{c.label}</button>)}
        </div>
        <nav class="sv__index" aria-label="Specialities">
          <ul role="list">
            {
              specialities.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-index-for={s.id}>
                    <Icon name={s.icon} size={18} /> {s.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="sv__list">
        <p class="sv__status" id="svStatus" role="status" hidden></p>
        {
          specialities.map((s) => (
            <article
              id={s.id}
              class:list={["sv__item", { "sv__item--alert": s.id === "emergency" }]}
              data-category={s.category}
              data-search={`${s.name} ${s.sub} ${s.desc} ${s.keywords} ${s.features.join(" ")} ${s.procedures.join(" ")}`.toLowerCase()}
            >
              <header class="sv__head">
                <span class="icon-tile sv__icon">
                  <Icon name={s.icon} size={28} />
                </span>
                <div>
                  <p class="sv__sub">{s.sub}</p>
                  <h2><a href={`/services/${s.id}`} class="sv__title-link">{s.name}</a></h2>
                </div>
              </header>
              <p class="sv__desc">{s.desc}</p>
              <div class="sv__cols">
                <div>
                  <h3>Services</h3>
                  <ul class="check-list">{s.features.map((f) => <li>{f}</li>)}</ul>
                </div>
                <div>
                  <h3>Common procedures</h3>
                  <ul class="check-list">{s.procedures.map((f) => <li>{f}</li>)}</ul>
                </div>
              </div>
              <div class="sv__why">
                <h3>Why patients choose us</h3>
                <ul role="list">{s.why.map((w) => <li>{w}</li>)}</ul>
              </div>
              <div class="sv__actions">
                {s.id === "emergency" ? (
                  <a href={`tel:${site.phone}`} class="btn btn--alert">
                    <Icon name="phone" /> Call {site.phoneDisplay}
                  </a>
                ) : (
                  <button type="button" class="btn" data-book data-dept={s.short}>
                    <Icon name="calendar" /> Book an appointment
                  </button>
                )}
                <a href={`/services/${s.id}`} class="btn btn--outline">
                  Full details <Icon name="arrow-right" />
                </a>
              </div>
            </article>
          ))
        }
        <div class="sv__empty" id="svEmpty" hidden>
          <h2>No matching speciality</h2>
          <p>Try another word, or call us and we'll guide you to the right doctor.</p>
          <button type="button" class="btn btn--outline" id="svReset">Show all specialities</button>
        </div>
      </div>
    </div>
  </section>

  <FeatureBand
    eyebrow="Integrated care"
    title="One hospital for every step of your treatment"
    text="Diagnosis, specialist consultation, surgery, critical care and rehabilitation all happen under one roof, coordinated by one team."
    items={[
      { icon: "microscope", title: "Diagnostics in-house", text: "Lab, X-ray and ultrasound in the same building, so results reach your doctor fast." },
      { icon: "users", title: "Multi-specialist review", text: "Complex cases are discussed across departments for the best treatment plan." },
      { icon: "hospital", title: "Surgery with ICU backup", text: "Modular theatres supported by a 24/7 ICU and emergency team." },
      { icon: "activity", title: "Rehab & follow-up", text: "Physiotherapy and structured follow-up until you are fully back on your feet." },
    ]}
    cta={{ label: "Book a consultation", action: "book" }}
  />

  <section class="section section--white" aria-labelledby="faqTitle">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faqTitle">Frequently asked questions</h2>
        <p class="lede">Can't find what you need? Call {site.phoneDisplay} and our helpdesk will assist.</p>
      </div>
      <div class="faq">
        {
          serviceFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .sv {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  .sv > * {
    min-width: 0;
  }
  .sv__aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: var(--s-4);
  }
  .sv__search {
    position: relative;
  }
  .sv__search :global(svg) {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
  }
  .sv__search .input {
    padding-left: 42px;
  }
  .sv__chips {
    flex-wrap: wrap;
  }
  .sv__chips .chip {
    min-height: 34px;
    font-size: var(--fs-xs);
  }
  .sv__index ul {
    display: grid;
    gap: 2px;
  }
  .sv__index a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    position: relative;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .sv__index a :global(svg) {
    color: var(--ink-muted);
  }
  .sv__index a:hover {
    color: var(--navy-900);
    background: var(--paper-2);
  }
  .sv__index a.is-current {
    color: var(--blue-600);
    background: var(--blue-50);
  }
  .sv__index a.is-current :global(svg) {
    color: var(--teal-600);
  }
  .sv__index a.is-hidden {
    display: none;
  }

  .sv__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
  }
  .sv__status {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  .sv__item {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .sv__item--alert {
    background: linear-gradient(180deg, var(--alert-50), var(--white) 40%);
    border-color: rgb(214 52 58 / 0.2);
  }
  .sv__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  .sv__icon {
    width: 60px;
    height: 60px;
  }
  .sv__item--alert .sv__icon {
    background: var(--alert-600);
    color: var(--white);
  }
  .sv__sub {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .sv__head h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }
  .sv__title-link:hover {
    color: var(--blue-600);
  }
  .sv__desc {
    color: var(--ink-muted);
    max-width: 68ch;
    margin-bottom: var(--s-6);
  }
  .sv__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--line);
  }
  .sv h3 {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy-900);
    margin-bottom: var(--s-4);
  }
  .sv__cols .check-list {
    font-size: var(--fs-sm);
  }
  .sv__why {
    padding: var(--s-5);
    background: var(--paper-2);
    border-radius: var(--r-sm);
  }
  .sv__why ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sv__why li::before {
    content: "—";
    margin-right: var(--s-2);
    color: var(--teal-600);
  }
  .sv__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
  .sv__empty {
    padding: var(--s-8);
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-md);
    display: grid;
    gap: var(--s-3);
    justify-items: center;
  }
  .sv__empty h2 {
    font-size: 1.75rem;
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--s-8);
  }

  @media (max-width: 1024px) {
    .sv {
      grid-template-columns: 1fr;
    }
    .sv__aside {
      top: var(--header-h);
      z-index: 5;
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--s-3) var(--gutter);
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .sv__chips {
      flex-wrap: nowrap;
    }
    .sv__index {
      display: none;
    }
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
  @media (max-width: 640px) {
    .sv__cols {
      grid-template-columns: 1fr;
    }
    .sv__actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".sv__item"));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".sv__chips .chip"));
  const search = document.getElementById("svSearch") as HTMLInputElement;
  const status = document.getElementById("svStatus")!;
  const empty = document.getElementById("svEmpty")!;
  const indexLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-index-for]"));
  let category = "all";

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      const ok = (category === "all" || item.dataset.category === category) && (!q || item.dataset.search!.includes(q));
      item.hidden = !ok;
      indexLinks.find((a) => a.dataset.indexFor === item.id)?.classList.toggle("is-hidden", !ok);
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    status.hidden = !q;
    status.textContent = q ? `${shown} ${shown === 1 ? "speciality" : "specialities"} matching “${search.value.trim()}”` : "";
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      category = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      apply();
    }),
  );
  search.addEventListener("input", apply);
  document.getElementById("svReset")?.addEventListener("click", () => {
    search.value = "";
    category = "all";
    chips.forEach((c, i) => c.setAttribute("aria-pressed", String(i === 0)));
    apply();
  });

  // Highlight the speciality in view
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        indexLinks.forEach((a) => a.classList.toggle("is-current", a.dataset.indexFor === e.target.id));
      }
    },
    { rootMargin: "-30% 0px -60% 0px" },
  );
  items.forEach((i) => spy.observe(i));
</script>
