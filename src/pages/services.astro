      color: #0d9488;
      margin-top: 3px;
    }

    .modal-footer-actions {
      padding: 20px 35px;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: flex-end;
      gap: 15px;
      flex-shrink: 0;
    }

    .btn-outline-secondary {
      background: transparent;
      color: #475569;
      border: 1.5px solid #cbd5e1;
      padding: 12px 24px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.3s;
    }

    .btn-outline-secondary:hover {
      background: #f1f5f9;
      border-color: #94a3b8;
      color: #0f172a;
    }

    /* 7. APPOINTMENT BOOKING MODAL */
    .booking-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(2, 6, 23, 0.6);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 11000;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 20px;
    }

    .booking-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .booking-modal-card {
      background: #ffffff;
      width: 100%;
      max-width: 550px;
      border-radius: 28px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(13, 148, 136, 0.1);
      overflow: hidden;
      transform: translateY(40px) scale(0.95);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .booking-modal-overlay.active .booking-modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-booking-form {
      padding: 35px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #020617;
    }

    .form-group input,
    .form-group select {
      padding: 12px 16px;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      outline: none;
      transition: border 0.3s;
      background: #f8fafc;
      color: #0f172a;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: #0d9488;
      background: #ffffff;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .submit-modal-btn {
      background: #0d9488;
      color: #ffffff;
      border: none;
      padding: 14px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      margin-top: 10px;
      box-shadow: 0 8px 16px -4px rgba(13, 148, 136, 0.3);
      font-family: inherit;
    }

    .submit-modal-btn:hover {
      background: #0f766e;
      box-shadow: 0 12px 24px -6px rgba(13, 148, 136, 0.4);
    }

    /* Responsive Adjustments */
    @media (max-width: 991px) {
      .workflow-timeline {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      .timeline-bar {
        display: none;
      }
      .modal-content-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }
      .detail-modal-card {
        height: 95%;
      }
    }

    @media (max-width: 768px) {
      .category-tabs {
        gap: 10px;
      }
      .tab-btn {
        padding: 10px 20px;
        font-size: 0.85rem;
      }
      .services-hero {
        padding: 100px 5% 70px;
      }
      .workflow-section,
      .faq-section,
      .services-grid-section,
      .cta-banner-section {
        padding: 70px 5%;
      }
      .modal-scroll-body {
        padding: 20px;
      }
      .modal-featured-img-box {
        height: 180px;
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- INTERACTIVE VANILLA JAVASCRIPT -->
  <script is:inline define:vars={{ servicesData }}>
    document.addEventListener("DOMContentLoaded", () => {
      
      // Cache DOM Elements
      const searchInput = document.getElementById("servicesSearchInput");
      const searchClearBtn = document.getElementById("searchClearBtn");
      const tabButtons = document.querySelectorAll(".tab-btn");
      const serviceCards = document.querySelectorAll(".service-card");
      const emptyState = document.getElementById("emptyState");
      const filterStatusBox = document.getElementById("filterStatusBox");
      const statusQueryText = document.getElementById("statusQueryText");
      const resetFiltersLink = document.getElementById("resetFiltersLink");
      const emptyStateResetBtn = document.getElementById("emptyStateResetBtn");
      const servicesGrid = document.getElementById("servicesGrid");

      // Detail Modal Cache
      const detailModal = document.getElementById("serviceDetailModal");
      const closeDetailModalBtn = document.getElementById("closeDetailModalBtn");
      const modalCloseBackBtn = document.getElementById("modalCloseBackBtn");
      const modalConfirmBookBtn = document.getElementById("modalConfirmBookBtn");
      
      const modalTitleText = document.getElementById("modalTitleText");
      const modalFeaturedImage = document.getElementById("modalFeaturedImage");
      const modalCategoryBadge = document.getElementById("modalCategoryBadge");
      const modalDescText = document.getElementById("modalDescText");
      const modalProceduresList = document.getElementById("modalProceduresList");
      const modalFeaturesList = document.getElementById("modalFeaturesList");
      const modalWhyList = document.getElementById("modalWhyList");

      // Booking Modal Cache
      const bookingModal = document.getElementById("servicesBookingModal");
      const closeServicesBookingBtn = document.getElementById("closeServicesBookingBtn");
      const servicesPageOpenBookingBtn = document.getElementById("servicesPageOpenBookingBtn");
      const bookingForm = document.getElementById("servicesPageBookingForm");
      const bookSpeciality = document.getElementById("bookSpeciality");

      // State variables
      let activeTabFilter = "all";
      let activeSearchQuery = "";
      let activeSelectedServiceId = null;

      // ────────────────────────────────────────────────────────
      // 1. FILTERING & SEARCH LOGIC
      // ────────────────────────────────────────────────────────
      
      function runFilters() {
        let visibleCount = 0;
        const query = activeSearchQuery.trim().toLowerCase();

        serviceCards.forEach(card => {
          const cardCategory = card.getAttribute("data-category");
          const cardTitle = card.getAttribute("data-title");
          const cardDesc = card.getAttribute("data-desc");
          const cardKeywords = card.getAttribute("data-keywords").toLowerCase();

          // Category filter match
          const tabMatch = (activeTabFilter === "all" || cardCategory === activeTabFilter);
          
          // Search query match (title, desc, or keywords)
          const searchMatch = (
            query === "" ||
            cardTitle.includes(query) ||
            cardDesc.includes(query) ||
            cardKeywords.includes(query)
          );

          if (tabMatch && searchMatch) {
            card.style.display = "flex";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        // Toggle Empty State
        if (visibleCount === 0) {
          servicesGrid.style.display = "none";
          emptyState.style.display = "block";
        } else {
          servicesGrid.style.display = "grid";
          emptyState.style.display = "none";
        }

        // Toggle Filter Status Banner
        if (query !== "") {
          filterStatusBox.style.display = "block";
          statusQueryText.textContent = activeSearchQuery;
          searchClearBtn.style.display = "block";
        } else {
          filterStatusBox.style.display = "none";
          searchClearBtn.style.display = "none";
        }
      }

      function resetAllFilters() {
        activeTabFilter = "all";
        activeSearchQuery = "";
        searchInput.value = "";
        
        tabButtons.forEach(btn => {
          if (btn.getAttribute("data-filter") === "all") {
            btn.classList.add("active");
            btn.setAttribute("aria-selected", "true");
          } else {
            btn.classList.remove("active");
            btn.setAttribute("aria-selected", "false");
          }
        });

        runFilters();
      }

      // Input Event
      searchInput.addEventListener("input", (e) => {
        activeSearchQuery = e.target.value;
        runFilters();
      });

      // Clear Button click
      searchClearBtn.addEventListener("click", () => {
        searchInput.value = "";
        activeSearchQuery = "";
        runFilters();
      });

      // Tab Buttons click
      tabButtons.forEach(button => {
        button.addEventListener("click", () => {
          tabButtons.forEach(b => {
            b.classList.remove("active");
            b.setAttribute("aria-selected", "false");
          });
          button.classList.add("active");
          button.setAttribute("aria-selected", "true");
          
          activeTabFilter = button.getAttribute("data-filter");
          runFilters();
        });
      });

      // Resets
      resetFiltersLink.addEventListener("click", resetAllFilters);
      emptyStateResetBtn.addEventListener("click", resetAllFilters);

      // ────────────────────────────────────────────────────────
      // 2. DYNAMIC SERVICE DETAIL MODAL BINDINGS
      // ────────────────────────────────────────────────────────

      function openDetailModal(serviceId) {
        const data = servicesData.find(s => s.id === serviceId);
        if (!data) return;

        activeSelectedServiceId = serviceId;

        // Inject Content
        modalTitleText.innerHTML = `<i class="fas ${data.icon}"></i> ${data.name}`;
        modalFeaturedImage.src = data.image;
        modalFeaturedImage.alt = `${data.name} Center visual`;
        modalCategoryBadge.textContent = data.category.replace('-', ' ');
        modalDescText.textContent = data.desc;

        // Procedures List
        modalProceduresList.innerHTML = "";
        data.procedures.forEach(proc => {
          const li = document.createElement("li");
          li.textContent = proc;
          modalProceduresList.appendChild(li);
        });

        // Features list
        modalFeaturesList.innerHTML = "";
        data.features.forEach(feat => {
          const li = document.createElement("li");
          li.innerHTML = `<i class="fas fa-check-circle"></i> <span>${feat}</span>`;
          modalFeaturesList.appendChild(li);
        });

        // Why choose us highlights
        modalWhyList.innerHTML = "";
        data.whyChooseUs.forEach(why => {
          const li = document.createElement("li");
          li.innerHTML = `<i class="fas fa-star"></i> <span>${why}</span>`;
          modalWhyList.appendChild(li);
        });

        // Open Modal
        detailModal.classList.add("active");
        detailModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeDetailModal() {
        detailModal.classList.remove("active");
        detailModal.setAttribute("aria-hidden", "true");
        if (!bookingModal.classList.contains("active")) {
          document.body.style.overflow = "";
        }
      }

      // Attach "Learn More" Triggers
      servicesGrid.addEventListener("click", (e) => {
        const btn = e.target.closest(".learn-more-btn");
        if (btn) {
          const id = btn.getAttribute("data-id");
          openDetailModal(id);
        }
      });

      closeDetailModalBtn.addEventListener("click", closeDetailModal);
      modalCloseBackBtn.addEventListener("click", closeDetailModal);

      // ────────────────────────────────────────────────────────
      // 3. APPOINTMENT BOOKING MODAL ACTIONS
      // ────────────────────────────────────────────────────────

      function openBookingModal(preselectedDept = "") {
        // Map service IDs to the dropdown option values
        const deptMap = {
          "cardiology": "Cardiology",
          "neurology": "Neurology",
          "orthopedics": "Orthopaedics",
          "pediatrics": "Paediatrics",
          "radiology": "Diagnostics",
          "laboratory": "Diagnostics",
          "ophthalmology": "Ophthalmology",
          "physiotherapy": "Physiotherapy",
          "emergency": "Emergency"
        };

        if (preselectedDept && deptMap[preselectedDept]) {
          bookSpeciality.value = deptMap[preselectedDept];
        } else {
          bookSpeciality.value = "";
        }

        bookingModal.classList.add("active");
        bookingModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeBookingModal() {
        bookingModal.classList.remove("active");
        bookingModal.setAttribute("aria-hidden", "true");
        if (!detailModal.classList.contains("active")) {
          document.body.style.overflow = "";
        }
      }

      // Trigger Booking from Detail Modal
      modalConfirmBookBtn.addEventListener("click", () => {
        closeDetailModal();
        setTimeout(() => {
          openBookingModal(activeSelectedServiceId);
        }, 150);
      });

      // Regular Page CTA Trigger
      servicesPageOpenBookingBtn.addEventListener("click", () => {
        openBookingModal("");
      });

      closeServicesBookingBtn.addEventListener("click", closeBookingModal);

      // Close modals when clicking outside
      window.addEventListener("click", (e) => {
        if (e.target === detailModal) closeDetailModal();
        if (e.target === bookingModal) closeBookingModal();
      });

      // ────────────────────────────────────────────────────────
      // 4. BOOKING FORM REDIRECT TO WHATSAPP
      // ────────────────────────────────────────────────────────
      bookingForm.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const name = document.getElementById("bookPatientName").value.trim();
        const phone = document.getElementById("bookPatientPhone").value.trim();
        const specialty = bookSpeciality.value;
        const date = document.getElementById("bookBookingDate").value;
        const timeslot = document.getElementById("bookTimeSlot").value;

        // Generate schedule token
        const token = "VMR-" + Math.floor(1000 + Math.random() * 9000);

        // Construct message template
        const message = `Hello Vairam Multi Speciality Hospital, I would like to schedule a specialist medical appointment:
- Booking Reference: ${token}
- Patient Name: ${name}
- Contact Phone: ${phone}
- Requested Specialty: ${specialty}
- Scheduled Date: ${date}
- Preferred Time Slot: ${timeslot}

Please confirm availability. Thank you.`;

        // Direct WhatsApp redirection
        const encodedMsg = encodeURIComponent(message);
        const whatsappNumber = "919344644555"; 
        const url = `https://wa.me/${whatsappNumber}?text=${encodedMsg}`;
        
        window.open(url, "_blank");
        closeBookingModal();
        bookingForm.reset();
      });

      // ────────────────────────────────────────────────────────
      // 5. FAQ ACCORDION TOGGLE
      // ────────────────────────────────────────────────────────
      const faqAccordion = document.querySelector(".faq-accordion-wrapper");
      faqAccordion.addEventListener("click", (e) => {
        const questionBtn = e.target.closest(".faq-question");
        if (!questionBtn) return;

        const faqItem = questionBtn.parentElement;
        const answerPanel = faqItem.querySelector(".faq-answer");
        const isActive = faqItem.classList.contains("active");

        // Close all other items
        document.querySelectorAll(".faq-item").forEach(item => {
          item.classList.remove("active");
          item.querySelector(".faq-question").setAttribute("aria-expanded", "false");
          item.querySelector(".faq-answer").style.maxHeight = "0px";
        });

        // Toggle selected item
        if (!isActive) {
          faqItem.classList.add("active");
          questionBtn.setAttribute("aria-expanded", "true");
          answerPanel.style.maxHeight = answerPanel.scrollHeight + "px";
        }
      });

    });
  </script>

</Layout>
