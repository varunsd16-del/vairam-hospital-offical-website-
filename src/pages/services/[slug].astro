</style>

<script>
  // Highlight the in-page tab for the section in view
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-tab]"));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) tabs.forEach((t) => t.classList.toggle("is-active", t.dataset.tab === e.target.id));
      }
    },
    { rootMargin: "-35% 0px -55% 0px" },
  );
  tabs.forEach((t) => {
    const el = document.getElementById(t.dataset.tab!);
    if (el) spy.observe(el);
  });
</script>
