---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileActionBar from "../components/layout/MobileActionBar.astro";
import BookingDialog from "../components/ui/BookingDialog.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Show the call-to-action banner above the footer (default: true) */
  cta?: boolean;
}

const {
  title,
  description = `${site.name} in ${site.address.city} offers 24/7 emergency care, cardiology, orthopaedics, neurology, paediatrics and multi-speciality services with experienced doctors.`,
  ogImage = "/og/og-default.jpg",
  cta = true,
} = Astro.props;

// Netlify sets URL to the site's main address (the netlify.app link now, vairamhospital.com once the
// domain is connected), so share previews always point at a server that actually exists.
const baseUrl = (process.env.URL || site.url).replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, baseUrl).href;
const ogImageUrl = new URL(ogImage, baseUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Hospital",
  "@id": `${site.url}/#hospital`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/images/Logo.png`,
  image: ogImageUrl,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.foundingYear),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.regionCode,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
  areaServed: site.areaServed,
  sameAs: Object.values(site.social),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1f44" />
    <link rel="icon" type="image/png" href="/images/fav%20icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {import.meta.env.PUBLIC_NOINDEX === "true" && <meta name="robots" content="noindex, nofollow" />}

    <meta name="geo.region" content="IN-TN" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, Mayiladuthurai`} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.name}, Mayiladuthurai`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <BookingDialog />

    <script>
      import { site } from "../data/site";

      /* ── Scroll reveal ── */
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => {
        // Stagger siblings: each revealed item waits a little longer than the previous one
        const siblings = Array.from(el.parentElement?.children ?? []).filter((c) => c.classList.contains("reveal"));
        el.style.setProperty("--i", String(Math.min(siblings.indexOf(el), 6)));
        io.observe(el);
      });

      /* ── Booking dialog ── */
      const dialog = document.getElementById("bookingDialog") as HTMLDialogElement | null;

      document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-book]");
        if (trigger && dialog) {
          e.preventDefault();
          const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]");
          if (form) {
            const dept = trigger.dataset.dept;
            const doctor = trigger.dataset.doctor;
            if (dept) (form.elements.namedItem("dept") as HTMLSelectElement).value = dept;
            filterDoctors(form);
            if (doctor) (form.elements.namedItem("doctor") as HTMLSelectElement).value = doctor;
          }
          // Close any other open dialog (e.g. a doctor profile) before booking
          document.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((d) => d.close());
          dialog.showModal();
          return;
        }
        const closer = (e.target as HTMLElement).closest("[data-close-dialog]");
        if (closer) closer.closest("dialog")?.close();
        // Click on the backdrop (the dialog element itself) closes it
        if (e.target instanceof HTMLDialogElement) e.target.close();
      });

      /* ── Booking forms (dialog + inline) ── */
      function filterDoctors(form: HTMLFormElement) {
        const dept = (form.elements.namedItem("dept") as HTMLSelectElement).value;
        const docSel = form.elements.namedItem("doctor") as HTMLSelectElement;
        let stillValid = false;
        for (const opt of Array.from(docSel.options)) {
          if (!opt.value) continue;
          const show = !dept || dept === "Not sure" || opt.dataset.dept === dept;
          opt.hidden = !show;
          opt.disabled = !show;
          if (show && opt.selected) stillValid = true;
        }
        if (!stillValid) docSel.value = "";
      }

      const today = new Date();
      today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
      const minDate = today.toISOString().split("T")[0];

      document.querySelectorAll<HTMLFormElement>("[data-booking-form]").forEach((form) => {
        const date = form.elements.namedItem("date") as HTMLInputElement;
        date.min = minDate;
        form.elements.namedItem("dept")?.addEventListener("change", () => filterDoctors(form));
        form.addEventListener("input", (e) => (e.target as HTMLElement).classList.remove("is-invalid"));

        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const error = form.querySelector<HTMLElement>(".booking-form__error");
          const required = Array.from(form.querySelectorAll<HTMLInputElement>("[required]"));
          const invalid = required.filter((el) => !el.checkValidity());
          required.forEach((el) => el.classList.toggle("is-invalid", invalid.includes(el)));
          if (invalid.length) {
            if (error) error.hidden = false;
            invalid[0].focus();
            return;
          }
          if (error) error.hidden = true;

          const v = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement)?.value ?? "").trim();
          const ref = "VMH-" + Math.floor(1000 + Math.random() * 9000);
          const lines = [
            `Hello ${site.shortName}, I would like to book an appointment.`,
            "",
            `Reference: ${ref}`,
            `Patient: ${v("name")}`,
            `Phone: ${v("phone")}`,
            `Speciality: ${v("dept")}`,
            `Doctor: ${v("doctor") || "Any available"}`,
            `Date: ${v("date")}`,
            `Time: ${v("slot")}`,
          ];
          if (v("note")) lines.push(`Notes: ${v("note")}`);
          lines.push("", "Please confirm availability. Thank you.");

          window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener");
          form.reset();
          filterDoctors(form);
          if (form.closest("dialog")) (form.closest("dialog") as HTMLDialogElement).close();
        });
      });
    </script>
  </body>
</html>
