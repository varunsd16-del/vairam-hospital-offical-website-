---
import Icon from "../ui/Icon.astro";
import { telHref, waHref } from "../../data/site";
---

<!-- Desktop: single WhatsApp floating shortcut -->
<a href={waHref()} class="wa-float" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <span class="wa-float__icon">
    <Icon name="whatsapp" size={22} />
    <span class="wa-float__badge" aria-hidden="true"></span>
  </span>
  <span class="wa-float__label">
    <span class="wa-float__sub">Have questions?</span>
    <span class="wa-float__main">Chat on WhatsApp</span>
  </span>
</a>

<!-- Mobile: persistent floating action bar (auto-hides on scroll down) -->
<div class="action-bar-wrapper" id="mobileActionBar">
  <nav class="action-bar" aria-label="Quick actions">
    <a href={telHref} class="action-bar__item action-bar__item--call">
      <div class="action-bar__icon-box">
        <Icon name="phone" size={17} />
      </div>
      <span>Call 24/7</span>
    </a>

    <a href={waHref()} target="_blank" rel="noopener" class="action-bar__item action-bar__item--wa">
      <div class="action-bar__icon-box">
        <Icon name="whatsapp" size={17} />
      </div>
      <span>WhatsApp</span>
    </a>

    <button type="button" class="action-bar__item action-bar__item--book" data-book>
      <div class="action-bar__icon-box">
        <Icon name="calendar" size={17} />
      </div>
      <span>Book</span>
    </button>
  </nav>
</div>

<script>
  function setupScrollHide() {
    let lastScrollY = window.scrollY;
    const wrapper = document.getElementById('mobileActionBar');

    if (!wrapper) return;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      
      // Hide bar on scroll down (if scrolled past top 80px), show on scroll up
      if (currentScrollY > 80) {
        if (currentScrollY > lastScrollY + 8) {
          wrapper.classList.add('action-bar-wrapper--hidden');
        } else if (currentScrollY < lastScrollY - 8) {
          wrapper.classList.remove('action-bar-wrapper--hidden');
        }
      } else {
        wrapper.classList.remove('action-bar-wrapper--hidden');
      }
      lastScrollY = currentScrollY;
    }, { passive: true });
  }

  setupScrollHide();
  document.addEventListener('astro:page-load', setupScrollHide);
</script>

<style>
  /* ── Desktop Floating WhatsApp Button ── */
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 800;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 10px;
    border-radius: 9999px;
    background: rgba(10, 31, 68, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--white);
    box-shadow: 
      0 12px 30px -6px rgba(10, 31, 68, 0.35),
      0 4px 12px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }
  .wa-float:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 
      0 18px 36px -6px rgba(10, 31, 68, 0.45),
      0 0 20px rgba(37, 211, 102, 0.3);
  }

  .wa-float__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #25d366;
    color: var(--white);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
  }

  .wa-float__badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid var(--navy-900);
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 2s infinite;
  }

  .wa-float__label {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .wa-float__sub {
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.1;
  }
  .wa-float__main {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
  }

  /* ── Mobile Floating Action Bar ── */
  .action-bar-wrapper {
    display: none;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  @media (max-width: 768px) {
    .wa-float {
      display: none;
    }

    .action-bar-wrapper {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 850;
      display: flex;
      justify-content: center;
      padding: 0 14px max(14px, env(safe-area-inset-bottom) + 8px);
      pointer-events: none;
      transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      will-change: transform, opacity;
    }

    .action-bar-wrapper--hidden {
      transform: translateY(120%);
      opacity: 0;
    }

    .action-bar {
      pointer-events: auto;
      width: 100%;
      max-width: 420px;
      display: grid;
      grid-template-columns: 1fr 1fr 1.2fr;
      gap: 6px;
      padding: 6px;
      border-radius: 9999px;
      background: rgba(10, 31, 68, 0.92);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 
        0 18px 40px -8px rgba(5, 15, 36, 0.45),
        0 4px 14px -2px rgba(0, 0, 0, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    }

    .action-bar__item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      height: 46px;
      padding: 0 12px;
      border-radius: 9999px;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-decoration: none;
      border: 0;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.95);
      background: transparent;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      -webkit-tap-highlight-color: transparent;
    }

    .action-bar__icon-box {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      transition: transform 0.2s ease;
    }

    /* Call 24/7 Button */
    .action-bar__item--call {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .action-bar__item--call .action-bar__icon-box {
      background: rgba(220, 38, 38, 0.25);
      color: #ef4444;
    }
    .action-bar__item--call:active {
      background: rgba(255, 255, 255, 0.14);
      transform: scale(0.96);
    }

    /* WhatsApp Button */
    .action-bar__item--wa {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .action-bar__item--wa .action-bar__icon-box {
      background: rgba(37, 211, 102, 0.25);
      color: #25d366;
    }
    .action-bar__item--wa:active {
      background: rgba(255, 255, 255, 0.14);
      transform: scale(0.96);
    }

    /* Book CTA Button */
    .action-bar__item--book {
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--teal-500) 0%, var(--teal-600) 100%);
      box-shadow: 0 4px 14px rgba(20, 165, 151, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }
    .action-bar__item--book .action-bar__icon-box {
      background: transparent;
      color: var(--white);
    }
    .action-bar__item--book:active {
      transform: scale(0.96);
      box-shadow: 0 2px 8px rgba(20, 165, 151, 0.6);
    }
  }

  @media (max-width: 380px) {
    .action-bar__item span {
      font-size: 0.75rem;
    }
    .action-bar__item {
      gap: 4px;
      padding: 0 8px;
    }
  }
</style>
