---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import logo from "../../assets/images/logo.png";
import footerBg from "../../assets/images/footer.webp";
import { site, telHref, waHref } from "../../data/site";
import { specialities } from "../../data/specialities";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__bg">
    <Image src={footerBg} alt="" class="footer__bg-img" aria-hidden="true" />
    <div class="footer__overlay" aria-hidden="true"></div>
  </div>

  <div class="container">
    <div class="footer__cta">
      <div>
        <p class="eyebrow eyebrow--light">Talk to us</p>
        <h2>Need to see a specialist?</h2>
        <p>Our appointment desk will help you choose the right doctor and a time that suits you.</p>
      </div>
      <div class="footer__cta-actions">
        <button type="button" class="btn" data-book><Icon name="calendar" /> Book appointment</button>
        <a href={telHref} class="btn btn--ghost-light"><Icon name="phone" /> {site.phoneDisplay}</a>
      </div>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt={site.name} height={96} widths={[192]} class="footer__logo" />
        <p>
          A multi-speciality hospital in {site.address.city} offering specialist consultations, diagnostics,
          surgery and round-the-clock emergency care for families across the Cauvery delta.
        </p>
        <div class="footer__social">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
          <a href={waHref()} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a>
        </div>
      </div>

      <nav aria-label="Specialities">
        <h3>Specialities</h3>
        <ul role="list">
          {specialities.slice(0, 7).map((s) => <li><a href={`/services/${s.id}`}>{s.short}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Patients and visitors">
        <h3>Patients & visitors</h3>
        <ul role="list">
          <li><a href="/doctors">Find a doctor</a></li>
          <li><a href="/facilities">Facilities</a></li>
          <li><a href="/about">About Vairam</a></li>
          <li><a href="/contact">Contact & directions</a></li>
          <li><a href={waHref()} target="_blank" rel="noopener">WhatsApp us</a></li>
        </ul>
      </nav>

      <div class="footer__contact">
        <h3>Visit us</h3>
        <address>
          <p><Icon name="map-pin" size={18} /><span>{site.addressLine}</span></p>
          <p><Icon name="phone" size={18} /><a href={telHref}>{site.phoneDisplay}</a></p>
          <p><Icon name="mail" size={18} /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><Icon name="clock" size={18} /><span>Emergency open 24/7<br />OPD 8 AM – 9 PM, all days</span></p>
        </address>
        <a href={site.directions} target="_blank" rel="noopener" class="link-arrow">Get directions <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Designed & developed by <a href="#">VAC Global Solutions</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    background: var(--navy-950);
    color: rgb(255 255 255 / 0.75);
    font-size: var(--fs-sm);
    overflow: hidden;
  }
  .footer__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .footer__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.22;
    filter: brightness(0.85) contrast(1.1);
  }
  .footer__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(5, 15, 36, 0.88) 0%,
      rgba(5, 15, 36, 0.94) 50%,
      rgba(5, 15, 36, 0.98) 100%
    );
  }
  .footer h2,
  .footer h3 {
    color: var(--white);
  }
  .eyebrow--light {
    color: var(--teal-100);
  }

  .footer__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding: var(--s-9) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .footer__cta h2 {
    margin: var(--s-3) 0 var(--s-2);
  }
  .footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: var(--s-8);
    padding: var(--s-9) 0;
  }
  .footer__logo {
    height: 48px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: var(--s-5);
  }
  .footer__brand p {
    max-width: 38ch;
  }
  .footer__social {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--r-sm);
    color: var(--white);
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .footer__social a:hover {
    background: var(--blue-600);
    border-color: var(--blue-600);
  }
  .footer h3 {
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }
  .footer nav ul {
    display: grid;
    gap: var(--s-3);
  }
  .footer nav a,
  .footer address a {
    transition: color var(--dur) var(--ease);
  }
  .footer nav a:hover,
  .footer address a:hover {
    color: var(--white);
  }
  .footer address {
    font-style: normal;
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .footer address p {
    display: flex;
    gap: var(--s-3);
  }
  .footer address :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--teal-500);
  }
  .footer .link-arrow {
    color: var(--teal-100);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-5) 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.55);
  }
  .footer__legal a {
    color: rgb(255 255 255 / 0.8);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 768px) {
    .footer__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .footer__cta-actions,
    .footer__cta-actions .btn {
      width: 100%;
    }
  }
</style>
