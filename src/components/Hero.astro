---
// Hero Component - Vairam Multi Speciality Hospital
---

<!-- HERO -->
<section class="hero">
  <!-- Decorative background shapes -->
  <div class="hero-bg-circle"></div>
  <div class="hero-bg-gradient"></div>

  <!-- Floating background doodles -->
  <div class="hero-doodles">
    <i class="fas fa-bone doodle doodle-1" aria-hidden="true"></i>
    <i class="fas fa-heartbeat doodle doodle-2" aria-hidden="true"></i>
    <i class="fas fa-stethoscope doodle doodle-3" aria-hidden="true"></i>
    <i class="fas fa-star-of-life doodle doodle-4" aria-hidden="true"></i>
    <i class="fas fa-pills doodle doodle-5" aria-hidden="true"></i>
    <i class="fas fa-briefcase-medical doodle doodle-6" aria-hidden="true"></i>
  </div>

  <div class="container hero-container">
    <div class="hero-content reveal reveal-left">
      <span class="hero-category">TRUSTED MULTI SPECIALITY HOSPITAL</span>
      
      <h1 class="hero-title">
        Your Health,<br>
        <span class="text-navy">Our Responsibility.</span>
      </h1>
      
      <p class="hero-subtitle">
        Advanced care. Latest technology.<br>
        Compassionate doctors.
      </p>

      <div class="hero-btns">
        <a href="/contact" class="btn-primary-blue">
          <i class="far fa-calendar-check"></i>
          <span>Book Appointment</span>
        </a>
        <a href="/services" class="btn-outline-blue">
          <span>Explore Departments</span>
          <i class="fas fa-arrow-right"></i>
        </a>
      </div>

      <!-- Bottom Info Row inside Hero -->
      <div class="hero-info-row">
        <div class="info-item">
          <div class="info-icon phone-icon">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div class="info-details">
            <span class="info-label">Emergency 24/7</span>
            <a href="tel:+919344644555" class="info-val">+91 93446 44555</a>
          </div>
        </div>
        
        <div class="info-item">
          <div class="info-icon location-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div class="info-details">
            <span class="info-label">Location</span>
            <span class="info-val">Mayiladuthurai, Tamil Nadu</span>
          </div>
        </div>
        
        <div class="info-item">
          <div class="info-icon clock-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="info-details">
            <span class="info-label">Timings</span>
            <span class="info-val">24/7 Open</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-visual reveal reveal-right">
      <div class="image-wrapper">
        <img src="/images/hero-building.png" alt="Vairam Multi Speciality Hospital Building" class="main-building-img" />
      </div>
    </div>
  </div>

  <!-- Curved Section Divider matching the image -->
  <div class="hero-curve-divider" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 220" preserveAspectRatio="none">
      <path d="M0,140 C400,180 800,170 1100,120 C1300,80 1400,40 1440,0 L1440,220 L0,220 Z" fill="var(--bg-main)" />
    </svg>
  </div>
</section>

<style>
  /* ─── HERO LIGHT THEME ─── */
  .hero {
    position: relative;
    min-height: calc(100vh - 110px);
    display: flex;
    align-items: center;
    padding: 100px 5% 120px;
    background: #ffffff;
    overflow: hidden;
  }

  /* ─── Background Decorations ─── */
  .hero-bg-circle {
    position: absolute;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.35) 0%, rgba(13, 148, 136, 0.1) 100%);
    right: -5%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 10% 20%, rgba(224, 242, 254, 0.3) 0%, transparent 60%);
    z-index: 0;
    pointer-events: none;
  }

  /* ─── Decorative Background Doodles ─── */
  :global(.hero-doodles) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  :global(.doodle) {
    position: absolute;
    color: rgba(13, 148, 136, 0.15) !important; /* Soft signature emerald teal */
    pointer-events: none;
  }

  /* Float animations */
  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(8deg); }
  }

  @keyframes float-medium {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(-10deg); }
  }

  @keyframes float-fast {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(5deg); }
  }

  :global(.doodle-1) {
    font-size: 3.5rem;
    top: 15%;
    left: 8%;
    transform: rotate(25deg);
    animation: float-slow 6s ease-in-out infinite;
  }

  :global(.doodle-2) {
    font-size: 4rem;
    top: 45%;
    left: 3%;
    transform: rotate(-15deg);
    animation: float-medium 7s ease-in-out infinite 1s;
  }

  :global(.doodle-3) {
    font-size: 3rem;
    top: 75%;
    left: 12%;
    transform: rotate(45deg);
    animation: float-fast 5s ease-in-out infinite;
  }

  :global(.doodle-4) {
    font-size: 4.5rem;
    top: 20%;
    right: 42%;
    transform: rotate(-30deg);
    animation: float-slow 8s ease-in-out infinite 2s;
  }

  :global(.doodle-5) {
    font-size: 2.8rem;
    top: 70%;
    right: 48%;
    transform: rotate(15deg);
    animation: float-medium 6s ease-in-out infinite 0.5s;
  }

  :global(.doodle-6) {
    font-size: 3.2rem;
    top: 12%;
    right: 15%;
    transform: rotate(-20deg);
    animation: float-fast 6.5s ease-in-out infinite 1.5s;
  }

  /* ─── Layout Grid ─── */
  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* ─── Category Badge ─── */
  .hero-category {
    display: block;
    color: #2563eb;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
  }

  /* ─── Title ─── */
  .hero-title {
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .text-navy {
    color: #0f294a;
  }

  /* ─── Subtitle ─── */
  .hero-subtitle {
    font-size: 1.25rem;
    color: #475569;
    margin-bottom: 40px;
    line-height: 1.6;
    font-weight: 500;
  }

  /* ─── Buttons ─── */
  .hero-btns {
    display: flex;
    gap: 16px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }

  .btn-primary-blue {
    background: #0f4bb4;
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(15, 75, 180, 0.25);
    border: none;
  }

  .btn-primary-blue:hover {
    background: #0d3d94;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(15, 75, 180, 0.35);
  }

  .btn-outline-blue {
    background: #ffffff;
    color: #0f4bb4;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid #0f4bb4;
    transition: all 0.3s ease;
  }

  .btn-outline-blue:hover {
    background: rgba(15, 75, 180, 0.04);
    transform: translateY(-2px);
  }

  /* ─── Bottom Info Row ─── */
  .hero-info-row {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .phone-icon {
    background: #fef2f2;
    color: #ef4444;
  }

  .location-icon {
    background: #eff6ff;
    color: #3b82f6;
  }

  .clock-icon {
    background: #f0fdfa;
    color: #0d9488;
  }

  .info-details {
    display: flex;
    flex-direction: column;
  }

  .info-label {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
  }

  .info-val {
    font-size: 0.95rem;
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
  }

  /* ─── Hero Visual (Right Side) ─── */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    z-index: 2;
  }

  .image-wrapper {
    width: 100%;
    max-width: 600px;
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    border: 8px solid #ffffff;
    box-shadow: 0 20px 45px rgba(2, 6, 23, 0.12), 0 4px 12px rgba(2, 6, 23, 0.04);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-wrapper:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(2, 6, 23, 0.18), 0 8px 20px rgba(2, 6, 23, 0.06);
  }

  .main-building-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-wrapper:hover .main-building-img {
    transform: scale(1.03);
  }

  /* ─── Curved SVG Divider ─── */
  .hero-curve-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
  }

  .hero-curve-divider svg {
    display: block;
    width: 100%;
    height: 220px;
  }

  /* ─── Responsive Adjustments ─── */
  @media (max-width: 1024px) {
    .hero-container {
      gap: 30px;
    }
    .hero-bg-circle {
      width: 450px;
      height: 450px;
    }
  }

  @media (max-width: 991px) {
    .hero {
      padding: 80px 5% 100px;
    }
    .hero-container {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-visual {
      justify-content: center;
      margin-top: 20px;
    }
    .image-wrapper {
      max-width: 500px;
    }
    .hero-info-row {
      gap: 30px;
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
    .hero-btns {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary-blue, .btn-outline-blue {
      width: 100%;
      justify-content: center;
    }
    .hero-info-row {
      flex-direction: column;
      gap: 20px;
    }
    .hero-curve-divider svg {
      height: 100px;
    }
  }
</style>
