---
// WhyChooseUs Component - Vairam Multi Speciality Hospital
---

<section class="why-choose-us-section">
  <!-- Glowing backdrops for corporate premium dashboard feel -->
  <div class="glow-bg glow-1" aria-hidden="true"></div>
  <div class="glow-bg glow-2" aria-hidden="true"></div>
  
  <div class="container">
    <div class="why-grid">
      <!-- Left Column: Content & Stats -->
      <div class="content-col reveal reveal-left">
        <span class="section-badge">Why Choose Vairam</span>
        <h2 class="section-title">Setting New Standards in <br /><span class="text-primary">Clinical Excellence</span></h2>
        <p class="section-desc">
          At Vairam Multi Speciality Hospital, we combine world-class medical infrastructure with compassionate, patient-centered care. Our corporate-grade services, expert clinical teams, and state-of-the-art facilities make us the trusted healthcare partner for families and corporate clients alike.
        </p>

        <!-- Stats Counter Grid -->
        <div class="stats-counter-grid">
          <div class="stat-card">
            <div class="stat-icon-wrapper">
              <i class="fas fa-history"></i>
            </div>
            <div class="stat-info">
              <span class="stat-num reveal" data-target="15">15+</span>
              <span class="stat-label">Years of Excellence</span>
            </div>
          </div>
          
          <div class="stat-card">
            <div class="stat-icon-wrapper">
              <i class="fas fa-user-md"></i>
            </div>
            <div class="stat-info">
              <span class="stat-num reveal" data-target="30">30+</span>
              <span class="stat-label">Expert Specialists</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrapper">
              <i class="fas fa-users"></i>
            </div>
            <div class="stat-info">
              <span class="stat-num reveal" data-target="50000">50000+</span>
              <span class="stat-label">Happy Patients</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrapper">
              <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
              <span class="stat-static-text">24/7</span>
              <span class="stat-label">Emergency Care</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Grid of Pillars -->
      <div class="cards-col">
        <div class="pillars-grid">
          <!-- Pillar 1: Cutting-Edge Tech -->
          <div class="pillar-card reveal reveal-up" style="transition-delay: 0.0s;">
            <div class="pillar-icon-box">
              <i class="fas fa-microscope"></i>
            </div>
            <h3 class="pillar-title">Advanced Tech</h3>
            <p class="pillar-desc">
              State-of-the-art diagnostic imaging, high-precision laboratory services, and modular cleanroom operation theaters.
            </p>
            <div class="card-indicator"></div>
          </div>

          <!-- Pillar 2: Clinical Team -->
          <div class="pillar-card reveal reveal-up" style="transition-delay: 0.1s;">
            <div class="pillar-icon-box">
              <i class="fas fa-stethoscope"></i>
            </div>
            <h3 class="pillar-title">Elite Specialists</h3>
            <p class="pillar-desc">
              Highly credentialed medical professionals dedicated to complex treatments and positive clinical outcomes.
            </p>
            <div class="card-indicator"></div>
          </div>

          <!-- Pillar 3: Corporate Healthcare -->
          <div class="pillar-card reveal reveal-up" style="transition-delay: 0.2s;">
            <div class="pillar-icon-box">
              <i class="fas fa-briefcase"></i>
            </div>
            <h3 class="pillar-title">Corporate Care</h3>
            <p class="pillar-desc">
              Seamless cashless billing, tailored executive health checkups, and occupational health screenings for companies.
            </p>
            <div class="card-indicator"></div>
          </div>

          <!-- Pillar 4: Patient-Centricity -->
          <div class="pillar-card reveal reveal-up" style="transition-delay: 0.3s;">
            <div class="pillar-icon-box">
              <i class="fas fa-hand-holding-heart"></i>
            </div>
            <h3 class="pillar-title">Patient First</h3>
            <p class="pillar-desc">
              Personalized recovery journeys, comfortable private suites, and proactive post-discharge support programs.
            </p>
            <div class="card-indicator"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-choose-us-section {
    padding: 100px 5%;
    position: relative;
    background: var(--white);
    overflow: hidden;
  }

  /* Decorative Glow Backdrops */
  .glow-bg {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.4;
    pointer-events: none;
    z-index: 1;
  }

  .glow-1 {
    top: -10%;
    left: -5%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  }

  .glow-2 {
    bottom: -10%;
    right: -5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.2) 0%, transparent 70%);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr;
    gap: 80px;
    align-items: center;
  }

  /* Left Column */
  .content-col {
    display: flex;
    flex-direction: column;
  }

  .section-badge {
    color: var(--primary-dark);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 18px;
    display: inline-block;
    position: relative;
    padding-left: 24px;
  }

  .section-badge::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 3px;
    background: var(--primary);
    border-radius: 2px;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--secondary);
    margin-bottom: 25px;
    letter-spacing: -0.02em;
  }

  .text-primary {
    color: var(--primary);
    background: linear-gradient(120deg, var(--primary) 0%, var(--primary-dark) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-desc {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 45px;
  }

  /* Stats Counter Grid */
  .stats-counter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .stat-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(13, 148, 136, 0.08);
    padding: 20px 24px;
    border-radius: 20px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.03);
    transition: var(--transition);
  }

  .stat-card:hover {
    background: var(--white);
    border-color: rgba(13, 148, 136, 0.2);
    transform: translateY(-5px);
    box-shadow: var(--shadow-premium);
  }

  .stat-icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: rgba(13, 148, 136, 0.08);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
    transition: var(--transition);
  }

  .stat-card:hover .stat-icon-wrapper {
    background: var(--primary);
    color: var(--white);
    transform: scale(1.05);
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-num, .stat-static-text {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--secondary);
    line-height: 1.1;
  }

  .stat-num.reveal {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .stat-num.reveal.active {
    opacity: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 4px;
  }

  /* Right Column (Pillars) */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }

  /* Staggered card positioning for senior UI/UX touch */
  .pillars-grid > div:nth-child(even) {
    transform: translateY(30px);
  }

  .pillar-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(13, 148, 136, 0.06);
    padding: 40px 30px;
    border-radius: 28px;
    box-shadow: 0 15px 35px -15px rgba(0, 0, 0, 0.04);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .pillar-card:hover {
    transform: translateY(-8px);
    background: var(--white);
    border-color: rgba(13, 148, 136, 0.25);
    box-shadow: 0 25px 50px -20px rgba(13, 148, 136, 0.12);
  }

  /* Hover staggered adjustments */
  .pillars-grid > div:nth-child(even):hover {
    transform: translateY(22px); /* Adjust layout lift on hover for staggered column */
  }

  .pillar-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.1) 0%, rgba(13, 148, 136, 0.05) 100%);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    margin-bottom: 25px;
    transition: var(--transition);
    box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.8);
  }

  .pillar-card:hover .pillar-icon-box {
    background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
    color: var(--white);
    box-shadow: 0 10px 20px -5px rgba(13, 148, 136, 0.3);
    transform: rotate(-8deg) scale(1.05);
  }

  .pillar-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--secondary);
    margin-bottom: 12px;
  }

  .pillar-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .card-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
    transition: var(--transition);
  }

  .pillar-card:hover .card-indicator {
    width: 100%;
  }

  /* Responsive styling */
  @media (max-width: 1100px) {
    .why-grid {
      gap: 40px;
    }
    .pillars-grid {
      gap: 20px;
    }
  }

  @media (max-width: 991px) {
    .why-choose-us-section {
      padding: 80px 5%;
    }
    .why-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .pillars-grid > div:nth-child(even) {
      transform: none;
    }
    .pillars-grid > div:nth-child(even):hover {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 576px) {
    .stats-counter-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
