---
import { site } from "../../data/site";
import Icon from "../ui/Icon.astro";

interface Props {
  variant?: "light" | "dark" | "hero";
}

const { variant = "light" } = Astro.props;

// "15+" → count to 15 then add "+"; non-numeric values ("24/7") render as-is.
const parse = (v: string) => {
  const m = v.match(/^(\d+)(\D*)$/);
  return m ? { n: Number(m[1]), suffix: m[2] } : null;
};

const icons = ["award", "stethoscope", "hospital", "clock"] as const;
---

<section class={`trust trust--${variant}`} aria-label="Vairam at a glance">
  <div class="container">
    <dl class="trust__list">
      {
        site.stats.map((s, idx) => {
          const p = parse(s.value);
          const iconName = icons[idx % icons.length];
          return (
            <div class="trust__item reveal">
              <div class="trust__header">
                <div class="trust__icon-wrapper">
                  <Icon name={iconName} size={22} />
                </div>
                <div class="trust__dot" aria-hidden="true" />
              </div>
              <div class="trust__content">
                <dd class="trust__value">
                  {p ? (
                    <span data-count={p.n} data-suffix={p.suffix}>
                      <span class="trust__num">{p.n}</span>
                      <span class="trust__suffix">{p.suffix}</span>
                    </span>
                  ) : (
                    <span class="trust__raw">{s.value}</span>
                  )}
                </dd>
                <dt class="trust__label">{s.label}</dt>
              </div>
              <div class="trust__bar" aria-hidden="true" />
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<style>
  .trust {
    padding: clamp(3.5rem, 2.5rem + 3vw, 5.5rem) 0 var(--s-6);
    position: relative;
    z-index: 2;
  }

  .trust--hero {
    padding: 0;
  }
  .trust--hero .container {
    padding: 0;
    max-width: 100%;
  }

  .trust--dark {
    background: var(--navy-900);
  }

  .trust__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-5);
  }

  .trust__item {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180px;
    padding: var(--s-6);
    border-radius: 20px;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 249, 253, 0.92) 100%);
    border: 1px solid rgba(14, 31, 68, 0.08);
    box-shadow: 
      0 4px 20px -4px rgba(10, 31, 68, 0.04),
      0 12px 32px -8px rgba(10, 31, 68, 0.06);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .trust--dark .trust__item {
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
  }

  /* Hover Effects */
  .trust__item:hover {
    transform: translateY(-8px);
    border-color: rgba(20, 165, 151, 0.35);
    box-shadow: 
      0 20px 40px -12px rgba(10, 31, 68, 0.12),
      0 0 0 1px rgba(20, 165, 151, 0.2);
  }

  .trust--dark .trust__item:hover {
    border-color: rgba(44, 195, 178, 0.5);
    box-shadow: 
      0 20px 40px -12px rgba(0, 0, 0, 0.4),
      0 0 25px rgba(20, 165, 151, 0.25);
  }

  /* Glowing Accent Top Bar */
  .trust__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--teal-500) 0%, var(--blue-600) 100%);
    opacity: 0.85;
    transition: opacity 0.3s ease, height 0.3s ease;
  }
  .trust__item:hover .trust__bar {
    opacity: 1;
    height: 5px;
  }

  /* Header with Icon and Ambient Dot */
  .trust__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-4);
  }

  .trust__icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(20, 165, 151, 0.1) 0%, rgba(27, 88, 184, 0.08) 100%);
    color: var(--teal-700);
    border: 1px solid rgba(20, 165, 151, 0.15);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.35s ease, color 0.35s ease, box-shadow 0.35s ease;
  }

  .trust--dark .trust__icon-wrapper {
    background: rgba(255, 255, 255, 0.08);
    color: var(--teal-400);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .trust__item:hover .trust__icon-wrapper {
    transform: scale(1.1) rotate(4deg);
    background: linear-gradient(135deg, var(--teal-500) 0%, var(--blue-600) 100%);
    color: var(--white);
    border-color: transparent;
    box-shadow: 0 8px 20px -4px rgba(20, 165, 151, 0.45);
  }

  .trust__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal-400);
    opacity: 0.4;
    box-shadow: 0 0 10px var(--teal-500);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .trust__item:hover .trust__dot {
    opacity: 1;
    transform: scale(1.35);
  }

  /* Content area */
  .trust__content {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .trust__value {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 1.8rem + 1.8vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--navy-900);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .trust--dark .trust__value {
    color: var(--white);
  }

  .trust__suffix {
    color: var(--teal-600);
    font-weight: 800;
    margin-left: 2px;
  }

  .trust--dark .trust__suffix {
    color: var(--teal-400);
  }

  .trust__label {
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-muted);
    letter-spacing: -0.01em;
  }

  .trust--dark .trust__label {
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 960px) {
    .trust__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-4);
    }
  }

  @media (max-width: 480px) {
    .trust__list {
      grid-template-columns: 1fr;
    }
    .trust__item {
      padding: var(--s-5);
      min-height: auto;
    }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>("[data-count]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const target = Number(el.dataset.count);
        const suffix = el.dataset.suffix ?? "";
        if (reduce) continue;
        const start = performance.now();
        const dur = 1600;
        const tick = (t: number) => {
          const k = Math.min(1, (t - start) / dur);
          const eased = 1 - Math.pow(1 - k, 4);
          const val = Math.round(target * eased);
          el.innerHTML = `<span class="trust__num">${val}</span><span class="trust__suffix">${suffix}</span>`;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.3 },
  );
  els.forEach((el) => io.observe(el));
</script>

