---
import Icon from "../ui/Icon.astro";
import { site, telHref } from "../../data/site";

const points = [
  { icon: "ambulance", text: "Ambulance on standby" },
  { icon: "heart", text: "ICU & cardiac emergency care" },
  { icon: "bone", text: "Accident & trauma surgery" },
  { icon: "shield", text: "Cashless insurance approvals" },
] as const;
---

<section class="er" aria-labelledby="erTitle">
  <div class="container"><div class="er__inner">
    <div class="er__copy reveal">
      <p class="er__eyebrow"><span aria-hidden="true"></span> Emergency & Trauma, open 24 hours</p>
      <h2 id="erTitle">In an emergency, every minute counts.</h2>
      <ul role="list" class="er__points">
        {
          points.map((p) => (
            <li>
              <Icon name={p.icon} size={20} />
              {p.text}
            </li>
          ))
        }
      </ul>
    </div>
    <a href={telHref} class="er__call reveal">
      <span class="er__call-label">Call the emergency line</span>
      <span class="er__call-num">{site.phoneDisplay}</span>
      <span class="er__call-cta"><Icon name="phone" size={18} /> Tap to call now</span>
    </a>
  </div></div>
</section>

<style>
  .er {
    padding: var(--section) 0 0;
  }
  .er__inner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-8);
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--r-lg);
    background: var(--grad-navy);
    color: var(--white);
    box-shadow: var(--shadow-3);
  }
  .er__inner::before,
  .er__inner::after {
    content: "";
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(10px);
  }
  .er__inner::before {
    width: 520px;
    height: 520px;
    right: -160px;
    top: -220px;
    background: radial-gradient(circle, rgb(214 52 58 / 0.18), transparent 65%);
  }
  .er__inner::after {
    width: 460px;
    height: 460px;
    left: -180px;
    bottom: -260px;
    background: radial-gradient(circle, rgb(20 165 151 / 0.15), transparent 65%);
  }
  @keyframes er-glow {
    to {
      transform: translate(-40px, 30px) scale(1.15);
    }
  }
  .er__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff9a9e;
  }
  .er__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5a5f;
    box-shadow: 0 0 0 4px rgb(255 90 95 / 0.25);
  }
  .er h2 {
    color: var(--white);
    margin: var(--s-4) 0 var(--s-6);
    max-width: 16ch;
    text-wrap: balance;
  }
  .er__points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4) var(--s-6);
  }
  .er__points li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: rgb(255 255 255 / 0.85);
  }
  .er__points :global(svg) {
    flex: none;
    color: var(--teal-500);
  }
  .er__call {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-7);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.06);
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .er__call:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.4);
  }
  .er__call-label {
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.7);
  }
  .er__call-num {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.375rem);
    white-space: nowrap;
    letter-spacing: -0.02em;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .er__call-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-3);
    min-height: 52px;
    border-radius: var(--r-sm);
    background: var(--alert-600);
    box-shadow: 0 12px 28px -10px rgb(214 52 58 / 0.7);
    transition: transform var(--dur) var(--ease);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .er__call:hover .er__call-cta {
    transform: translateY(-2px);
  }
  @media (max-width: 860px) {
    .er__inner {
      grid-template-columns: 1fr;
    }
    .er h2 {
      max-width: none;
    }
  }
  @media (max-width: 480px) {
    .er__points {
      grid-template-columns: 1fr;
    }
    .er__call {
      padding: var(--s-5);
    }
  }
</style>
