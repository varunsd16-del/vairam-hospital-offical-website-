---
import Icon from "./ui/Icon.astro";
import { testimonials } from "../data/testimonials";
---

<section class="section section--tint" aria-labelledby="tTitle">
  <div class="container tm" data-tm>
    <div class="tm__head">
      <p class="eyebrow">Patient stories</p>
      <h2 id="tTitle">In their words</h2>
      <div class="tm__controls">
        <button type="button" class="tm__btn" data-tm-prev aria-label="Previous story"><Icon name="arrow-left" /></button>
        <span class="tm__count" aria-live="polite"><span data-tm-index>1</span> / {testimonials.length}</span>
        <button type="button" class="tm__btn" data-tm-next aria-label="Next story"><Icon name="arrow-right" /></button>
      </div>
    </div>

    <div class="tm__stage">
      {
        testimonials.map((t, i) => (
          <figure class="tm__slide" data-tm-slide hidden={i !== 0}>
            <Icon name="quote" size={36} class="tm__mark" />
            <blockquote>
              <p>{t.text}</p>
            </blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.context}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tm {
    display: grid;
    grid-template-columns: 0.8fr 2fr;
    gap: var(--s-8);
  }
  .tm__head {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }
  .tm__controls {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
  .tm__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-1);
    color: var(--navy-900);
    transition: all var(--dur) var(--ease);
  }
  .tm__btn:hover {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--white);
  }
  .tm__count {
    min-width: 48px;
    text-align: center;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink-muted);
  }
  .tm__stage {
    min-height: 260px;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .tm__slide {
    animation: tm-in 700ms var(--ease);
  }
  @keyframes tm-in {
    from {
      opacity: 0;
      transform: translateX(24px);
      filter: blur(6px);
    }
  }
  .tm__slide :global(.tm__mark) {
    color: var(--blue-600);
    margin-bottom: var(--s-4);
  }
  .tm__slide blockquote p {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.1875rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--navy-900);
  }
  .tm__slide figcaption {
    display: grid;
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--teal-100);
  }
  .tm__slide figcaption span {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  @media (max-width: 860px) {
    .tm {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .tm__controls {
      order: 3;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tm]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-tm-slide]"));
    const indexEl = root.querySelector("[data-tm-index]");
    let i = 0;
    const show = (n: number) => {
      slides[i].hidden = true;
      i = (n + slides.length) % slides.length;
      slides[i].hidden = false;
      if (indexEl) indexEl.textContent = String(i + 1);
    };
    root.querySelector("[data-tm-prev]")?.addEventListener("click", () => show(i - 1));
    root.querySelector("[data-tm-next]")?.addEventListener("click", () => show(i + 1));
  });
</script>
